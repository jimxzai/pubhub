\usepackage{graphicx}
\usepackage{tikz}
\usetikzlibrary{shapes,arrows,positioning,fit,backgrounds,calc,decorations.pathmorphing}

%% ============================================
%% TIKZ COMMANDS FOR DECORATIONS
%% ============================================

% Cross decoration
\newcommand{\crosssymbol}{%
\begin{tikzpicture}[scale=0.15]
  \draw[color=ScriptureGold,line width=1.5pt] (0,-1) -- (0,1);
  \draw[color=ScriptureGold,line width=1.5pt] (-0.6,0.4) -- (0.6,0.4);
\end{tikzpicture}%
}

% Words of Jesus (echoed in commentary, e.g. Sermon on the Mount parallels)
\definecolor{JesusRed}{RGB}{155,35,35}
\newcommand{\jesus}[1]{\textcolor{JesusRed}{#1}}

%% ============================================
%% FULL-BLEED COVER MACHINERY (front/back cover only)
%% Matches templates/pdf/revelation.latex's cover convention, retoned to
%% this book's deep-purple/gold palette instead of Revelation's navy.
%% ============================================
\usepackage{eso-pic}
\usepackage{lettrine}
\usepackage{pgfornament}

% Cover gradient (near-black purple at top to the book's own
% ChapterPurple at bottom)
\definecolor{PurpleDark}{RGB}{16,8,24}
\definecolor{PurpleLight}{RGB}{65,35,95}

% Full-bleed background, painted in the shipout background hook so it
% bleeds to the true physical page edge and does not disturb the
% \geometry text-block margins used by every other page.
\newcommand{\CoverBackground}{%
  \AddToShipoutPictureBG*{%
    \begin{tikzpicture}[remember picture,overlay]
      \shade[top color=PurpleDark,bottom color=PurpleLight]
        ($$(current page.south west)$$) rectangle ($$(current page.north east)$$);
    \end{tikzpicture}%
  }%
}

% Classical book-plate border: two inset hairlines plus a small corner
% ornament at each corner, painted in the foreground hook.
\newcommand{\CoverBorder}{%
  \AddToShipoutPictureFG*{%
    \begin{tikzpicture}[remember picture,overlay]
      \draw[color=ScriptureGold,line width=0.5pt]
        ($$(current page.south west)+(0.45in,0.45in)$$) rectangle ($$(current page.north east)-(0.45in,0.45in)$$);
      \draw[color=ScriptureGold,line width=0.4pt]
        ($$(current page.south west)+(0.52in,0.52in)$$) rectangle ($$(current page.north east)-(0.52in,0.52in)$$);
      \node[color=ScriptureGold] at ($$(current page.south west)+(0.55in,0.55in)$$) {\pgfornament[width=0.45cm,color=ScriptureGold]{88}};
      \node[color=ScriptureGold,rotate=90] at ($$(current page.north west)+(0.55in,-0.55in)$$) {\pgfornament[width=0.45cm,color=ScriptureGold]{88}};
      \node[color=ScriptureGold,rotate=-90] at ($$(current page.south east)+(-0.55in,0.55in)$$) {\pgfornament[width=0.45cm,color=ScriptureGold]{88}};
      \node[color=ScriptureGold,rotate=180] at ($$(current page.north east)+(-0.55in,-0.55in)$$) {\pgfornament[width=0.45cm,color=ScriptureGold]{88}};
    \end{tikzpicture}%
  }%
}

% A small consistent publisher's device, reused on the front cover and the
% closing colophon page.
\newcommand{\publishersmark}[1][ScriptureGold]{%
  \pgfornament[width=0.4cm,color=#1]{38}%
}

% A single fleuron, used as a divider accent (flanked by rules) on the
% full-bleed cover pages and the colophon page. Ornament 70 (a symmetric
% baroque flourish) reads far more clearly at small sizes than 88 (a bare
% flourish-with-center-dot that thins to an almost invisible line when used
% alone with generous surrounding whitespace, as on a colophon page).
\newcommand{\fleuron}[1][ScriptureGold]{%
  \pgfornament[width=0.7cm,color=#1]{70}%
}

% A simple, classical Latin cross with a small gold roundel at the crossing
% — the book's explicit Christian emblem, reserved for the front cover and
% colophon (the two pages that frame the reader's first and last impression).
\newcommand{\coveremblem}[1][CoverGoldBright]{%
\begin{tikzpicture}[scale=0.24]
  \draw[color=#1,line width=1.3pt,line cap=round] (0,-1.15) -- (0,1.15);
  \draw[color=#1,line width=1.3pt,line cap=round] (-0.62,0.45) -- (0.62,0.45);
  \fill[color=#1] (0,0.45) circle (0.09);
\end{tikzpicture}%
}

% Light-on-dark cover text colors (defined once, used on both covers)
\definecolor{CoverCream}{RGB}{240,238,222}
\definecolor{CoverGoldBright}{RGB}{200,168,88}
\definecolor{CoverMuted}{RGB}{188,178,198}

%% ============================================
%% HYPERLINKS
%% ============================================
\usepackage{hyperref}
% hyperxmp turns the hypersetup keys below into a real XMP packet (must load
% after hyperref) — otherwise pdfinfo reports no Title/Author/Subject at all.
\usepackage{hyperxmp}
\hypersetup{
  colorlinks=true,
  linkcolor=ChapterPurple,
  urlcolor=ScriptureGold,
  bookmarks=true,
  bookmarksnumbered=true,
  pdftitle={猶大書研讀 — Epistle of Jude Deep Study},
  pdfauthor={PubHub 三書精讀系統},
  pdfsubject={猶大書逐段研讀：蒙保守的人，為真道竭力爭辯},
  pdfkeywords={猶大書, Jude, 聖經研讀, Bible study, 和合本, NASB, 保守, 爭辯, 背道, 頌榮, 查經},
  pdfcreator={XeLaTeX + pandoc (PubHub 三書精讀出版系統)},
  pdflang={zh-Hant}
}

%% ============================================
%% TABLES - with proper width control
%% ============================================
\usepackage{longtable}
\usepackage{booktabs}
\usepackage{array}
\usepackage{tabularx}
\usepackage{calc}

% Set table width to text width - constrain tables
\setlength{\LTleft}{0pt}
\setlength{\LTright}{0pt}
\setlength{\LTpre}{6pt}
\setlength{\LTpost}{6pt}
\renewcommand{\arraystretch}{1.2}

% Pandoc 3.x table support
\usepackage{etoolbox}
\makeatletter
\patchcmd\longtable{\par}{\if@noskipsec\mbox{}\fi\par}{}{}
\@ifundefined{c@none}{\newcounter{none}}{}
\makeatother
% Word-study / cross-reference tables carry dense CJK + Greek/Hebrew; \small
% keeps long 註解 cells from wrapping to a few characters per line.
\AtBeginEnvironment{longtable}{\small}

% Style table rules
\renewcommand{\toprule}{\hline\hline}
\renewcommand{\midrule}{\hline}
\renewcommand{\bottomrule}{\hline\hline}

%% ============================================
%% HEADERS AND FOOTERS
%% ============================================
\usepackage{fancyhdr}
\setlength{\headheight}{22pt}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE,RO]{\small\thepage}
\fancyhead[LO]{\small\itshape\color{LightGray}\nouppercase{\rightmark}}
\fancyhead[RE]{\small\itshape\color{LightGray}\nouppercase{\leftmark}}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{ScriptureGold}\leaders\hrule height \headrulewidth\hfill}}
\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyfoot[C]{\small\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

%% ============================================
%% SECTION STYLING (manual, without titlesec)
%% ============================================
\makeatletter
% Chapter styling
\def\@makechapterhead#1{%
  \vspace*{15pt}%
  {\parindent \z@ \raggedright \normalfont
    \ifnum \c@secnumdepth >\m@ne
      \large\bfseries\color{ChapterPurple} 第 \thechapter\ 章
      \par\nobreak
      \vskip 8pt
    \fi
    \interlinepenalty\@M
    \LARGE \bfseries\color{ChapterPurple} #1\par\nobreak
    \vskip 12pt
    {\color{ScriptureGold}\hrule height 1.5pt}
    \vskip 15pt
  }}
\def\@makeschapterhead#1{%
  \vspace*{15pt}%
  {\parindent \z@ \raggedright
    \normalfont
    \interlinepenalty\@M
    \LARGE \bfseries\color{ChapterPurple} #1\par\nobreak
    \vskip 8pt
    {\color{ScriptureGold}\hrule height 1.5pt}
    \vskip 15pt
  }}

% Section styling
\renewcommand\section{\@startsection {section}{1}{\z@}%
  {-2.5ex \@plus -0.5ex \@minus -.2ex}%
  {1.5ex \@plus.2ex}%
  {\normalfont\large\bfseries\color{ChapterPurple}}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}%
  {-2ex\@plus -0.5ex \@minus -.2ex}%
  {1ex \@plus .2ex}%
  {\normalfont\normalsize\bfseries\color{CommentaryBrown}}}
\renewcommand\subsubsection{\@startsection{subsubsection}{3}{\z@}%
  {-1.5ex\@plus -0.5ex \@minus -.2ex}%
  {0.8ex \@plus .2ex}%
  {\normalfont\normalsize\bfseries\color{TextGray}}}
\makeatother

%% ============================================
%% SECTION NUMBERING AND TOC DEPTH
%% secnumdepth=0 — no "3.7.2 ..." numbering on body headings or in running
%% heads. tocdepth=0 — contents lists chapters only. The build script's
%% --toc-depth/-V tocdepth do NOT set this on their own; the LaTeX counter
%% must be set here (see .claude/skills/eat-bible/references/gotchas.md).
%% ============================================
\setcounter{secnumdepth}{0}
\setcounter{tocdepth}{0}

% book class's default \chaptermark prints "Chapter N. <title>" (English word)
% in the running head, redundant with the Chinese 「第N章」already in the title.
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}
% \chapter* (preface, orientation chapters, appendices, afterword) never
% calls \chaptermark, so without this patch the verso running head keeps
% showing the last NUMBERED chapter's title on every front/back-matter page.
\makeatletter
\apptocmd{\@schapter}{\markboth{#1}{}}{}{\PackageWarning{jude}{could not patch \string\@schapter}}
\makeatother

%% ============================================
%% BLOCKQUOTE STYLING - extra room for CJK text
%% ============================================
\renewenvironment{quote}{%
  \par\vspace{0.3\baselineskip}%
  \list{}{%
    \leftmargin=0.5em
    \rightmargin=0.2em
    \parsep=0pt
    \itemsep=0pt
  }%
  \item\relax
  \small\color{TextGray}%
}{%
  \endlist
  \par\vspace{0.3\baselineskip}%
}

%% ============================================
%% WIDOW/ORPHAN AND LINE BREAKING - aggressive for CJK
%% ============================================
\widowpenalty=10000
\clubpenalty=10000
\tolerance=9999
\emergencystretch=6em
\hyphenpenalty=50
\exhyphenpenalty=50
\sloppy
\hbadness=10000
\hfuzz=2pt

