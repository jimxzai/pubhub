\usepackage{xcolor}

% Primary colors — deep wine for the cost of the gospel (chains, kenosis),
% gold for the joy and exaltation that answers it (Phil 2:9-11, 4:4).
\definecolor{ChapterPurple}{RGB}{110,25,45}        % Deep wine — chapter color (kept name for macro compatibility)
\definecolor{ScriptureGold}{RGB}{175,135,55}       % Gold for scripture refs / joy
\definecolor{CommentaryBrown}{RGB}{85,60,45}       % Warm brown for commentary
\definecolor{WarningRed}{RGB}{160,50,50}           % Reserved (unused — Philippians carries no polemical section)

% Box colors
\definecolor{ScriptureBg}{RGB}{252,248,246}        % Warm cream tint for scripture
\definecolor{GreekBg}{RGB}{245,248,252}            % Light blue for Greek
\definecolor{ApplicationBg}{RGB}{248,250,246}      % Light warm for application

% Text colors
\definecolor{TextGray}{RGB}{50,50,50}
\definecolor{LightGray}{RGB}{120,120,120}

