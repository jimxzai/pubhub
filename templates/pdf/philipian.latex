%% ============================================
%% FULL-BLEED COVER MACHINERY (front/back cover only)
%% ============================================
% NOTE: deliberately NOT \usepackage{eso-pic} or \usepackage{pgfornament}.
% Either one, merely loaded alongside ucharclasses (regardless of whether
% its own commands are used), silently strips \textbf bold from every
% Scripture quote in the main body. Plain \tikzpicture[remember picture,
% overlay] called inline achieves the same full-bleed effect without the
% conflict: "overlay" makes the picture consume zero space in the
% surrounding flow.

% Deep-wine gradient for the full-bleed cover background.
\definecolor{CoverWineDeep}{RGB}{35,10,18}
\definecolor{CoverWineLight}{RGB}{96,28,46}
\newcommand{\CoverBackground}{%
    \begin{tikzpicture}[remember picture,overlay]
      \shade[shading angle=115, left color=CoverWineDeep, right color=CoverWineLight]
        (current page.south west) rectangle (current page.north east);
    \end{tikzpicture}%
}

% Classical book-plate border: two inset hairlines plus a corner ornament,
% painted using the page's own bounding box.
\newcommand{\CoverBorder}{%
    \begin{tikzpicture}[remember picture,overlay]
      \draw[color=ScriptureGold,line width=0.5pt]
        ($$(current page.south west)+(0.45in,0.45in)$$) rectangle ($$(current page.north east)-(0.45in,0.45in)$$);
      \draw[color=ScriptureGold,line width=0.4pt]
        ($$(current page.south west)+(0.52in,0.52in)$$) rectangle ($$(current page.north east)-(0.52in,0.52in)$$);
      \foreach \c/\dx/\dy in {south west/0.55in/0.55in, south east/-0.55in/0.55in, north east/-0.55in/-0.55in, north west/0.55in/-0.55in} {
        \begin{scope}[shift={($$(current page.\c)+(\dx,\dy)$$)}]
          \draw[color=ScriptureGold,line width=0.9pt,line cap=round] (0,-0.09) -- (0,0.09);
          \draw[color=ScriptureGold,line width=0.9pt,line cap=round] (-0.09,0) -- (0.09,0);
          \draw[color=ScriptureGold,line width=0.6pt,line cap=round] (-0.06,-0.06) -- (0.06,0.06);
          \draw[color=ScriptureGold,line width=0.6pt,line cap=round] (-0.06,0.06) -- (0.06,-0.06);
        \end{scope}
      }
    \end{tikzpicture}%
}

% A small printer's fleuron (hand-drawn compass-star), reused across the
% full-bleed cover pages.
\newcommand{\fleuron}[1][ScriptureGold]{%
\begin{tikzpicture}[baseline=-0.5ex,scale=0.09,line cap=round]
  \draw[color=#1,line width=1.2pt] (0,-1) -- (0,1);
  \draw[color=#1,line width=1.2pt] (-1,0) -- (1,0);
  \draw[color=#1,line width=0.7pt] (-0.7,-0.7) -- (0.7,0.7);
  \draw[color=#1,line width=0.7pt] (-0.7,0.7) -- (0.7,-0.7);
  \fill[color=#1] (0,0) circle (0.22);
\end{tikzpicture}%
}

% Crown-and-cross symbol — echoes Phil 2:8-9 (cross, then the name above
% every name) and 4:1 ("my joy and crown"). This book's own distinctive
% cover mark, in place of the sibling volumes' own symbols.
\newcommand{\crowncrosssymbol}{%
\begin{tikzpicture}[scale=0.32,line cap=round]
  \draw[color=ScriptureGold,line width=1.3pt] (0,-1.15) -- (0,0.55);
  \draw[color=ScriptureGold,line width=1.3pt] (-0.55,0.15) -- (0.55,0.15);
  \foreach \ang in {60,120,90} {
    \draw[color=ScriptureGold,line width=0.9pt] (\ang:0.75) -- (\ang:0.98);
  }
  \fill[color=ScriptureGold] (0,0.98) circle (0.05);
  \fill[color=ScriptureGold] (-0.65,0.85) circle (0.045);
  \fill[color=ScriptureGold] (0.65,0.85) circle (0.045);
\end{tikzpicture}%
}

% Light-on-dark cover text colors (defined once, used on both covers)
\definecolor{CoverCream}{RGB}{240,236,230}
\definecolor{CoverGoldBright}{RGB}{214,175,100}
\definecolor{CoverMuted}{RGB}{196,178,178}

