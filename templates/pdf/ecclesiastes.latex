%% chapters, the ring of "under the sun", and one small gold point above the ring
%% (the One the book ends on: 12:1, 12:13).
%% ============================================
\thispagestyle{empty}
\begin{tikzpicture}[remember picture, overlay]
  \fill[ScriptureBg] (current page.south west) rectangle (current page.north east);
  \draw[ScriptureGold, line width=2.8pt]
    ([xshift=0.42in,yshift=0.42in]current page.south west)
    rectangle
    ([xshift=-0.42in,yshift=-0.42in]current page.north east);
  \draw[ScriptureGold, line width=0.5pt]
    ([xshift=0.50in,yshift=0.50in]current page.south west)
    rectangle
    ([xshift=-0.50in,yshift=-0.50in]current page.north east);
  \draw[ChapterDusk, line width=0.3pt, opacity=0.55]
    ([xshift=0.58in,yshift=0.58in]current page.south west)
    rectangle
    ([xshift=-0.58in,yshift=-0.58in]current page.north east);
  \foreach \cnr/\sx/\sy in {south west/1/1, south east/-1/1, north west/1/-1, north east/-1/-1} {
    \fill[ScriptureGold] ([xshift=\sx*0.42in,yshift=\sy*0.50in]current page.\cnr) circle (0.045in);
    \fill[ScriptureGold] ([xshift=\sx*0.58in,yshift=\sy*0.50in]current page.\cnr) circle (0.045in);
    \fill[ScriptureGold] ([xshift=\sx*0.50in,yshift=\sy*0.42in]current page.\cnr) circle (0.045in);
    \fill[ScriptureGold] ([xshift=\sx*0.50in,yshift=\sy*0.58in]current page.\cnr) circle (0.045in);
    \fill[BreathRose]  ([xshift=\sx*0.50in,yshift=\sy*0.50in]current page.\cnr) circle (0.040in);
    \fill[ScriptureGold] ([xshift=\sx*0.50in,yshift=\sy*0.50in]current page.\cnr) circle (0.012in);
  }
\end{tikzpicture}

\begin{center}
