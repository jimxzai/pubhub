% Six-volume structure diagram (TikZ drawn), replacing the Acts map with the
% structural device this book actually has: six volumes across 66 chapters.
\begin{tikzpicture}[scale=0.62]
  \node[font=\footnotesize\bfseries,color=ThroneCrimson] at (0,3.0) {全書六卷 Six Volumes, 66 Chapters};

  \node[draw=ThroneCrimson,fill=ScriptureBg,rounded corners,minimum width=3.0cm,minimum height=0.55cm,font=\tiny] at (-4.4,1.6) {卷一 · 控告與呼召};
  \node[font=\tiny,color=LightGray] at (-4.4,1.15) {1-6};

  \node[draw=ThroneCrimson,fill=ScriptureBg,rounded corners,minimum width=3.0cm,minimum height=0.55cm,font=\tiny] at (-1.3,1.6) {卷二 · 以馬內利};
  \node[font=\tiny,color=LightGray] at (-1.3,1.15) {7-12};

  \node[draw=ThroneCrimson,fill=ScriptureBg,rounded corners,minimum width=3.0cm,minimum height=0.55cm,font=\tiny] at (1.8,1.6) {卷三 · 列國與啟示錄};
  \node[font=\tiny,color=LightGray] at (1.8,1.15) {13-27};

  \node[draw=ThroneCrimson,fill=ScriptureBg,rounded corners,minimum width=3.0cm,minimum height=0.55cm,font=\tiny] at (4.9,1.6) {卷四 · 通往希西家};
  \node[font=\tiny,color=LightGray] at (4.9,1.15) {28-39};

  \node[draw=ComfortBlue,fill=ScriptureBg,rounded corners,minimum width=3.4cm,minimum height=0.55cm,font=\tiny] at (-1.7,0.1) {卷五 · 安慰與僕人之歌};
  \node[font=\tiny,color=LightGray] at (-1.7,-0.35) {40-55};

  \node[draw=ComfortBlue,fill=ScriptureBg,rounded corners,minimum width=3.4cm,minimum height=0.55cm,font=\tiny] at (2.4,0.1) {卷六 · 公義與新天新地};
  \node[font=\tiny,color=LightGray] at (2.4,-0.35) {56-66};

  \draw[->,color=ScriptureGold,thick] (-2.9,1.6) -- (-2.7,1.6);
