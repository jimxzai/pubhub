%% ============================================
%% FRONTISPIECE — "全書一句話" spread built on Proverbs' own inclusio,
%% 1:7 and 31:30, the same role Job 42:5-6, Acts 1:8 and Isaiah 12:2-3
%% play in the sister volumes.
%% ============================================
\thispagestyle{empty}
\begin{center}
\vspace*{0.3in}

\begin{tikzpicture}
  \draw[ScriptureGold, line width=0.8pt] (-2.8,0) -- (-0.55,0);
