%% A \cleardoublepage-inserted blank verso must be truly blank:
%% no running head, no folio. (book class leaves the current style on it.)
\makeatletter
\def\cleardoublepage{\clearpage\if@twoside\ifodd\c@page\else
  \hbox{}\thispagestyle{empty}\newpage
  \if@twocolumn\hbox{}\newpage\fi\fi\fi}
\makeatother
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE,RO]{\thepage}
\fancyhead[RE]{\textsc{\color{LightGray}\leftmark}}
\fancyhead[LO]{\textsc{\color{LightGray}\rightmark}}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}

% Plain style for chapter pages
\fancypagestyle{plain}{
  \fancyhf{}
  \fancyfoot[C]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

%% ============================================
%% BLOCKQUOTE STYLING
%% ============================================
\renewenvironment{quote}{%
  \par\vspace{0.5\baselineskip}%
  \list{}{%
    \leftmargin=0.8em
    \rightmargin=0.4em
    \parsep=0pt
    \itemsep=0pt
  }%
  \item\relax
  % Scripture, hymn stanzas and cited verse are set ragged-right: a short
  % measure full of deliberately short lines should not have its inter-word
  % space stretched to justify. This is also what made the loose-line count
  % meaningful -- justified verse was generating thousands of spurious
  % Underfull \hbox warnings that masked any real ones.
  \raggedright
  \large\color{TextGray}%
}{%
  \endlist
  \par\vspace{0.5\baselineskip}%
}

%% ============================================
%% WIDOW/ORPHAN AND LINE BREAKING
%% ============================================
\widowpenalty=10000
\clubpenalty=10000

% Let a page end short rather than stretching it. With this many headings,
% quote blocks and tables, \flushbottom was inventing near-empty pages and
% 12 Underfull \vbox warnings.
\raggedbottom

% A heading must not be left stranded near the foot of a page.
% NOTE the starred form: needspace documents \Needspace* as the variant to use
% under \raggedbottom, and plain \needspace as the \flushbottom one. An earlier
% attempt used the unstarred \needspace here with \raggedbottom in force and
% broke a page at nearly every heading (408 pages -> 867).
\let\PhlmOldSection\section
\renewcommand{\section}{\Needspace*{4\baselineskip}\PhlmOldSection}
\let\PhlmOldSubsection\subsection
\renewcommand{\subsection}{\Needspace*{3\baselineskip}\PhlmOldSubsection}

\tolerance=3000
\emergencystretch=3em
\hyphenpenalty=50
\exhyphenpenalty=50
% \hbadness was previously 10000 (and \sloppy set it there again), which
% silenced EVERY Underfull \hbox warning -- the build's "0 underfull" was
% meaningless. The LaTeX default of 1000 is too strict for CJK, which cannot
% hyphenate and so legitimately produces looser lines than Latin; at 1000
% this book reports ~7200 lines. 2500 reports lines that are genuinely badly
% spaced while accepting normal CJK looseness, so the number means something.
\hbadness=2500
\hfuzz=0.5pt

% Every short cell in a p{}-column table is an Underfull \hbox "in alignment"
% at badness 10000. That is inherent to tables, not a defect, and this book has
% ~3600 of them -- enough to bury any real warning. Silence them inside table
% environments ONLY, so body-text looseness still reports honestly.
\AtBeginEnvironment{longtable}{\hbadness=10000}
\AtBeginEnvironment{tabular}{\hbadness=10000}
\AtBeginEnvironment{tabularx}{\hbadness=10000}

