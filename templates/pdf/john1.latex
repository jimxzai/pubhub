{\fontsize{13}{16}\selectfont\itshape\color{TextGray} A Study of the First Epistle of John}

\vspace{0.24cm}
{\fontsize{15}{18}\selectfont\itshape\color{InkNavy} ἡ ζωὴ ἐφανερώθη}\quad
{\footnotesize\bfseries\color{ThresholdSlate} 這生命已經顯現出來}

\vfill

\fcolorbox{ScriptureGold}{white}{%
\begin{minipage}{4.3in}
\centering\vspace{0.15cm}
{\footnotesize\color{InkNavy}\kaiti\selectfont
「我將這些話寫給你們信奉神兒子之名的人，要叫你們知道自己有永生。」}\\[0.10em]
{\scriptsize\itshape\color{TextGray}
“These things I have written to you who believe in the name of the Son of God,\\
so that you may know that you have eternal life.”}\\[0.10em]
{\scriptsize\color{InkNavy} 約翰一書 5:13 \textperiodcentered\ 1 John 5:13}
\vspace{0.15cm}
\end{minipage}}

\vspace{0.3in}
\end{center}
