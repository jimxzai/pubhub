% James and Paul Diagram Page
\thispagestyle{empty}
\begin{center}
\vspace*{0.5cm}
{\Large\bfseries\color{ChapterGreen} 雅各書與保羅書信的和諧}\\[0.1cm]
{\normalsize James and Paul: Complementary Teaching}

\vspace{0.6cm}

\begin{tikzpicture}[scale=0.9]
  % Two circles for James and Paul
  \draw[ChapterGreen,line width=2pt] (-3,0) circle (2.5);
  \draw[ChapterGreen,line width=2pt] (3,0) circle (2.5);

  % Labels
  \node[font=\large\bfseries,color=ChapterGreen] at (-3,2) {雅各 James};
