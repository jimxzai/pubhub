\vspace{0.35cm}

% Four-part structure
\begin{tikzpicture}[scale=0.72, transform shape]
  \node[draw=ChapterBlue,fill=ChapterBlue!10,rounded corners,minimum width=3.4cm,minimum height=2cm] at (0,0) {};
  \node[font=\small\bfseries,color=ChapterBlue] at (0,0.5) {榮耀基督};
  \node[font=\footnotesize,color=TextGray] at (0,0) {\& 七教會};
  \node[font=\tiny,color=LightGray] at (0,-0.5) {Chapters 1-3};

