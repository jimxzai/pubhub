\vspace{0.30cm}

% ===== TWO PILLARS AND ONE LAMP (Jachin and Boaz, 7:21; the lamp, 11:36) =====
\begin{tikzpicture}[scale=0.85, transform shape]
  % Lintel
  \fill[ChapterCedar, opacity=0.85] (-1.75,1.75) rectangle (1.75,1.95);
  % Left pillar (Jachin)
  \fill[ChapterCedar, opacity=0.78] (-1.55,-1.25) rectangle (-0.95,1.75);
  \draw[ChapterCedar, line width=0.8pt] (-1.55,-1.25) rectangle (-0.95,1.75);
  % Right pillar (Boaz)
  \fill[ChapterCedar, opacity=0.78] (0.95,-1.25) rectangle (1.55,1.75);
  \draw[ChapterCedar, line width=0.8pt] (0.95,-1.25) rectangle (1.55,1.75);
  % Floor
  \draw[ScriptureGold, line width=1pt] (-1.9,-1.25) -- (1.9,-1.25);
  % The lamp: a small oil bowl and one flame between the pillars
  \fill[ScriptureGold] (-0.28,-0.55) .. controls (-0.28,-0.85) and (0.28,-0.85) .. (0.28,-0.55) -- cycle;
  \fill[LampAmber] (0,-0.52) .. controls (0.34,-0.12) and (0.30,0.30) .. (0,0.78)
