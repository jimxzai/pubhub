% ============================================================================
% Psalter Liturgical Template 2026 - Premium Edition
% Large Print (8.5×11" Letter) for Lectern/Ceremonial Use
% Full CJK Bilingual + Red Letter (Messianic verses) + Five-Book Diagrams
% Adapted from gospel-harmony-liturgical.latex for the Whole Psalter (Pss 1-150)
% Requires XeLaTeX for CJK support
% ============================================================================

\documentclass[12pt,twoside,openright]{memoir}

%% ============================================
%% PAGE SIZE - 8.5×11" Letter (Lectern Use)
%% ============================================
\setstocksize{11in}{8.5in}
\settrimmedsize{\stockheight}{\stockwidth}{*}
\settrims{0pt}{0pt}

\setlrmarginsandblock{1.25in}{1in}{*}
\setulmarginsandblock{1in}{1.25in}{*}
\setheadfoot{0.5in}{0.5in}
\setheaderspaces{*}{0.3in}{*}
\checkandfixthelayout

%% ============================================
%% FONT SETUP WITH CJK LINE BREAKING
%% ============================================
\usepackage{fontspec}

\setmainfont{Songti SC}[
  BoldFont=Songti SC,
  BoldFeatures={FakeBold=2.2},
  ItalicFont=Kaiti SC,
  Ligatures=TeX
]
\setsansfont[Ligatures=TeX]{PingFang SC}
\setmonofont{PingFang SC}

\newfontfamily\kaiti{Kaiti SC}
\newfontfamily\fangsong{STFangsong}
\newfontfamily\heiti{Heiti SC}

\newcommand{\textkai}[1]{{\kaiti #1}}
\newcommand{\textfs}[1]{{\fangsong #1}}
\newcommand{\texthei}[1]{{\heiti #1}}

%% Greek and Hebrew font support
\usepackage{ucharclasses}
\newfontfamily\greekfont{Times New Roman}[Script=Greek]
\newfontfamily\hebrewfont{Arial Hebrew}[Script=Hebrew]
%% ucharclasses fix (see .claude/skills/eat-bible/references/gotchas.md):
%%  * {Greek} is a class GROUP, not a block — the block is GreekAndCoptic, so
%%    the original line compiled fine and did nothing; basic Greek fell back
%%    to the main font's own glyphs with no warning.
%%  * These stay on the 3-arg \setTransitionsFor form. \setTransitionTo is
%%    safer in principle (it cannot clobber another block's enter-code) but it
%%    removes the leaving-code, so it REQUIRES every block the book uses to
%%    have an explicit destination. Migrating without that census puts CJK
%%    after a Greek run into \greekfont — measured here, it broke 1 Peter and
%%    2 Timothy outright. Do that migration per book, with the block census,
%%    the way templates/pdf/revelation.latex and isaiah.latex do it.
\setTransitionsFor{GreekAndCoptic}{\greekfont}{\normalfont}
\setTransitionsFor{GreekExtended}{\greekfont}{\normalfont}
\setTransitionsFor{Hebrew}{\hebrewfont}{\normalfont}
\XeTeXlinebreaklocale "zh"
\XeTeXlinebreakskip = 0pt plus 1pt minus 0.1pt

%% ============================================
%% LINE SPACING - Large Print for Readability
%% ============================================
\linespread{1.35}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.5em}

%% ============================================
%% COLOR SCHEME - Psalter Liturgical Edition
%% ============================================
\usepackage{xcolor}

\definecolor{LiturgicalRed}{RGB}{165,30,30}       % Deep ceremonial red
\definecolor{LiturgicalGold}{RGB}{184,134,11}     % Gold for ornaments
\definecolor{LiturgicalBlue}{RGB}{40,60,100}      % Deep blue for headings
\definecolor{RubricRed}{RGB}{180,40,40}

% RED LETTER — Messianic / Christ-fulfilled verses
\definecolor{JesusRed}{RGB}{180,0,0}

% Five books of the Psalter
\definecolor{BookOneOlive}{RGB}{120,120,80}
\definecolor{BookTwoGold}{RGB}{176,138,58}
\definecolor{BookThreeRust}{RGB}{158,84,66}
\definecolor{BookFourSage}{RGB}{100,130,110}
\definecolor{BookFiveAmber}{RGB}{196,120,70}

% Box colors
\definecolor{ScriptureBg}{RGB}{252,250,245}
\definecolor{NoteBg}{RGB}{255,253,245}

% Text colors
\definecolor{TextGray}{RGB}{50,50,50}
\definecolor{LightGray}{RGB}{120,120,120}

% Liturgical season colors (for the year wheel)
\definecolor{AdventBlue}{RGB}{75,0,130}
\definecolor{ChristmasWhite}{RGB}{255,250,240}
\definecolor{LentPurple}{RGB}{128,0,128}
\definecolor{EasterWhite}{RGB}{255,215,0}
\definecolor{OrdinaryGreen}{RGB}{0,128,0}
\definecolor{HolyWeekRed}{RGB}{139,0,0}

%% ============================================
%% MATH AND SYMBOLS
%% ============================================
\usepackage{amssymb}
\usepackage{amsmath}

%% ============================================
%% GRAPHICS AND TIKZ
%% ============================================
\usepackage{graphicx}
\usepackage{tikz}
\usetikzlibrary{shapes,arrows,positioning,fit,backgrounds,calc}

%% ============================================
%% RED LETTER COMMAND (Messianic verses)
%% ============================================
\newcommand{\jesus}[1]{\textcolor{JesusRed}{\textit{#1}}}

%% Large verse numbers for lectern reading
\newcommand{\vs}[1]{%
  \textsuperscript{\Large\bfseries\color{LiturgicalRed}#1}\,%
}

%% ============================================
%% LITURGICAL COMMANDS
%% ============================================
\newcommand{\rubric}[1]{%
  \vspace{0.5em}
  \noindent{\color{RubricRed}\textit{#1}}
  \vspace{0.5em}
}

\newcommand{\antiphonzh}[2]{%
  \begin{center}
    {\large\color{LiturgicalGold}\ensuremath{\dagger}}\\[0.3em]
    {\itshape #1}\\[0.15em]
    {\small\itshape #2}\\[0.3em]
    {\large\color{LiturgicalGold}\ensuremath{\dagger}}
  \end{center}
}

\newcommand{\liturgicaldiv}{%
  \begin{center}
    \vspace{0.5em}
    {\Large\color{LiturgicalGold}\ensuremath{\dagger}\quad\ensuremath{\dagger}\quad\ensuremath{\dagger}}
    \vspace{0.5em}
  \end{center}
}

\newcommand{\ornamentdiv}{%
  \begin{center}
    \vspace{0.3em}
    \begin{tikzpicture}
      \draw[LiturgicalGold, line width=1pt] (-2,0) -- (-0.5,0);
      \node[color=LiturgicalGold] at (0,0) {\ensuremath{\diamond}};
      \draw[LiturgicalGold, line width=1pt] (0.5,0) -- (2,0);
    \end{tikzpicture}
    \vspace{0.3em}
  \end{center}
}

% Lyre — the psalter's instrument (cover-scale)
\newcommand{\coverlyre}{%
\begin{tikzpicture}[scale=0.78, transform shape]
  % Halo — soft glow rings
  \draw[LiturgicalGold, line width=0.3pt, opacity=0.10] (0,1.05) circle (2.30);
  \draw[LiturgicalGold, line width=0.3pt, opacity=0.15] (0,1.05) circle (2.10);
  \draw[LiturgicalGold, line width=0.4pt, opacity=0.22] (0,1.05) circle (1.85);
  \draw[LiturgicalGold, line width=0.5pt, opacity=0.32] (0,1.05) circle (1.55);
  % Radiating rays
  \foreach \ang in {0,10,20,...,350} {
    \draw[LiturgicalGold, line width=0.35pt, opacity=0.42]
      ({1.05*cos(\ang)}, {1.05+1.05*sin(\ang)}) -- ({1.55*cos(\ang)}, {1.05+1.55*sin(\ang)});
  }
  \foreach \ang in {0,90,180,270} {
    \draw[LiturgicalGold, line width=0.55pt, opacity=0.55]
      ({1.05*cos(\ang)}, {1.05+1.05*sin(\ang)}) -- ({1.80*cos(\ang)}, {1.05+1.80*sin(\ang)});
  }
  \draw[LiturgicalGold, line width=1.0pt] (0,1.05) circle (1.05);
  \draw[LiturgicalGold, line width=0.4pt, opacity=0.45] (0,1.05) circle (0.95);

  % Lyre body (shadow then gold+red)
  \draw[LiturgicalBlue, line width=2.6pt, opacity=0.18]
    (-0.62,0.32) .. controls (-0.88,1.22) .. (-0.40,1.78);
  \draw[LiturgicalBlue, line width=2.6pt, opacity=0.18]
    (0.66,0.32) .. controls (0.92,1.22) .. (0.44,1.78);
  \draw[LiturgicalRed, line width=2.4pt]
    (-0.64,0.30) .. controls (-0.90,1.20) .. (-0.42,1.76);
  \draw[LiturgicalRed, line width=2.4pt]
    (0.64,0.30) .. controls (0.90,1.20) .. (0.42,1.76);
  % Sound-bowl
  \draw[LiturgicalRed, line width=2.4pt]
    (-0.64,0.30) .. controls (0,-0.18) .. (0.64,0.30);
  \fill[LiturgicalGold] (0,0.02) circle (0.09);
  % Crossbar
  \draw[LiturgicalGold, line width=2.0pt] (-0.52,1.72) -- (0.52,1.72);
  % Strings
  \draw[LiturgicalGold, line width=0.6pt] (-0.30,0.20) -- (-0.30,1.70);
  \draw[LiturgicalGold, line width=0.6pt] (-0.10,0.14) -- (-0.10,1.70);
  \draw[LiturgicalGold, line width=0.6pt] (0.10,0.14) -- (0.10,1.70);
  \draw[LiturgicalGold, line width=0.6pt] (0.30,0.20) -- (0.30,1.70);
  % Finials
  \fill[LiturgicalGold] (-0.42,1.76) circle (0.10);
  \fill[LiturgicalGold] (0.42,1.76) circle (0.10);
  \fill[LiturgicalGold] (-0.52,1.86) circle (0.05);
  \fill[LiturgicalGold] (0.52,1.86) circle (0.05);
\end{tikzpicture}%
}

% Five-book structure bar (used on cover & structure page)
\newcommand{\fivebookbar}{%
\begin{tikzpicture}[scale=0.80, transform shape]
  \node[draw=BookOneOlive,fill=BookOneOlive!12,rounded corners,minimum width=2.6cm,minimum height=2.1cm] at (0,0) {};
  \node[font=\small\bfseries,color=BookOneOlive!70!black] at (0,0.62) {卷一 I};
  \node[font=\scriptsize,color=TextGray] at (0,0.2) {詩 1--41};
  \node[font=\scriptsize,color=LiturgicalRed!80!black] at (0,-0.22) {創世記};
  \node[font=\scriptsize,color=LightGray] at (0,-0.62) {有福的人};

  \node[draw=BookTwoGold,fill=BookTwoGold!12,rounded corners,minimum width=2.6cm,minimum height=2.1cm] at (3.0,0) {};
  \node[font=\small\bfseries,color=BookTwoGold!70!black] at (3.0,0.62) {卷二 II};
  \node[font=\scriptsize,color=TextGray] at (3.0,0.2) {詩 42--72};
  \node[font=\scriptsize,color=LiturgicalRed!80!black] at (3.0,-0.22) {出埃及記};
  \node[font=\scriptsize,color=LightGray] at (3.0,-0.62) {拯救、王};

  \node[draw=BookThreeRust,fill=BookThreeRust!12,rounded corners,minimum width=2.6cm,minimum height=2.1cm] at (6.0,0) {};
  \node[font=\small\bfseries,color=BookThreeRust!70!black] at (6.0,0.62) {卷三 III};
  \node[font=\scriptsize,color=TextGray] at (6.0,0.2) {詩 73--89};
  \node[font=\scriptsize,color=LiturgicalRed!80!black] at (6.0,-0.22) {利未記};
  \node[font=\scriptsize,color=LightGray] at (6.0,-0.62) {聖所、約};

  \node[draw=BookFourSage,fill=BookFourSage!12,rounded corners,minimum width=2.6cm,minimum height=2.1cm] at (9.0,0) {};
  \node[font=\small\bfseries,color=BookFourSage!70!black] at (9.0,0.62) {卷四 IV};
  \node[font=\scriptsize,color=TextGray] at (9.0,0.2) {詩 90--106};
  \node[font=\scriptsize,color=LiturgicalRed!80!black] at (9.0,-0.22) {民數記};
  \node[font=\scriptsize,color=LightGray] at (9.0,-0.62) {耶和華作王};

  \node[draw=BookFiveAmber,fill=BookFiveAmber!12,rounded corners,minimum width=2.6cm,minimum height=2.1cm] at (12.0,0) {};
  \node[font=\small\bfseries,color=BookFiveAmber!70!black] at (12.0,0.62) {卷五 V};
  \node[font=\scriptsize,color=TextGray] at (12.0,0.2) {詩 107--150};
  \node[font=\scriptsize,color=LiturgicalRed!80!black] at (12.0,-0.22) {申命記};
  \node[font=\scriptsize,color=LightGray] at (12.0,-0.62) {話語、頌讚};

  \draw[->,thick,color=LiturgicalGold] (1.38,0) -- (1.62,0);
  \draw[->,thick,color=LiturgicalGold] (4.38,0) -- (4.62,0);
  \draw[->,thick,color=LiturgicalGold] (7.38,0) -- (7.62,0);
  \draw[->,thick,color=LiturgicalGold] (10.38,0) -- (10.62,0);
\end{tikzpicture}%
}

% Liturgical year wheel (adapted from gospel-harmony-liturgical)
\newcommand{\liturgicalwheel}{%
\begin{tikzpicture}[scale=0.85, transform shape]
  \def\outerrad{4.2}
  \def\innerrad{3.0}
  \def\centerrad{1.4}
  \fill[AdventBlue!70] (90:\innerrad) arc (90:45:\innerrad) -- (45:\outerrad) arc (45:90:\outerrad) -- cycle;
  \fill[ChristmasWhite, draw=LiturgicalGold, line width=0.5pt] (45:\innerrad) arc (45:0:\innerrad) -- (0:\outerrad) arc (0:45:\outerrad) -- cycle;
  \fill[OrdinaryGreen!60] (0:\innerrad) arc (0:-45:\innerrad) -- (-45:\outerrad) arc (-45:0:\outerrad) -- cycle;
  \fill[LentPurple!60] (-45:\innerrad) arc (-45:-110:\innerrad) -- (-110:\outerrad) arc (-110:-45:\outerrad) -- cycle;
  \fill[HolyWeekRed!70] (-110:\innerrad) arc (-110:-130:\innerrad) -- (-130:\outerrad) arc (-130:-110:\outerrad) -- cycle;
  \fill[EasterWhite, draw=LiturgicalGold, line width=0.5pt] (-130:\innerrad) arc (-130:-200:\innerrad) -- (-200:\outerrad) arc (-200:-130:\outerrad) -- cycle;
  \fill[OrdinaryGreen!60] (-200:\innerrad) arc (-200:-270:\innerrad) -- (-270:\outerrad) arc (-270:-200:\outerrad) -- cycle;
  \fill[white] (0,0) circle (\centerrad);
  \draw[LiturgicalGold, line width=2pt] (0,0) circle (\centerrad);
  % Center: a lyre in place of the cross
  \draw[LiturgicalRed, line width=1.6pt] (-0.42,-0.55) .. controls (-0.60,0.15) .. (-0.28,0.62);
  \draw[LiturgicalRed, line width=1.6pt] (0.42,-0.55) .. controls (0.60,0.15) .. (0.28,0.62);
  \draw[LiturgicalRed, line width=1.6pt] (-0.42,-0.55) .. controls (0,-0.90) .. (0.42,-0.55);
  \draw[LiturgicalGold, line width=1.2pt] (-0.34,0.58) -- (0.34,0.58);
  \draw[LiturgicalGold, line width=0.5pt] (-0.18,-0.62) -- (-0.18,0.56);
  \draw[LiturgicalGold, line width=0.5pt] (0,-0.66) -- (0,0.56);
  \draw[LiturgicalGold, line width=0.5pt] (0.18,-0.62) -- (0.18,0.56);
  \node[font=\scriptsize\bfseries, text=white, rotate=-22.5] at (67.5:3.6) {ADVENT 將臨期};
  \node[font=\scriptsize\bfseries, text=LiturgicalGold!80!black, rotate=-67.5] at (22.5:3.6) {CHRISTMAS 聖誕期};
  \node[font=\scriptsize\bfseries, text=white, rotate=67.5] at (-22.5:3.6) {ORDINARY 常年期};
  \node[font=\scriptsize\bfseries, text=white, rotate=12.5] at (-77.5:3.6) {LENT 大齋期};
  \node[font=\scriptsize\bfseries, text=LiturgicalGold!80!black, rotate=105] at (-165:3.6) {EASTER 復活期};
  \node[font=\scriptsize\bfseries, text=white, rotate=55] at (-235:3.6) {ORDINARY 常年期};
  \draw[LiturgicalGold, line width=2pt] (0,0) circle (\outerrad);
  \draw[LiturgicalGold, line width=1pt] (0,0) circle (\innerrad);
  \node[font=\normalsize\bfseries, text=LiturgicalRed] at (0,-5.3) {THE LITURGICAL YEAR 教會年曆 \textperiodcentered\ 詩篇隨年而唱};
\end{tikzpicture}
}

% Songs of Ascent staircase (Pss 120-134, fifteen steps)
\newcommand{\ascentstairs}{%
\begin{tikzpicture}[scale=0.62, transform shape]
  \foreach \i in {0,...,14} {
    \pgfmathsetmacro{\x}{\i*1.05}
    \pgfmathsetmacro{\y}{\i*0.42}
    \pgfmathtruncatemacro{\ps}{120+\i}
    \fill[LiturgicalGold!25] (\x,\y) rectangle (\x+1.0,\y+0.38);
    \draw[LiturgicalGold, line width=0.7pt] (\x,\y) rectangle (\x+1.0,\y+0.38);
    \node[font=\tiny\bfseries, color=LiturgicalBlue] at (\x+0.5,\y+0.19) {\ps};
  }
  \node[font=\scriptsize, color=TextGray, anchor=west] at (0,-0.55) {120 流離};
  \node[font=\scriptsize, color=TextGray] at (7.9,2.6) {126 流淚撒種};
  \node[font=\scriptsize, color=TextGray] at (11.0,4.0) {130 從深處};
  \node[font=\scriptsize, color=TextGray, anchor=east] at (15.7,6.9) {134 殿中事奉};
  \draw[->, thick, LiturgicalRed] (0.2,-1.1) -- (3.2,-1.1);
  \node[font=\scriptsize\bfseries, color=LiturgicalRed, anchor=west] at (3.5,-1.1) {上行之詩 Songs of Ascent \textperiodcentered\ 十五階朝聖之路（詩120--134）};
\end{tikzpicture}
}

% Christological trajectory line
\newcommand{\christtrajectory}{%
\begin{tikzpicture}[scale=0.72, transform shape]
  \draw[LiturgicalGold,line width=1.5pt] (0.3,0) -- (15.2,0);
  \fill[LiturgicalRed] (0.7,0) circle (0.30);
  \node[font=\tiny\bfseries,color=white] at (0.7,0) {1};
  \node[font=\scriptsize,color=TextGray,align=center,text width=2.3cm] at (0.7,-0.95) {有福的人\\詩 1--2};
  \fill[LiturgicalRed] (4.2,0) circle (0.30);
  \node[font=\tiny\bfseries,color=white] at (4.2,0) {22};
  \node[font=\scriptsize,color=TextGray,align=center,text width=2.3cm] at (4.2,-0.95) {受苦的牧人\\詩 22--24};
  \fill[LiturgicalRed] (7.7,0) circle (0.30);
  \node[font=\tiny\bfseries,color=white] at (7.7,0) {89};
  \node[font=\scriptsize,color=TextGray,align=center,text width=2.3cm] at (7.7,-0.95) {約的危機\\詩 89};
  \fill[LiturgicalRed] (11.2,0) circle (0.30);
  \node[font=\tiny\bfseries,color=white] at (11.2,0) {110};
  \node[font=\scriptsize,color=TextGray,align=center,text width=2.3cm] at (11.2,-0.95) {君王祭司\\詩 110};
  \fill[LiturgicalRed] (14.7,0) circle (0.30);
  \node[font=\tiny\bfseries,color=white] at (14.7,0) {150};
  \node[font=\scriptsize,color=TextGray,align=center,text width=2.3cm] at (14.7,-0.95) {凡有氣息的\\詩 146--150};
\end{tikzpicture}%
}

