% ===== TWO TABLETS OF THE COVENANT — SINAI / MOAB, WITH THE JORDAN AHEAD =====
\begin{tikzpicture}[scale=0.85, transform shape]
  % The two tablets — rounded, not sharp-cornered stone
  \draw[StoneGray, line width=1pt, fill=StoneGray, fill opacity=0.16, rounded corners=6pt]
    (-1.45,-1.3) rectangle (-0.15,1.3);
  \draw[StoneGray, line width=1pt, fill=StoneGray, fill opacity=0.16, rounded corners=6pt]
    (0.15,-1.3) rectangle (1.45,1.3);
  % Five commandment-lines carved on each tablet
  \foreach \y in {0.85,0.4,-0.05,-0.5,-0.95} {
    \draw[StoneGray, line width=0.6pt, opacity=0.7] (-1.2,\y) -- (-0.4,\y);
    \draw[StoneGray, line width=0.6pt, opacity=0.7] (0.4,\y) -- (1.2,\y);
  }
  % The covenant seam — sworn in blood, binding the two tablets as one (Exod 24:8)
  \draw[CovenantCrimson, line width=1.4pt] (0,-1.3) -- (0,1.3);
  % The Jordan — the horizon ahead, not yet crossed (34:1-4)
  \draw[JordanBlue, line width=1.1pt, opacity=0.85]
    (-1.7,-1.55) .. controls (-0.8,-1.7) and (0.8,-1.4) .. (1.7,-1.6);
