  \node[font=\tiny,color=LightGray] at (-4.2,1.55) {1-4};

  \node[draw=StoneGray,fill=ScriptureBg,rounded corners,minimum width=2.5cm,minimum height=0.7cm,font=\tiny] (v2) at (-1.4,2.2) {卷二 \textperiodcentered\ 總綱誡命};
  \node[font=\tiny,color=LightGray] at (-1.4,1.55) {5-11};

  \node[draw=StoneGray,fill=ScriptureBg,rounded corners,minimum width=2.5cm,minimum height=0.7cm,font=\tiny] (v3) at (1.4,2.2) {卷三 \textperiodcentered\ 律例典章};
  \node[font=\tiny,color=LightGray] at (1.4,1.55) {12-26};

  \node[draw=CovenantCrimson,fill=ScriptureBg,rounded corners,minimum width=2.5cm,minimum height=0.7cm,font=\tiny] (v4) at (-2.1,0.3) {卷四 \textperiodcentered\ 立約更新};
  \node[font=\tiny,color=LightGray] at (-2.1,-0.35) {27-30};

  \node[draw=JordanBlue!70!black,fill=ScriptureBg,rounded corners,minimum width=2.5cm,minimum height=0.7cm,font=\tiny] (v5) at (2.1,0.3) {卷五 \textperiodcentered\ 摩西的末了};
  \node[font=\tiny,color=LightGray] at (2.1,-0.35) {31-34};

  \draw[->,color=ScriptureGold,thick] (v1.east) -- (v2.west);
