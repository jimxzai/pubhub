% PubHub Romans Template
% Professional Bible Study Book Layout
% Bilingual Chinese/English with Greek word studies
% Requires XeLaTeX for CJK support

\documentclass[11pt,openany]{book}

%% ============================================
%% FONT SETUP WITH CJK LINE BREAKING
%% ============================================
\usepackage{fontspec}

\setmainfont{Songti SC}[
  BoldFont=Songti SC Bold,
  ItalicFont=Kaiti SC
]
\setsansfont{PingFang SC}
\setmonofont{Songti SC}

%% Greek and Hebrew font support - auto-switch for Unicode blocks
\usepackage{ucharclasses}
\newfontfamily\greekfont{Times New Roman}[Script=Greek]
\newfontfamily\hebrewfont{Arial Hebrew}[Script=Hebrew]
\newfontfamily\cjkfallbackfont{Songti SC}

%% Classical English typeface — auto-switch for Latin-script runs so
%% bilingual scripture/quote blocks render in a period-appropriate serif
%% instead of Songti SC's built-in Latin glyphs. Baskerville for running
%% text; Didot reserved for large display lines (invoked explicitly).
\newfontfamily\basklatin{Baskerville}
\newfontfamily\didotfont{Didot}
% Alias matching the naming convention used on the full-bleed cover pages
\newcommand{\baskervillefont}{\basklatin}
\setTransitionsFor{Greek}{\greekfont}{\normalfont}
\setTransitionsFor{GreekExtended}{\greekfont}{\normalfont}
\setTransitionsFor{Hebrew}{\hebrewfont}{\normalfont}
\setTransitionsFor{Han}{\cjkfallbackfont}{\normalfont}
\setTransitionsFor{Latin}{\basklatin}{\normalfont}
% Latin Extended Additional (e.g. combining-dot-below transliterations
% like Hebrew *ḥesed*/*ḥashab*) — Kaiti SC's italic has no glyph for
% these, so route them to Baskerville too.
\setTransitionsFor{LatinExtendedAdditional}{\basklatin}{\normalfont}

%% Enable CJK line breaking - critical for Chinese text
\XeTeXlinebreaklocale "zh"
\XeTeXlinebreakskip = 0pt plus 1pt minus 0.1pt

%% ============================================
%% PAGE GEOMETRY - Fixed margins (more conservative)
%% ============================================
\usepackage{geometry}
\geometry{
  paperwidth=7in,
  paperheight=10in,
  top=0.75in,
  bottom=0.75in,
  inner=0.8in,
  outer=0.65in,
  marginparwidth=0in,
  marginparsep=0in
}

%% ============================================
%% LINE AND PARAGRAPH SPACING
%% ============================================
\linespread{1.1}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.3em}

%% ============================================
%% COLOR SCHEME - Romans Theme (Navy/Gold, Imperial Rome)
%% ============================================
\usepackage{xcolor}

% Primary colors - Imperial Rome theme (navy + aged brass), retuned from
% the oxblood/burgundy scheme used elsewhere in this series
\definecolor{ChapterBlue}{RGB}{22,42,82}          % Deep navy — Romans theme (macro name kept for compatibility)
\definecolor{ScriptureGold}{RGB}{150,115,55}      % Aged brass for scripture refs / laurel-cross
\definecolor{CommentaryBrown}{RGB}{60,55,80}      % Muted indigo-brown for commentary, tuned to sit with navy

% Box colors
\definecolor{ScriptureBg}{RGB}{248,249,252}       % Cool cream for scripture boxes
\definecolor{GreekBg}{RGB}{245,246,251}           % Faint blue-grey for Greek
\definecolor{ApplicationBg}{RGB}{246,248,250}     % Light slate for application

% Text colors
\definecolor{TextGray}{RGB}{50,50,50}
\definecolor{LightGray}{RGB}{120,120,120}

% Diagram colors
\definecolor{OldCovenantRed}{RGB}{150,40,40}      % Warning / conflict
\definecolor{NewCovenantGreen}{RGB}{70,110,70}    % Grace / growth

%% ============================================
%% MATH AND SYMBOLS
%% ============================================
\usepackage{amssymb}
\usepackage{amsmath}

%% ============================================
%% GRAPHICS AND TIKZ FOR DIAGRAMS
%% ============================================
\usepackage{graphicx}
\usepackage{tikz}
\usetikzlibrary{shapes,arrows,positioning,fit,backgrounds,calc,decorations.pathmorphing}
\usepackage{pgfornament}

%% ============================================
%% TIKZ COMMANDS FOR DECORATIONS
%% ============================================

% Cross decoration
\newcommand{\crosssymbol}{%
\begin{tikzpicture}[scale=0.15]
  \draw[color=ScriptureGold,line width=1.5pt] (0,-1) -- (0,1);
  \draw[color=ScriptureGold,line width=1.5pt] (-0.6,0.4) -- (0.6,0.4);
\end{tikzpicture}%
}

% Classical printer's-ornament divider: thin rule — fleuron — thin rule,
% for a more antique-book feel.
\newcommand{\ornamentdivider}[1][2in]{%
  {\color{ScriptureGold}\rule{#1}{0.4pt}}\hspace{0.15cm}%
  \raisebox{-0.22cm}{\pgfornament[width=0.5cm,color=ScriptureGold]{88}}%
  \hspace{0.15cm}{\color{ScriptureGold}\rule{#1}{0.4pt}}%
}

% A single small fleuron (no rules), used standalone on the full-bleed
% cover pages and the dedication/colophon pages.
\newcommand{\fleuron}[1][ScriptureGold]{%
  \pgfornament[width=0.55cm,color=#1]{88}%
}

% Classical double-rule (hairline) frame — replaces solid fcolorbox fills
% with a manuscript/antique-book-plate style surround.
\newcommand{\classicalframe}[1]{%
\begin{tikzpicture}
  \node[fill=ScriptureBg,inner sep=14pt] (box) {#1};
  \draw[color=ScriptureGold,line width=0.4pt] ($$(box.south west)+(-3pt,-3pt)$$) rectangle ($$(box.north east)+(3pt,3pt)$$);
  \draw[color=ScriptureGold,line width=0.4pt] ($$(box.south west)+(-6pt,-6pt)$$) rectangle ($$(box.north east)+(6pt,6pt)$$);
\end{tikzpicture}%
}

% Laurel-wreath-and-cross symbol — two laurel branches curving inward
% (echoing Roman imperial imagery and Romans 8:37 "more than conquerors")
% with a small cross at the top center. Simple line-drawing style,
% consistent with the file's other minimalist gold TikZ ornaments.
\newcommand{\laurelcrosssymbol}{%
\begin{tikzpicture}[scale=0.2]
  % small cross at top center
  \draw[color=ScriptureGold,line width=1pt] (0,0.55) -- (0,1.15);
  \draw[color=ScriptureGold,line width=1pt] (-0.22,0.95) -- (0.22,0.95);
  % left laurel branch — a curved spine with short leaf strokes
  \draw[color=ScriptureGold,line width=0.9pt]
    (-0.15,0.5) .. controls (-0.55,0.35) and (-0.75,0.0) .. (-0.7,-0.6);
  \draw[color=ScriptureGold,line width=0.7pt] (-0.25,0.42) -- (-0.45,0.55);
  \draw[color=ScriptureGold,line width=0.7pt] (-0.4,0.22) -- (-0.62,0.32);
  \draw[color=ScriptureGold,line width=0.7pt] (-0.55,-0.02) -- (-0.78,0.06);
  \draw[color=ScriptureGold,line width=0.7pt] (-0.65,-0.28) -- (-0.9,-0.22);
  \draw[color=ScriptureGold,line width=0.7pt] (-0.7,-0.55) -- (-0.96,-0.52);
  % right laurel branch — mirror
  \draw[color=ScriptureGold,line width=0.9pt]
    (0.15,0.5) .. controls (0.55,0.35) and (0.75,0.0) .. (0.7,-0.6);
  \draw[color=ScriptureGold,line width=0.7pt] (0.25,0.42) -- (0.45,0.55);
  \draw[color=ScriptureGold,line width=0.7pt] (0.4,0.22) -- (0.62,0.32);
  \draw[color=ScriptureGold,line width=0.7pt] (0.55,-0.02) -- (0.78,0.06);
  \draw[color=ScriptureGold,line width=0.7pt] (0.65,-0.28) -- (0.9,-0.22);
  \draw[color=ScriptureGold,line width=0.7pt] (0.7,-0.55) -- (0.96,-0.52);
\end{tikzpicture}%
}

%% ============================================
%% FULL-BLEED COVER MACHINERY (front/back cover only)
%% ============================================
\usepackage{eso-pic}
\usepackage{lettrine}

% Navy gradient for the full-bleed cover background — deep navy to a
% lighter blue, full-bleed. `shading angle` requires a reasonably recent
% pgf; this TeX Live 2026 install supports it, but the plain two-color
% left-right shade is kept in a comment as the documented fallback.
\definecolor{NavyDeep}{RGB}{12,24,52}
\definecolor{NavyLight}{RGB}{38,68,120}
\newcommand{\CoverBackground}{%
  \AddToShipoutPictureBG*{%
    \begin{tikzpicture}[remember picture,overlay]
      \shade[shading angle=115, left color=NavyDeep, right color=NavyLight]
        (current page.south west) rectangle (current page.north east);
    \end{tikzpicture}%
  }%
}
% Fallback (uncomment if `shading angle` errors on a different TeX Live):
% \newcommand{\CoverBackground}{%
%   \AddToShipoutPictureBG*{%
%     \begin{tikzpicture}[remember picture,overlay]
%       \shade[left color=NavyDeep, right color=NavyLight]
%         (current page.south west) rectangle (current page.north east);
%     \end{tikzpicture}%
%   }%
% }

% Classical book-plate border: two inset hairlines plus a small corner
% ornament at each corner, painted in the foreground hook (after page
% content) using the page's own bounding box.
\newcommand{\CoverBorder}{%
  \AddToShipoutPictureFG*{%
    \begin{tikzpicture}[remember picture,overlay]
      \draw[color=ScriptureGold,line width=0.5pt]
        ($$(current page.south west)+(0.45in,0.45in)$$) rectangle ($$(current page.north east)-(0.45in,0.45in)$$);
      \draw[color=ScriptureGold,line width=0.4pt]
        ($$(current page.south west)+(0.52in,0.52in)$$) rectangle ($$(current page.north east)-(0.52in,0.52in)$$);
      \node[color=ScriptureGold] at ($$(current page.south west)+(0.55in,0.55in)$$) {\pgfornament[width=0.45cm,color=ScriptureGold]{88}};
      \node[color=ScriptureGold,rotate=90] at ($$(current page.north west)+(0.55in,-0.55in)$$) {\pgfornament[width=0.45cm,color=ScriptureGold]{88}};
      \node[color=ScriptureGold,rotate=-90] at ($$(current page.south east)+(-0.55in,0.55in)$$) {\pgfornament[width=0.45cm,color=ScriptureGold]{88}};
      \node[color=ScriptureGold,rotate=180] at ($$(current page.north east)+(-0.55in,-0.55in)$$) {\pgfornament[width=0.45cm,color=ScriptureGold]{88}};
    \end{tikzpicture}%
  }%
}

% A small consistent publisher's device, reused on the half-title page,
% the front cover, and the closing colophon page.
\newcommand{\publishersmark}[1][ScriptureGold]{%
  \pgfornament[width=0.4cm,color=#1]{38}%
}

% Light-on-dark cover text colors (defined once, used on both covers)
\definecolor{CoverCream}{RGB}{242,236,222}
\definecolor{CoverGoldBright}{RGB}{198,163,92}
\definecolor{CoverMuted}{RGB}{188,183,166}

%% ============================================
%% HYPERLINKS
%% ============================================
\usepackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=ChapterBlue,
  urlcolor=ScriptureGold,
  bookmarks=true,
  bookmarksnumbered=true
}

%% ============================================
%% TABLES - with proper width control
%% ============================================
\usepackage{longtable}
\usepackage{booktabs}
\usepackage{array}
\usepackage{tabularx}
\usepackage{calc}

% Set table width to text width - constrain tables
\setlength{\LTleft}{0pt}
\setlength{\LTright}{0pt}
\setlength{\LTpre}{6pt}
\setlength{\LTpost}{6pt}
\renewcommand{\arraystretch}{1.2}

% Pandoc 3.x table support
\usepackage{etoolbox}
\makeatletter
\patchcmd\longtable{\par}{\if@noskipsec\mbox{}\fi\par}{}{}
\@ifundefined{c@none}{\newcounter{none}}{}
\makeatother

% Style table rules
\renewcommand{\toprule}{\hline\hline}
\renewcommand{\midrule}{\hline}
\renewcommand{\bottomrule}{\hline\hline}

%% ============================================
%% HEADERS AND FOOTERS
%% ============================================
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE,RO]{\small\thepage}
\fancyhead[LO]{\small\itshape\color{LightGray}\nouppercase{\rightmark}}
\fancyhead[RE]{\small\itshape\color{LightGray}\nouppercase{\leftmark}}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{ScriptureGold}\leaders\hrule height \headrulewidth\hfill}}
\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyfoot[C]{\small\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

%% ============================================
%% SECTION STYLING (manual, without titlesec)
%% ============================================
\makeatletter
% Chapter styling
\def\@makechapterhead#1{%
  \vspace*{15pt}%
  {\parindent \z@ \raggedright \normalfont
    \ifnum \c@secnumdepth >\m@ne
      \large\bfseries\color{ChapterBlue} \@chapapp\space \thechapter
      \par\nobreak
      \vskip 8pt
    \fi
    \interlinepenalty\@M
    \LARGE \bfseries\color{ChapterBlue} #1\par\nobreak
    \vskip 10pt
    {\color{ScriptureGold}\hrule height 0.6pt}\vskip 1.5pt{\color{ScriptureGold}\hrule height 0.6pt}
    \vskip 15pt
  }}
\def\@makeschapterhead#1{%
  \vspace*{15pt}%
  {\parindent \z@ \raggedright
    \normalfont
    \interlinepenalty\@M
    \LARGE \bfseries\color{ChapterBlue} #1\par\nobreak
    \vskip 8pt
    {\color{ScriptureGold}\hrule height 0.6pt}\vskip 1.5pt{\color{ScriptureGold}\hrule height 0.6pt}
    \vskip 15pt
  }}

% Section styling
\renewcommand\section{\@startsection {section}{1}{\z@}%
  {-2.5ex \@plus -0.5ex \@minus -.2ex}%
  {1.5ex \@plus.2ex}%
  {\normalfont\large\bfseries\color{ChapterBlue}}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}%
  {-2ex\@plus -0.5ex \@minus -.2ex}%
  {1ex \@plus .2ex}%
  {\normalfont\normalsize\bfseries\color{CommentaryBrown}}}
\renewcommand\subsubsection{\@startsection{subsubsection}{3}{\z@}%
  {-1.5ex\@plus -0.5ex \@minus -.2ex}%
  {0.8ex \@plus .2ex}%
  {\normalfont\normalsize\bfseries\color{TextGray}}}
\makeatother

%% ============================================
%% BLOCKQUOTE STYLING - extra room for CJK text
%% ============================================
\renewenvironment{quote}{%
  \par\vspace{0.3\baselineskip}%
  \list{}{%
    \leftmargin=0.5em
    \rightmargin=0.2em
    \parsep=0pt
    \itemsep=0pt
  }%
  \item\relax
  \small\color{TextGray}%
}{%
  \endlist
  \par\vspace{0.3\baselineskip}%
}

%% ============================================
%% WIDOW/ORPHAN AND LINE BREAKING - aggressive for CJK
%% ============================================
\widowpenalty=10000
\clubpenalty=10000
\tolerance=9999
\emergencystretch=6em
\hyphenpenalty=50
\exhyphenpenalty=50
\sloppy
\hbadness=10000
\hfuzz=2pt

%% ============================================
%% \paul MACRO - speaker tag used in chapter Scripture sections
%% ============================================
\newcommand{\paul}[1]{\textbf{#1}}

