\vspace{0.25cm}

% Roman Road chain diagram — dots are pure visual markers; verse refs
% are placed as separate nodes below each dot (never on top of it), so
% label font size is independent of the dot's physical size.
\begin{tikzpicture}[scale=0.9,transform shape]
  \foreach \x/\ref in {0/1:16-17,2.8/3:23,5.6/3:24-25,8.4/5:8,11.2/6:23,14.0/10:9-10} {
    \fill[ScriptureGold] (\x,0) circle (0.22);
    \node[font=\footnotesize,color=TextGray,align=center] at (\x,-0.55) {\ref};
  }
  \draw[ScriptureGold,line width=1.2pt] (0.22,0) -- (2.58,0);
  \draw[ScriptureGold,line width=1.2pt] (3.02,0) -- (5.38,0);
  \draw[ScriptureGold,line width=1.2pt] (5.82,0) -- (8.18,0);
  \draw[ScriptureGold,line width=1.2pt] (8.62,0) -- (10.98,0);
  \draw[ScriptureGold,line width=1.2pt] (11.42,0) -- (13.78,0);
\end{tikzpicture}

