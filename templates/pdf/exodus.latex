% Seven-volume structure diagram (TikZ drawn) — the book's own progression
% from bondage in Egypt, through the plagues and the sea, to Sinai's covenant,
% the golden calf and its renewal, and finally the tabernacle where the LORD's
% glory comes to dwell.
% No picture-level `scale`: node sizes (minimum width/height) are NOT affected
% by TikZ's `scale` key unless `transform shape` is also given, while node
% POSITIONS always are — mixing the two without `transform shape` silently
% compresses the coordinate grid while the box borders stay full size, so
% boxes spaced correctly on paper collide and clip their own text with zero
% warning. Coordinates below are plain centimetres instead, sized directly.
\begin{tikzpicture}[every node/.style={align=center}]
  \node[font=\footnotesize\bfseries,color=ChapterCrimson] at (0,2.9) {全書七卷 Seven Volumes, 40 Chapters};

  \node[draw=ChapterCrimson,fill=ScriptureBg,rounded corners,minimum width=2.3cm,minimum height=0.7cm,font=\tiny] (v1) at (-3.825,2.2) {卷一 \textperiodcentered\ 蒙召的僕人};
  \node[font=\tiny,color=LightGray] at (-3.825,1.55) {1-6};

  \node[draw=ChapterCrimson,fill=ScriptureBg,rounded corners,minimum width=2.3cm,minimum height=0.7cm,font=\tiny] (v2) at (-1.275,2.2) {卷二 \textperiodcentered\ 十災逾越};
  \node[font=\tiny,color=LightGray] at (-1.275,1.55) {7-13};

  \node[draw=ChapterCrimson,fill=ScriptureBg,rounded corners,minimum width=2.3cm,minimum height=0.7cm,font=\tiny] (v3) at (1.275,2.2) {卷三 \textperiodcentered\ 過紅海};
  \node[font=\tiny,color=LightGray] at (1.275,1.55) {14-18};

  \node[draw=ChapterCrimson,fill=ScriptureBg,rounded corners,minimum width=2.3cm,minimum height=0.7cm,font=\tiny] (v4) at (3.825,2.2) {卷四 \textperiodcentered\ 西奈之約};
  \node[font=\tiny,color=LightGray] at (3.825,1.55) {19-24};

  \node[draw=SeaTeal,fill=ScriptureBg,rounded corners,minimum width=2.3cm,minimum height=0.7cm,font=\tiny] (v5) at (-2.55,0.5) {卷五 \textperiodcentered\ 會幕藍圖};
  \node[font=\tiny,color=LightGray] at (-2.55,-0.15) {25-31};

  \node[draw=SeaTeal,fill=ScriptureBg,rounded corners,minimum width=2.3cm,minimum height=0.7cm,font=\tiny] (v6) at (0,0.5) {卷六 \textperiodcentered\ 金牛犢};
  \node[font=\tiny,color=LightGray] at (0,-0.15) {32-34};

  \node[draw=GloryGold!70!black,fill=ScriptureBg,rounded corners,minimum width=2.3cm,minimum height=0.7cm,font=\tiny] (v7) at (2.55,0.5) {卷七 \textperiodcentered\ 榮耀充滿};
  \node[font=\tiny,color=LightGray] at (2.55,-0.15) {35-40};

