  \draw[SeaTeal, line width=1.0pt, opacity=0.85] (0,0.1) circle (1.15);
  % Inner zone — the blood on the doorposts (12:13)
  \fill[ChapterCrimson, opacity=0.22] (0,0.1) circle (0.55);
  \draw[ChapterCrimson, line width=1.0pt, opacity=0.9] (0,0.1) circle (0.55);
  \node[font=\tiny,color=ChapterCrimson] at (0,-0.65) {血門中};
  \node[font=\tiny,color=SeaTeal] at (0,-1.28) {紅海中};
  \node[font=\tiny,color=GloryGold!70!black]  at (0,-1.9) {榮耀中};
\end{tikzpicture}

