% ===== THREE CONCENTRIC ZONES: BLOOD ON THE DOOR / SEA ON DRY GROUND / GLORY FILLING THE TABERNACLE =====
\begin{tikzpicture}[scale=0.85, transform shape]
  % Outer zone — the glory that fills the tabernacle (40:34-35)
  \fill[GloryGold, opacity=0.16] (0,0.1) circle (1.65);
  \draw[GloryGold, line width=0.9pt, opacity=0.75] (0,0.1) circle (1.65);
