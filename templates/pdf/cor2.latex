% Timeline page (in place of a geographic map — 2 Corinthians is defined by
% its correspondence history more than by travel narrative)
\thispagestyle{empty}
\begin{center}
\vspace*{0.3cm}
{\Large\bfseries\color{ChapterBlue} 從前書到後書：書信年表}\\[0.1cm]
{\normalsize Timeline — From 1 Corinthians to 2 Corinthians}

\vspace{0.5cm}

\begin{tikzpicture}[scale=0.62]
  \draw[ChapterBlue,line width=2pt] (0,0) -- (12,0);

  \foreach \x/\lbl/\yr in {
    0.5/建立教會 (徒18:1-18)/AD 50-51,
    3/哥林多前書/AD 54-55,
    5.5/痛苦的造訪 (2:1)/AD 55,
    7.5/流淚的信 (2:4)/AD 55,
    9.5/提多帶回好消息 (7:6-7)/AD 55-56,
    11.5/哥林多後書/AD 55-56
  } {
    \fill[ScriptureGold] (\x,0) circle (0.13);
    \node[font=\tiny,rotate=40,anchor=west,color=ChapterBlue,align=left] at (\x,0.25) {\lbl};
    \node[font=\tiny,color=LightGray] at (\x,-0.35) {\yr};
  }

  \draw[->,ThornRed,line width=1.5pt,dashed] (3,-1.3) .. controls (5,-1.6) .. (7.5,-1.3);
  \node[font=\tiny,color=ThornRed] at (5.2,-1.9) {教會的衝突與悔改};
\end{tikzpicture}

\vspace{0.6cm}

\fcolorbox{ScriptureGold}{ScriptureBg}{%
\begin{minipage}{4.6in}
\small\color{CommentaryBrown}
\textbf{從中領受}：哥林多後書是保羅在提多帶回教會悔改的消息之後，從馬其頓寫下的一封信。它不是一套系統性的教導，而是一位牧者的心腸流露——他如何在患難中經歷神的安慰，又如何在軟弱中經歷神的大能。讀這卷書信，是在讀一位使徒最貼近生命的自傳。
\end{minipage}
}

\vspace{0.6cm}

{\small\color{TextGray}
\textbf{全書兩部 Two Parts:}\\
第一部：聖靈中的新約事奉 (1:1-7:16) — 保羅的見證\\
第二部：十字架能力的見證 (8:1-13:14) — 保羅的辯護\\[0.4em]
\textbf{本書獨有材料 Distinctive to 2 Corinthians:}\\
患難中的安慰 (1:3-11) · 瓦器中的寶貝 (4:7-12) · 和好的職分 (5:11-21)\\
永生神的殿 (6:14-7:1) · 恩典的奉獻 (8-9章) · 身上的一根刺 (12:7-10)
}
\end{center}
\cleardoublepage

