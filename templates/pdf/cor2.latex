    \fill[ThornRed]  ([xshift=0.50in,yshift=0.50in]current page.\cnr) circle (0.040in);
    \fill[ScriptureGold] ([xshift=0.50in,yshift=0.50in]current page.\cnr) circle (0.012in);
  }
\end{tikzpicture}

\begin{center}
\vspace*{0.42in}

{\footnotesize\scshape\color{ThornRed} Three Books Deep Reading \textbullet\ Second Corinthians}\\[0.08cm]
{\footnotesize\color{TextGray} 三書精讀 \textbullet\ 哥林多後書深度研讀}

\vspace{0.16cm}
\begin{tikzpicture}
  \draw[ScriptureGold, line width=0.8pt] (-2.6,0) -- (-0.5,0);
  \fill[ScriptureGold] (-0.35,0) circle (0.04);
  \fill[ScriptureGold] (0,0) circle (0.06);
  \fill[ScriptureGold] (0.35,0) circle (0.04);
  \draw[ScriptureGold, line width=0.8pt] (0.5,0) -- (2.6,0);
\end{tikzpicture}
\vspace{0.22cm}

{\fontsize{13}{15}\selectfont\itshape\color{TextGray} We have this treasure in jars of clay \textperiodcentered\ 我們有這寶貝放在瓦器裡}

\vspace{0.30cm}

% ===== CRACKED CLAY JAR WITH LIGHT BREAKING THROUGH (4:7) =====
\begin{tikzpicture}[scale=0.85, transform shape]
  % Halo — light breaking out of the jar (the treasure inside)
  \draw[ScriptureGold, line width=0.3pt, opacity=0.10] (0,0.35) circle (2.0);
  \draw[ScriptureGold, line width=0.3pt, opacity=0.16] (0,0.35) circle (1.65);
  \draw[ScriptureGold, line width=0.4pt, opacity=0.24] (0,0.35) circle (1.25);

  % Jar body (瓦器) — simple wide-bellied clay vessel
  \fill[CommentaryBrown!55] (-0.75,-0.95) .. controls (-0.95,-0.4) and (-0.9,0.55) .. (-0.6,1.0)
    -- (0.6,1.0) .. controls (0.9,0.55) and (0.95,-0.4) .. (0.75,-0.95)
    .. controls (0.5,-1.15) and (-0.5,-1.15) .. (-0.75,-0.95);

  % Jar neck and rim
  \fill[CommentaryBrown!65] (-0.32,1.0) rectangle (0.32,1.35);
  \draw[CommentaryBrown!85, line width=1.2pt] (-0.4,1.35) -- (0.4,1.35);

  % Crack lines — the vessel's weakness, through which the light escapes
  \draw[ScriptureGold, line width=1.4pt] (-0.15,0.85) -- (0.08,0.35) -- (-0.1,-0.15) -- (0.15,-0.75);
  \draw[ScriptureGold, line width=0.8pt, opacity=0.7] (0.3,0.55) -- (0.5,0.05);

  % Light rays escaping through the cracks
  \foreach \ang in {60,75,90,105,120} {
    \draw[ScriptureGold, line width=0.6pt, opacity=0.6] (0,0.35) -- (\ang:1.9);
  }
\end{tikzpicture}

\vspace{0.10cm}
\textcolor{ScriptureGold}{\rule{2.8in}{0.8pt}}
\vspace{0.24cm}

{\fontsize{34}{40}\selectfont\bfseries\color{ThornRed} 作祂的僕人}\\[0.10cm]
{\fontsize{16}{20}\selectfont\scshape\color{TextGray} Be His Servant}

\vspace{0.20cm}
{\fontsize{22}{26}\selectfont\bfseries 哥林多後書研讀：十字架事奉}\\[0.08cm]
{\fontsize{13}{16}\selectfont\itshape\color{TextGray} A Study of 2 Corinthians — Ministry of the Cross}

\vspace{0.24cm}
{\fontsize{15}{18}\selectfont\itshape\color{ThornRed} παράκλησις}\quad
{\footnotesize\scshape\color{TextGray} ``Comfort''}\quad
{\footnotesize\bfseries\color{JesusRed} 安慰}

\vfill

\fcolorbox{ScriptureGold}{white}{%
\begin{minipage}{4.3in}
\centering\vspace{0.15cm}
{\footnotesize\color{ThornRed}
「我的恩典夠你用的，因為我的能力是在人的軟弱上顯得完全。」}\\[0.10em]
{\scriptsize\itshape\color{TextGray}
``My grace is sufficient for you, for my power is made perfect in weakness.''}\\[0.10em]
{\scriptsize\color{ThornRed} 哥林多後書 12:9 \textperiodcentered\ 2 Corinthians 12:9}
