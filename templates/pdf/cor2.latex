\usepackage{xcolor}

% Primary colors (deep maroon for the cross/thorn, gold for grace/glory)
\definecolor{ChapterBlue}{RGB}{40,60,90}
\definecolor{ScriptureGold}{RGB}{175,135,45}
\definecolor{CommentaryBrown}{RGB}{95,70,55}
\definecolor{ThornRed}{RGB}{130,35,35}

% Box colors
\definecolor{ScriptureBg}{RGB}{252,250,245}
\definecolor{GreekBg}{RGB}{245,248,252}
\definecolor{ApplicationBg}{RGB}{248,252,248}

% Text colors
\definecolor{TextGray}{RGB}{50,50,50}
\definecolor{LightGray}{RGB}{120,120,120}
% Cover system learned from the Gospel of John series cover:
% midnight-blue field, warm gold rule, restrained light hierarchy.
\definecolor{CoverBg}{RGB}{8,26,42}
\definecolor{CoverText}{RGB}{245,242,232}
\definecolor{CoverMuted}{RGB}{178,190,199}
\definecolor{CoverAccent}{RGB}{205,163,68}

% Red Letter Bible (Jesus's words) - matches other PubHub Gospel templates
\definecolor{JesusRed}{RGB}{204,0,0}
\newcommand{\jesus}[1]{\textcolor{JesusRed}{#1}}

