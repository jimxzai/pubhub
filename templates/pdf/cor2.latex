\chapter*{Appendix D: Greek Word Glossary 希臘文原文詞彙表}
\addcontentsline{toc}{chapter}{Appendix D: Greek Word Glossary 希臘文原文詞彙表}
\markboth{Appendix D: Greek Word Glossary 希臘文原文詞彙表}{Appendix D: Greek Word Glossary 希臘文原文詞彙表}

\begin{small}
以下彙整全書二十四課中出現的希臘文關鍵詞，依段落分組。
\textit{Key Greek terms occurring across all twenty-four lessons, grouped by passage.}
\end{small}

\section*{患難與安慰 Affliction \& Comfort (1章)}

\begin{small}
\begin{tabular}{@{}p{2.9cm}p{2.6cm}p{1.6in}@{}}
\textbf{παράκλησις} \textit{(paraklēsis)} & 安慰、勸勉 & 1:3-7 \\
\textbf{θλῖψις} \textit{(thlipsis)} & 患難、壓力 & 1:4, 8 \\
\textbf{ἀπόκριμα} \textit{(apokrima)} & 判決、宣判 & 1:9 \\
\textbf{ἀρραβών} \textit{(arrabōn)} & 憑據、訂金 & 1:22; 5:5 \\
\textbf{ἁπλότης} \textit{(haplotēs)} & 坦率、單純、慷慨 & 1:12; 8:2; 9:11, 13; 11:3 \\
\end{tabular}
\end{small}

\section*{饒恕與馨香之氣 Forgiveness \& the Aroma of Christ (2章)}

\begin{small}
\begin{tabular}{@{}p{2.9cm}p{2.6cm}p{1.6in}@{}}
\textbf{λύπη} \textit{(lypē)} & 憂愁 & 2:1-7 \\
\textbf{χαρίζομαι} \textit{(charizomai)} & 赦免、施恩 & 2:7, 10 \\
\textbf{θριαμβεύω} \textit{(thriambeuō)} & 率領凱旋遊行 & 2:14 \\
\textbf{εὐωδία} \textit{(euōdia)} & 馨香之氣 & 2:15 \\
\textbf{καπηλεύω} \textit{(kapēleuō)} & 販賣、摻假圖利 & 2:17 \\
\end{tabular}
\end{small}

\section*{新約執事與榮上加榮 New Covenant Ministers, Glory to Glory (3章)}

\begin{small}
\begin{tabular}{@{}p{2.9cm}p{2.6cm}p{1.6in}@{}}
\textbf{ἐπιστολή} \textit{(epistolē)} & 信、書信 & 3:1-3 \\
\textbf{ἱκανότης} \textit{(hikanotēs)} & 充足、資格 & 3:5-6 \\
\textbf{δόξα} \textit{(doxa)} & 榮光、榮耀 & 3:7-18 \\
\textbf{κάλυμμα} \textit{(kalymma)} & 帕子、遮蓋物 & 3:13-16 \\
\textbf{καταργέω} \textit{(katargeō)} & 被廢去、歸於無效 & 3:7, 11, 13, 14 \\
\textbf{μεταμορφόω} \textit{(metamorphoō)} & 改變形狀 & 3:18 \\
\end{tabular}
\end{small}

\section*{光照人心與瓦器 The Light of the Gospel, Jars of Clay (4章)}

\begin{small}
\begin{tabular}{@{}p{2.9cm}p{2.6cm}p{1.6in}@{}}
\textbf{ἐγκακέω} \textit{(enkakeō)} & 喪膽、灰心 & 4:1, 16 \\
\textbf{εἰκών} \textit{(eikōn)} & 像、形像 & 4:4 \\
\textbf{σκεῦος ὀστράκινον} \textit{(skeuos ostrakinon)} & 瓦器、陶器 & 4:7 \\
\textbf{ὑπερβολή} \textit{(hyperbolē)} & 極度、超乎尋常 & 4:7, 17 \\
\textbf{νέκρωσις} \textit{(nekrōsis)} & 置於死地的狀態 & 4:10 \\
\textbf{ἀνακαινόω} \textit{(anakainoō)} & 更新 & 4:16 \\
\textbf{βάρος δόξης} \textit{(baros doxēs)} & 榮耀的重量 & 4:17 \\
\end{tabular}
\end{small}

\section*{天家盼望與和好使命 Our Heavenly Dwelling, Reconciliation (5章)}

\begin{small}
\begin{tabular}{@{}p{2.9cm}p{2.6cm}p{1.6in}@{}}
\textbf{σκῆνος} \textit{(skēnos)} & 帳棚、帳幕 & 5:1, 4 \\
\textbf{βῆμα} \textit{(bēma)} & 審判臺 & 5:10 \\
\textbf{συνέχω} \textit{(synechō)} & 激勵、催逼 & 5:14 \\
\textbf{καινὴ κτίσις} \textit{(kainē ktisis)} & 新造 & 5:17 \\
\textbf{καταλλαγή} \textit{(katallagē)} & 和好 & 5:18-19 \\
\textbf{πρεσβεύω} \textit{(presbeuō)} & 作使者、代表 & 5:20 \\
\end{tabular}
\end{small}

\section*{分別為聖與敞開心門 Set Apart, Open Hearts (6-7章)}

\begin{small}
\begin{tabular}{@{}p{2.9cm}p{2.6cm}p{1.6in}@{}}
\textbf{δεκτὸς καιρός} \textit{(dektos kairos)} & 悅納的時候 & 6:2 \\
\textbf{ἑτεροζυγέω} \textit{(heterozygeō)} & 同負不同的軛 & 6:14 \\
\textbf{ναὸς θεοῦ ζῶντος} \textit{(naos theou zōntos)} & 永生神的殿 & 6:16 \\
\textbf{ἁγιωσύνη} \textit{(hagiōsynē)} & 聖潔 & 7:1 \\
\textbf{μετάνοια} \textit{(metanoia)} & 悔改 & 7:9-10 \\
\textbf{ἀμεταμέλητος} \textit{(ametamelētos)} & 無後悔的 & 7:10 \\
\end{tabular}
\end{small}

\section*{恩典的奉獻 The Grace of Giving (8-9章)}

\begin{small}
\begin{tabular}{@{}p{2.9cm}p{2.6cm}p{1.6in}@{}}
\textbf{χάρις} \textit{(charis)} & 恩典、捐貲 & 8:1-9; 9:14-15 \\
\textbf{αὐθαίρετος} \textit{(authairetos)} & 甘心樂意、自發的 & 8:3 \\
\textbf{ἐπτώχευσεν} \textit{(eptōcheusen)} & 使自己成為貧窮 & 8:9 \\
\textbf{ἰσότης} \textit{(isotēs)} & 均平、公平 & 8:13-14 \\
\textbf{ἱλαρός} \textit{(hilaros)} & 歡喜的、樂意的 & 9:7 \\
\textbf{αὐτάρκεια} \textit{(autarkeia)} & 自足、凡事都夠用 & 9:8 \\
\end{tabular}
\end{small}

\section*{屬靈爭戰與真實權柄 Spiritual Warfare, True Authority (10章)}

\begin{small}
\begin{tabular}{@{}p{2.9cm}p{2.6cm}p{1.6in}@{}}
\textbf{ὀχύρωμα} \textit{(ochyrōma)} & 堅固的營壘 & 10:4 \\
\textbf{αἰχμαλωτίζω} \textit{(aichmalōtizō)} & 擄掠、奪回 & 10:5 \\
\textbf{ἐξουσία} \textit{(exousia)} & 權柄 & 10:8 \\
\textbf{οἰκοδομή} \textit{(oikodomē)} & 建造、造就 & 10:8 \\
\textbf{κανών} \textit{(kanōn)} & 準則、量尺 & 10:13, 15, 16 \\
\end{tabular}
\end{small}

\section*{純正福音與軟弱誇口 The Pure Gospel, Boasting in Weakness (11章)}

\begin{small}
\begin{tabular}{@{}p{2.9cm}p{2.6cm}p{1.6in}@{}}
\textbf{παρθένος} \textit{(parthenos)} & 童女、貞潔的女子 & 11:2 \\
\textbf{ψευδαπόστολοι} \textit{(pseudapostoloi)} & 假使徒 & 11:13 \\
\textbf{μετασχηματίζω} \textit{(metaschēmatizō)} & 變換外形、偽裝 & 11:13-15 \\
\textbf{κόποις} \textit{(kopois)} & 勞苦 & 11:23 \\
\textbf{κινδύνοις} \textit{(kindynois)} & 危險 & 11:26 \\
\textbf{ἀσθενείᾳ} \textit{(astheneia)} & 軟弱 & 11:29-30; 12:9-10 \\
\end{tabular}
\end{small}

\section*{刺與恩典、權柄與愛 The Thorn and Grace, Authority and Love (12-13章)}

\begin{small}
\begin{tabular}{@{}p{2.9cm}p{2.6cm}p{1.6in}@{}}
\textbf{σκόλοψ τῇ σαρκί} \textit{(skolops tē sarki)} & 肉體上的一根刺 & 12:7 \\
\textbf{ἀρκεῖ} \textit{(arkei)} & 夠用、足夠 & 12:9 \\
\textbf{σημεῖα τοῦ ἀποστόλου} \textit{(sēmeia tou apostolou)} & 使徒的憑據 & 12:12 \\
\textbf{σταυρωθεὶς ἐξ ἀσθενείας} \textit{(staurōtheis ex astheneias)} & 因軟弱被釘十字架 & 13:4 \\
\textbf{δοκιμάζετε} \textit{(dokimazete)} & 試驗、察驗 & 13:5 \\
\textbf{κοινωνία} \textit{(koinōnia)} & 團契、相交 & 13:14 \\
\end{tabular}
\end{small}

