% PubHub 1 Timothy Template
% Professional Bible Study Book Layout
% Bilingual Chinese/English with Greek word studies
% Requires XeLaTeX for CJK support
% Theme: "教會與傳道人" (The Church and the Minister) — Teal/Gold Pillar Theme

\documentclass[11pt,openany]{book}

%% ============================================
%% FONT SETUP WITH CJK LINE BREAKING
%% ============================================
\usepackage{fontspec}

\setmainfont{Songti SC}[
  BoldFont=Songti SC Bold,
  ItalicFont=Kaiti SC
]
\setsansfont{PingFang SC}
% Menlo has no CJK glyphs and fontspec's FallbackFont does not reach LaTeX's
% kernel \verbatim environment (catcode changes bypass ucharclasses' script
% switching), so ASCII-art diagrams mixing Chinese with box-drawing characters
% render as tofu. Use a CJK-capable font for monospace content instead.
\setmonofont{Songti SC}

%% Greek and Hebrew font support - auto-switch for Unicode blocks
\usepackage{ucharclasses}
\newfontfamily\greekfont{Times New Roman}[Script=Greek]
\newfontfamily\hebrewfont{Arial Hebrew}[Script=Hebrew]
\setTransitionsFor{Greek}{\greekfont}{\normalfont}
\setTransitionsFor{GreekExtended}{\greekfont}{\normalfont}
\setTransitionsFor{Hebrew}{\hebrewfont}{\normalfont}

%% Classical English display faces — used for title-page/cover typography only,
%% never for CJK body text (which stays on Songti SC/Kaiti SC above).
\newfontfamily\baskerville{Baskerville}
\newfontfamily\didotdisplay{Didot}

%% Enable CJK line breaking - critical for Chinese text
\XeTeXlinebreaklocale "zh"
\XeTeXlinebreakskip = 0pt plus 1pt minus 0.1pt

%% ============================================
%% PAGE GEOMETRY
%% ============================================
\usepackage{geometry}
\geometry{
  paperwidth=7in,
  paperheight=10in,
  top=0.75in,
  bottom=0.75in,
  inner=0.8in,
  outer=0.65in,
  marginparwidth=0in,
  marginparsep=0in
}

%% ============================================
%% LINE AND PARAGRAPH SPACING
%% ============================================
\linespread{1.1}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.3em}

%% ============================================
%% COLOR SCHEME — Church & Minister Theme (Teal/Gold)
%% ============================================
\usepackage{xcolor}

% Primary colors — Pillar theme, retuned toward an antique/manuscript register
\definecolor{ChapterTeal}{RGB}{35,70,68}         % Antique verdigris teal for chapters
\definecolor{ScriptureGold}{RGB}{146,111,52}     % Aged brass gold for scripture refs
\definecolor{CommentaryBrown}{RGB}{90,62,40}     % Warm brown for commentary

% Box colors
\definecolor{ScriptureBg}{RGB}{251,249,243}      % Parchment cream for scripture boxes
\definecolor{GreekBg}{RGB}{240,246,245}          % Muted teal wash for Greek
\definecolor{ApplicationBg}{RGB}{246,248,244}    % Muted sage for application

% Text colors
\definecolor{TextGray}{RGB}{50,50,50}
\definecolor{LightGray}{RGB}{120,120,120}

% Diagram colors — same antique register
\definecolor{ChurchTruthBlue}{RGB}{55,80,110}    % Part I: 教會真理
\definecolor{MinisterGreen}{RGB}{75,105,72}      % Part II: 傳道人

%% ============================================
%% MATH AND SYMBOLS
%% ============================================
\usepackage{amssymb}
\usepackage{amsmath}

%% ============================================
%% GRAPHICS AND TIKZ FOR DIAGRAMS
%% ============================================
\usepackage{graphicx}
\usepackage{tikz}
\usetikzlibrary{shapes,arrows,positioning,fit,backgrounds,calc,decorations.pathmorphing}
\usepackage{pgfornament}

%% ============================================
%% TIKZ COMMANDS FOR DECORATIONS
%% ============================================

% Pillar symbol (柱石) — kept for the diagram page
\newcommand{\pillarsymbol}{%
\begin{tikzpicture}[scale=0.2]
  \draw[color=ScriptureGold,line width=1.2pt] (-0.5,-1) -- (0.5,-1);
  \draw[color=ScriptureGold,line width=1.2pt] (-0.35,-1) -- (-0.35,1);
  \draw[color=ScriptureGold,line width=1.2pt] (0.35,-1) -- (0.35,1);
  \draw[color=ScriptureGold,line width=1.2pt] (-0.5,1) -- (0.5,1);
\end{tikzpicture}%
}

% Classical fleuron divider — replaces the old crosssymbol+rule combination
\newcommand{\fleuron}[1][1cm]{\pgfornament[width=#1,color=ScriptureGold]{75}}
\newcommand{\fleurondivider}{%
  \fleuron[0.9cm]\hspace{0.4cm}{\color{ScriptureGold!70}\rule{1.6in}{0.5pt}}\hspace{0.4cm}\fleuron[0.9cm]%
}

% Speaker tag for Paul's direct words in Scripture blocks (mirrors \jesus{} convention)
\newcommand{\paul}[1]{\textcolor{ChapterTeal}{#1}}

%% ============================================
%% FULL-BLEED COVER MACHINERY (front/back cover only)
%% ============================================
\usepackage{eso-pic}

% Full-bleed dark background, painted in the shipout background hook so
% it bleeds to the true physical page edge and does not disturb the
% \geometry text-block margins used by every other page.
\newcommand{\CoverBackground}{%
  \AddToShipoutPictureBG*{%
    \AtPageLowerLeft{\color{ChapterTeal}\rule{\paperwidth}{\paperheight}}%
  }%
}

% Classical book-plate border: two inset hairlines plus a small corner
% ornament at each corner, painted in the foreground hook.
\newcommand{\CoverBorder}{%
  \AddToShipoutPictureFG*{%
    \begin{tikzpicture}[remember picture,overlay]
      \draw[color=ScriptureGold,line width=0.5pt]
        ($$(current page.south west)+(0.45in,0.45in)$$) rectangle ($$(current page.north east)-(0.45in,0.45in)$$);
      \draw[color=ScriptureGold,line width=0.4pt]
        ($$(current page.south west)+(0.52in,0.52in)$$) rectangle ($$(current page.north east)-(0.52in,0.52in)$$);
      \node[color=ScriptureGold] at ($$(current page.south west)+(0.55in,0.55in)$$) {\pgfornament[width=0.45cm,color=ScriptureGold]{75}};
      \node[color=ScriptureGold,rotate=90] at ($$(current page.north west)+(0.55in,-0.55in)$$) {\pgfornament[width=0.45cm,color=ScriptureGold]{75}};
      \node[color=ScriptureGold,rotate=-90] at ($$(current page.south east)+(-0.55in,0.55in)$$) {\pgfornament[width=0.45cm,color=ScriptureGold]{75}};
      \node[color=ScriptureGold,rotate=180] at ($$(current page.north east)+(-0.55in,-0.55in)$$) {\pgfornament[width=0.45cm,color=ScriptureGold]{75}};
    \end{tikzpicture}%
  }%
}

% A small consistent publisher's device, reused on the half-title page,
% the front cover, and the closing colophon page.
\newcommand{\publishersmark}[1][ScriptureGold]{%
  \pgfornament[width=0.4cm,color=#1]{75}%
}

% Dark-background variants of \fleuron/\fleurondivider, for cover use only —
% the plain \fleuron/\fleurondivider stay untouched for interior (white) pages.
\newcommand{\fleurondark}[1][1cm]{\pgfornament[width=#1,color=CoverGoldBright]{75}}
\newcommand{\fleurondividerdark}{%
  \fleurondark[0.9cm]\hspace{0.4cm}{\color{CoverGoldBright!70}\rule{1.6in}{0.5pt}}\hspace{0.4cm}\fleurondark[0.9cm]%
}

% Light-on-dark cover text colors (distinct tones from the combined
% "盡職" volume's green-family cover, scaled to this book's teal/brass)
\definecolor{CoverCream}{RGB}{240,238,225}
\definecolor{CoverGoldBright}{RGB}{190,158,90}
\definecolor{CoverMuted}{RGB}{180,190,186}

%% ============================================
%% HYPERLINKS
%% ============================================
\usepackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=ChapterTeal,
  urlcolor=ScriptureGold,
  bookmarks=true,
  bookmarksnumbered=true
}

%% ============================================
%% TABLES
%% ============================================
\usepackage{longtable}
\usepackage{booktabs}
\usepackage{array}
\usepackage{tabularx}
\usepackage{calc}

\setlength{\LTleft}{0pt}
\setlength{\LTright}{0pt}
\setlength{\LTpre}{6pt}
\setlength{\LTpost}{6pt}
\renewcommand{\arraystretch}{1.2}

\usepackage{etoolbox}
\makeatletter
\patchcmd\longtable{\par}{\if@noskipsec\mbox{}\fi\par}{}{}
\@ifundefined{c@none}{\newcounter{none}}{}
\makeatother

\renewcommand{\toprule}{\hline\hline}
\renewcommand{\midrule}{\hline}
\renewcommand{\bottomrule}{\hline\hline}

%% ============================================
%% HEADERS AND FOOTERS
%% ============================================
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE,RO]{\small\thepage}
\fancyhead[LO]{\small\itshape\color{LightGray}\nouppercase{\rightmark}}
\fancyhead[RE]{\small\itshape\color{LightGray}\nouppercase{\leftmark}}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{ScriptureGold}\leaders\hrule height \headrulewidth\hfill}}
\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyfoot[C]{\small\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

%% ============================================
%% SECTION STYLING
%% ============================================
\makeatletter
\def\@makechapterhead#1{%
  \vspace*{15pt}%
  {\parindent \z@ \raggedright \normalfont
    \ifnum \c@secnumdepth >\m@ne
      \large\bfseries\color{ChapterTeal} \@chapapp\space \thechapter
      \par\nobreak
      \vskip 8pt
    \fi
    \interlinepenalty\@M
    \LARGE \bfseries\color{ChapterTeal} #1\par\nobreak
    \vskip 12pt
    {\color{ScriptureGold}\hrule height 1.5pt}
    \vskip 15pt
  }}
\def\@makeschapterhead#1{%
  \vspace*{15pt}%
  {\parindent \z@ \raggedright
    \normalfont
    \interlinepenalty\@M
    \LARGE \bfseries\color{ChapterTeal} #1\par\nobreak
    \vskip 8pt
    {\color{ScriptureGold}\hrule height 1.5pt}
    \vskip 15pt
  }}

\renewcommand\section{\@startsection {section}{1}{\z@}%
  {-2.5ex \@plus -0.5ex \@minus -.2ex}%
  {1.5ex \@plus.2ex}%
  {\normalfont\large\bfseries\color{ChapterTeal}}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}%
  {-2ex\@plus -0.5ex \@minus -.2ex}%
  {1ex \@plus .2ex}%
  {\normalfont\normalsize\bfseries\color{CommentaryBrown}}}
\renewcommand\subsubsection{\@startsection{subsubsection}{3}{\z@}%
  {-1.5ex\@plus -0.5ex \@minus -.2ex}%
  {0.8ex \@plus .2ex}%
  {\normalfont\normalsize\bfseries\color{TextGray}}}
\makeatother

%% ============================================
%% BLOCKQUOTE STYLING
%% ============================================
\renewenvironment{quote}{%
  \par\vspace{0.3\baselineskip}%
  \list{}{%
    \leftmargin=0.5em
    \rightmargin=0.2em
    \parsep=0pt
    \itemsep=0pt
  }%
  \item\relax
  \small\color{TextGray}%
}{%
  \endlist
  \par\vspace{0.3\baselineskip}%
}

%% ============================================
%% WIDOW/ORPHAN AND LINE BREAKING
%% ============================================
\widowpenalty=10000
\clubpenalty=10000
\tolerance=9999
\emergencystretch=6em
\hyphenpenalty=50
\exhyphenpenalty=50
\sloppy
\hbadness=10000
\hfuzz=2pt

