% PubHub Acts of the Apostles Template
% Professional Bible Study Book Layout
% Bilingual Chinese/English with Greek word studies
% Requires XeLaTeX for CJK support
% Series identity: Flame/Ember palette (Pentecost fire, 1:8 expanding witness)

\documentclass[11pt,openany]{book}

%% ============================================
%% FONT SETUP WITH CJK LINE BREAKING
%% ============================================
\usepackage{fontspec}

\setmainfont{Songti SC}[
  BoldFont=Songti SC,
  BoldFeatures={FakeBold=2.2},
  ItalicFont=Kaiti SC
]
\setsansfont{PingFang SC}
% Menlo has zero CJK glyphs: every CJK char in a code block
% rendered as a blank box. Songti SC is CJK-safe.
\setmonofont{Songti SC}

%% Greek and Hebrew font support - auto-switch for Unicode blocks
\usepackage{ucharclasses}
\newfontfamily\greekfont{Times New Roman}[Script=Greek]
\newfontfamily\hebrewfont{Times New Roman}[Script=Hebrew]
%% ucharclasses — full block coverage via \setTransitionTo.
%%
%% Two traps this replaces (see .claude/skills/eat-bible/references/gotchas.md):
%%  1. \setTransitionsFor{Greek} is a no-op — "Greek" is a class GROUP; the
%%     block is GreekAndCoptic. Basic Greek silently used the main font.
%%  2. \setTransitionsFor sets BOTH directions for every pair, so a later
%%     declaration's out-code overwrites an earlier one's in-code. Symptom:
%%     a Greek/Hebrew run preceded by CJK or full-width punctuation (：、。）
%%     does not switch font — silently, since the main font carries basic
%%     Greek glyphs.
%%
%% \setTransitionTo sets the ENTERING direction only, so nothing can clobber
%% anything. It removes the leaving-code, which is why every block this book
%% uses must be listed: an unlisted block inherits the previous font.
%% Block list derived from a census of this book's own markdown sources.
%%
%% \latinrun keeps the main font's own Latin glyphs — upright text is
%% unchanged — but adds a real italic, which \setmainfont cannot supply
%% because its ItalicFont is Kaiti SC, a brush face whose Latin glyphs are
%% UPRIGHT. Without this every italicised work title renders as roman.
%% \uckeep carries series/shape across the boundary; a bare \newfontfamily
%% switch resets both and drops \emph / \textbf mid-run.
\newfontfamily\latinrun{Songti SC}[
  ItalicFont={Times New Roman Italic},
  BoldFont=Songti SC, BoldFeatures={FakeBold=2.2},
  BoldItalicFont={Times New Roman Bold Italic}
]
\newfontfamily\cjkrun{Songti SC}[
  BoldFont=Songti SC, BoldFeatures={FakeBold=2.2},
  ItalicFont=Kaiti SC
]
\makeatletter
\newcommand{\uckeep}[1]{%
  \edef\uc@sh{\f@shape}\edef\uc@se{\f@series}%
  #1\fontshape{\uc@sh}\fontseries{\uc@se}\selectfont}
\makeatother
\newcommand{\ucLatinRun}{\uckeep{\latinrun}}
\newcommand{\ucCJKRun}{\uckeep{\cjkrun}}
\newcommand{\ucGreekRun}{\uckeep{\greekfont}}
\newcommand{\ucHebrewRun}{\uckeep{\hebrewfont}}
\setTransitionTo{BasicLatin}{\ucLatinRun}
\setTransitionTo{LatinSupplement}{\ucLatinRun}
\setTransitionTo{LatinExtendedA}{\ucLatinRun}
\setTransitionTo{LatinExtendedAdditional}{\ucLatinRun}
\setTransitionTo{GreekAndCoptic}{\ucGreekRun}
\setTransitionTo{GreekExtended}{\ucGreekRun}
\setTransitionTo{Hebrew}{\ucHebrewRun}
\setTransitionTo{CJKUnifiedIdeographs}{\ucCJKRun}
\setTransitionTo{CJKUnifiedIdeographsExtensionA}{\ucCJKRun}
\setTransitionTo{CJKSymbolsAndPunctuation}{\ucCJKRun}
\setTransitionTo{HalfwidthAndFullwidthForms}{\ucCJKRun}
\setTransitionTo{GeneralPunctuation}{\ucCJKRun}
\setTransitionTo{BoxDrawing}{\ucCJKRun}
\setTransitionTo{Arrows}{\ucCJKRun}
\setTransitionTo{MathematicalOperators}{\ucCJKRun}
\setTransitionTo{GeometricShapes}{\ucCJKRun}
\setTransitionTo{MiscellaneousSymbols}{\ucCJKRun}
\setTransitionTo{SuperscriptsAndSubscripts}{\ucCJKRun}
\setTransitionTo{Dingbats}{\ucCJKRun}
\setTransitionTo{MiscellaneousSymbolsAndArrows}{\ucCJKRun}
\setTransitionTo{LetterlikeSymbols}{\ucCJKRun}
\setTransitionTo{EnclosedAlphanumerics}{\ucCJKRun}
\setTransitionTo{BlockElements}{\ucCJKRun}
\setTransitionTo{MiscellaneousTechnical}{\ucCJKRun}
\setTransitionTo{Hiragana}{\ucCJKRun}
\setTransitionTo{Katakana}{\ucCJKRun}
\setTransitionTo{CJKCompatibilityForms}{\ucCJKRun}
\setTransitionTo{SmallFormVariants}{\ucCJKRun}
\setTransitionTo{VerticalForms}{\ucCJKRun}
\setTransitionTo{MiscellaneousSymbolsAndPictographs}{\ucCJKRun}
\setTransitionTo{Emoticons}{\ucCJKRun}
\setTransitionTo{CombiningDiacriticalMarks}{\ucCJKRun}
\setTransitionTo{SpacingModifierLetters}{\ucCJKRun}
\setTransitionTo{IPAExtensions}{\ucCJKRun}
\setTransitionTo{NumberForms}{\ucCJKRun}
\setTransitionTo{CurrencySymbols}{\ucCJKRun}
\newfontfamily\kaiti{Kaiti SC}

%% Enable CJK line breaking - critical for Chinese text
\XeTeXlinebreaklocale "zh"
\XeTeXlinebreakskip = 0pt plus 1pt minus 0.1pt

%% ============================================
%% PAGE GEOMETRY - Fixed margins (more conservative)
%% ============================================
\usepackage{geometry}
\geometry{
  paperwidth=7in,
  paperheight=10in,
  top=0.75in,
  bottom=0.75in,
  inner=0.8in,
  outer=0.65in,
  marginparwidth=0in,
  marginparsep=0in
}

%% ============================================
%% LINE AND PARAGRAPH SPACING
%% ============================================
\linespread{1.1}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.3em}

%% ============================================
%% COLOR SCHEME - Acts identity: flame/ember (Pentecost fire, spreading witness)
%% ============================================
\usepackage{xcolor}

% Primary colors
\definecolor{ChapterFlame}{RGB}{165,55,25}      % Deep ember red-orange for chapters
\definecolor{ScriptureGold}{RGB}{165,125,55}    % Gold for scripture refs (series-shared)
\definecolor{CommentaryBrown}{RGB}{85,60,45}    % Warm brown for commentary

% Map colors
\definecolor{WaterBlue}{RGB}{180,210,230}       % Sea/river blue
\definecolor{LandBeige}{RGB}{245,235,220}       % Land color
\definecolor{MountainBrown}{RGB}{180,160,140}   % Mountain shading

% Box colors
\definecolor{ScriptureBg}{RGB}{252,250,245}     % Cream for scripture boxes
\definecolor{GreekBg}{RGB}{253,247,240}         % Warm cream for Greek
\definecolor{ApplicationBg}{RGB}{248,252,248}   % Light green for application

% Text colors
\definecolor{TextGray}{RGB}{50,50,50}
\definecolor{LightGray}{RGB}{120,120,120}

% Fire accent — the tongues of Pentecost
\definecolor{SpiritFlame}{RGB}{225,130,35}

% Red letter Bible - the ascended/risen Christ's own words (rare but present in Acts:
% 1:7-8; 9:4-6/22:7-10/26:14-18 Damascus road; 18:9-10; 23:11), matching series convention
\definecolor{JesusRed}{RGB}{204,0,0}
\newcommand{\jesus}[1]{\textcolor{JesusRed}{#1}}

%% ============================================
%% MATH AND SYMBOLS
%% ============================================
\usepackage{amssymb}
\usepackage{amsmath}

%% ============================================
%% GRAPHICS AND TIKZ FOR DIAGRAMS
%% ============================================
\usepackage{graphicx}
\usepackage{tikz}
\usetikzlibrary{shapes,arrows,arrows.meta,positioning,fit,backgrounds,calc,decorations.pathmorphing}

%% ============================================
%% TIKZ COMMANDS FOR DECORATIONS
%% ============================================

% Vine decoration command
\newcommand{\vinedecor}[1]{%
\begin{tikzpicture}[scale=0.6]
  \draw[color=ScriptureGold,line width=0.8pt,decorate,decoration={snake,amplitude=1pt,segment length=8pt}]
    (0,0) -- (#1,0);
  \foreach \x in {0.3,0.8,1.3,1.8,2.3} {
    \draw[color=ScriptureGold,line width=0.5pt] (\x,0) .. controls (\x+0.1,0.15) and (\x+0.2,0.15) .. (\x+0.25,0.05);
  }
\end{tikzpicture}%
}

% Cross decoration
\newcommand{\crosssymbol}{%
\begin{tikzpicture}[scale=0.15]
  \draw[color=ScriptureGold,line width=1.5pt] (0,-1) -- (0,1);
  \draw[color=ScriptureGold,line width=1.5pt] (-0.6,0.4) -- (0.6,0.4);
\end{tikzpicture}%
}

%% ============================================
%% HYPERLINKS
%% ============================================
\usepackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=ChapterFlame,
  urlcolor=ScriptureGold,
  bookmarks=true,
  bookmarksnumbered=true
}

%% ============================================
%% TABLES - with proper width control
%% ============================================
\usepackage{longtable}
\usepackage{booktabs}
\usepackage{array}
\usepackage{tabularx}
\usepackage{calc}

% Set table width to text width - constrain tables
\setlength{\LTleft}{0pt}
\setlength{\LTright}{0pt}
\setlength{\LTpre}{6pt}
\setlength{\LTpost}{6pt}
\renewcommand{\arraystretch}{1.2}

% Pandoc 3.x table support
\usepackage{etoolbox}
\makeatletter
\patchcmd\longtable{\par}{\if@noskipsec\mbox{}\fi\par}{}{}
\@ifundefined{c@none}{\newcounter{none}}{}
\makeatother

% Style table rules
\renewcommand{\toprule}{\hline\hline}
\renewcommand{\midrule}{\hline}
\renewcommand{\bottomrule}{\hline\hline}

%% ============================================
%% HEADERS AND FOOTERS
%% ============================================
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE,RO]{\small\thepage}
\fancyhead[LO]{\small\itshape\color{LightGray}\nouppercase{\rightmark}}
\fancyhead[RE]{\small\itshape\color{LightGray}\nouppercase{\leftmark}}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{ScriptureGold}\leaders\hrule height \headrulewidth\hfill}}
\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyfoot[C]{\small\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

%% ============================================
%% SECTION STYLING (manual, without titlesec)
%% ============================================
\makeatletter
% Chapter styling
\def\@makechapterhead#1{%
  \vspace*{15pt}%
  {\parindent \z@ \raggedright \normalfont
    \ifnum \c@secnumdepth >\m@ne
      \large\bfseries\color{ChapterFlame} \@chapapp\space \thechapter
      \par\nobreak
      \vskip 8pt
    \fi
    \interlinepenalty\@M
    \LARGE \bfseries\color{ChapterFlame} #1\par\nobreak
    \vskip 12pt
    {\color{ScriptureGold}\hrule height 1.5pt}
    \vskip 15pt
  }}
\def\@makeschapterhead#1{%
  \vspace*{15pt}%
  {\parindent \z@ \raggedright
    \normalfont
    \interlinepenalty\@M
    \LARGE \bfseries\color{ChapterFlame} #1\par\nobreak
    \vskip 8pt
    {\color{ScriptureGold}\hrule height 1.5pt}
    \vskip 15pt
  }}

% Section styling
\renewcommand\section{\@startsection {section}{1}{\z@}%
  {-2.5ex \@plus -0.5ex \@minus -.2ex}%
  {1.5ex \@plus.2ex}%
  {\normalfont\large\bfseries\color{ChapterFlame}}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}%
  {-2ex\@plus -0.5ex \@minus -.2ex}%
  {1ex \@plus .2ex}%
  {\normalfont\normalsize\bfseries\color{CommentaryBrown}}}
\renewcommand\subsubsection{\@startsection{subsubsection}{3}{\z@}%
  {-1.5ex\@plus -0.5ex \@minus -.2ex}%
  {0.8ex \@plus .2ex}%
  {\normalfont\normalsize\bfseries\color{TextGray}}}
\makeatother

%% ============================================
%% BLOCKQUOTE STYLING - extra room for CJK text
%% ============================================
\renewenvironment{quote}{%
  \par\vspace{0.3\baselineskip}%
  \list{}{%
    \leftmargin=0.5em
    \rightmargin=0.2em
    \parsep=0pt
    \itemsep=0pt
  }%
  \item\relax
  \small\color{TextGray}%
}{%
  \endlist
  \par\vspace{0.3\baselineskip}%
}

%% ============================================
%% WIDOW/ORPHAN AND LINE BREAKING - aggressive for CJK
%% ============================================
\widowpenalty=10000
\clubpenalty=10000
\tolerance=9999
\emergencystretch=6em
\hyphenpenalty=50
\exhyphenpenalty=50
\sloppy
\hbadness=10000
\hfuzz=2pt

%% ============================================
%% METADATA
%% ============================================
$if(title)$
\title{$title$}
$endif$
$if(author)$
\author{$author$}
$endif$
$if(date)$
\date{$date$}
$else$
\date{\today}
$endif$

