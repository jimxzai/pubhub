% ===== TONGUES OF FIRE OVER THREE EXPANDING RINGS (1:8) =====
\begin{tikzpicture}[scale=0.85, transform shape]
  % Three expanding rings — Jerusalem / Judea-Samaria / ends of the earth
  \draw[ChapterFlame, line width=1.0pt, opacity=0.85] (0,0.1) circle (0.55);
  \draw[ScriptureGold, line width=0.8pt, opacity=0.65] (0,0.1) circle (1.15);
  \draw[SpiritFlame, line width=0.6pt, opacity=0.45] (0,0.1) circle (1.75);
  \node[font=\tiny,color=ChapterFlame] at (0,-0.65) {耶路撒冷};
  \node[font=\tiny,color=ScriptureGold] at (0,-1.28) {猶太．撒瑪利亞};
  \node[font=\tiny,color=SpiritFlame]  at (0,-1.9) {直到地極};

  % Twelve small tongues of fire resting above (Acts 2:3)
  \foreach \ang in {0,30,...,330} {
    \fill[SpiritFlame, opacity=0.85]
      ({1.75*cos(\ang)+0*0.1}, {0.1+1.75*sin(\ang)})
      .. controls ({1.75*cos(\ang)+0.12},{0.1+1.75*sin(\ang)+0.30})
      and ({1.75*cos(\ang)-0.08},{0.1+1.75*sin(\ang)+0.50})
      .. ({1.75*cos(\ang)},{0.1+1.75*sin(\ang)+0.62})
      .. controls ({1.75*cos(\ang)-0.10},{0.1+1.75*sin(\ang)+0.40})
      and ({1.75*cos(\ang)-0.10},{0.1+1.75*sin(\ang)+0.15})
      .. cycle;
  }

  % central flame — larger, over the center
  \fill[JesusRed, opacity=0.9] (0,0.1)
    .. controls (0.28,0.5) and (0.20,0.85) .. (0.08,1.15)
    .. controls (0.28,0.95) and (0.32,1.35) .. (0,1.65)
    .. controls (-0.32,1.35) and (-0.28,0.95) .. (-0.08,1.15)
    .. controls (-0.20,0.85) and (-0.28,0.5) .. (0,0.1) -- cycle;
  \fill[SpiritFlame] (0,0.35) circle (0.10);
\end{tikzpicture}

