\begin{minipage}{3.8in}
\centering
\vspace{0.3cm}
\small\itshape\color{CommentaryBrown}
你們就必得著能力，並要……直到地極，作我的見證。\\[0.15em]
\footnotesize you will receive power... and you shall be My witnesses\\
even to the remotest part of the earth. — Acts 1:8
\vspace{0.3cm}
\end{minipage}
}

