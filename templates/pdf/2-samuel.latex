\usepackage{xcolor}

% Primary colors - Royal/Ancient theme
\definecolor{ChapterBlue}{RGB}{35,55,85}         % Deep royal blue
\definecolor{ScriptureGold}{RGB}{175,135,45}     % Royal gold
\definecolor{CommentaryBrown}{RGB}{95,65,45}     % Warm brown for commentary

% Map colors
\definecolor{WaterBlue}{RGB}{170,200,220}        % Sea/river blue
\definecolor{LandBeige}{RGB}{240,230,210}        % Land color
\definecolor{MountainBrown}{RGB}{170,150,130}    % Mountain shading
\definecolor{DesertTan}{RGB}{220,200,170}        % Desert regions

% Box colors
\definecolor{ScriptureBg}{RGB}{252,250,245}      % Cream for scripture boxes
\definecolor{PsalmBg}{RGB}{250,248,240}          % Light gold for Psalms
\definecolor{TimelineBg}{RGB}{245,248,252}       % Light blue for timeline
\definecolor{ApplicationBg}{RGB}{248,252,248}    % Light green for application

% Text colors
\definecolor{TextGray}{RGB}{50,50,50}
\definecolor{LightGray}{RGB}{120,120,120}
\definecolor{RoyalRed}{RGB}{130,30,35}            % Anointing/covenant-blood accent

