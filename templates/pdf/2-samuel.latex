%% ============================================
%% TIKZ COMMANDS FOR DECORATIONS
%% ============================================

% Crown decoration command (for royal theme)
\newcommand{\crownsymbol}{%
\begin{tikzpicture}[scale=0.12]
  \draw[color=ScriptureGold,line width=1.2pt] (-1,0) -- (-0.8,0.8) -- (-0.4,0.3) -- (0,1) -- (0.4,0.3) -- (0.8,0.8) -- (1,0) -- cycle;
\end{tikzpicture}%
}

% Harp decoration (for Psalms)
\newcommand{\harpsymbol}{%
\begin{tikzpicture}[scale=0.15]
  \draw[color=ScriptureGold,line width=1pt] (0,0) arc (180:0:0.5 and 1);
  \draw[color=ScriptureGold,line width=0.5pt] (0.2,0) -- (0.2,0.9);
  \draw[color=ScriptureGold,line width=0.5pt] (0.5,0) -- (0.5,1);
  \draw[color=ScriptureGold,line width=0.5pt] (0.8,0) -- (0.8,0.9);
\end{tikzpicture}%
}

% Scroll decoration
\newcommand{\scrolldecor}[1]{%
\begin{tikzpicture}[scale=0.6]
  \draw[color=ScriptureGold,line width=0.8pt] (0,0) -- (#1,0);
  \draw[color=ScriptureGold,line width=0.8pt] (0,-0.1) arc (270:90:0.1);
  \draw[color=ScriptureGold,line width=0.8pt] (#1,-0.1) arc (270:450:0.1);
\end{tikzpicture}%
}

