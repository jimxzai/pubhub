{\fontsize{13}{16}\selectfont\itshape\color{TextGray} A Study of the Book of Jeremiah}

\vspace{0.24cm}
% One Hebrew word only: XeTeX lays out a maqaf- or space-joined Hebrew phrase as
% separate RTL runs in LTR order (word order and maqaf come out scrambled).
{\fontsize{15}{18}\selectfont\itshape\color{ChapterStone} שֹׁקֵד }\quad
{\footnotesize\scshape\color{CommentaryBrown} “shoqed”}\quad
{\footnotesize\bfseries\color{AlmondRose!80!black} 留意 \textperiodcentered\ 耶 1:12；31:28}

\vfill

\fcolorbox{ScriptureGold}{white}{%
\begin{minipage}{4.3in}
\centering\vspace{0.15cm}
{\footnotesize\color{AlmondRose!70!black}\kaiti\selectfont
「你看得不錯；因為我留意保守我的話，使得成就。」}\\[0.10em]
{\scriptsize\itshape\color{TextGray}
“You have seen well, for I am watching over My word to perform it.”}\\[0.10em]
{\scriptsize\color{ChapterStone} 耶利米書 1:12 \textperiodcentered\ Jeremiah 1:12}
\vspace{0.15cm}
\end{minipage}}

\vspace{0.3in}
