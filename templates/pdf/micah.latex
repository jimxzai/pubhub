  \draw[ScriptureGold,line width=1.5pt] (0.34,1.3) -- (3.16,1.3);
  \draw[ScriptureGold,line width=1.5pt] (3.84,1.3) -- (6.66,1.3);
  \draw[ScriptureGold,line width=1.5pt] (7.34,1.3) -- (10.16,1.3);
  \draw[ScriptureGold,line width=1.5pt] (10.84,1.3) -- (13.66,1.3);
