\usepackage{xcolor}

% Primary colors - throne-room / marriage-of-the-Lamb theme
\definecolor{ChapterBlue}{RGB}{28,58,60}         % Royal navy for chapters
\definecolor{ScriptureGold}{RGB}{175,135,45}     % Royal gold for scripture refs
\definecolor{CommentaryBrown}{RGB}{95,45,25}     % Rich brown for commentary

% Cover gradient (navy, dark at top to a richer royal blue at bottom)
\definecolor{NavyDark}{RGB}{10,30,32}
\definecolor{NavyLight}{RGB}{34,78,80}

% Box colors
\definecolor{ScriptureBg}{RGB}{253,250,244}      % Cream for scripture boxes
\definecolor{GreekBg}{RGB}{253,246,246}          % Light rose for Greek
\definecolor{ApplicationBg}{RGB}{248,252,248}    % Light green for application

% Text colors
\definecolor{TextGray}{RGB}{50,50,50}
\definecolor{LightGray}{RGB}{120,120,120}

% Red letter Bible - Jesus's words (#CC0000), matching the gospel templates
\definecolor{JesusRed}{RGB}{204,0,0}
\newcommand{\jesus}[1]{\textcolor{JesusRed}{#1}}

% Diagram colors - two camps (Lamb's bride vs. the harlot)
\definecolor{OldCovenantRed}{RGB}{150,40,40}     % Babylon / the beast
\definecolor{NewCovenantGreen}{RGB}{60,120,80}   % New Jerusalem / the Lamb

