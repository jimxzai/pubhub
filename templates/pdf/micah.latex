  \node[font=\footnotesize,color=TextGray] at (0,0.15) {神親自下來};
  \node[font=\tiny,color=LightGray] at (0,-0.3) {Micah 1–2};
  \node[font=\tiny,color=TextGray] at (0,-0.75) {1:2 聽 → 2:12 聚集};

  \node[draw=ScriptureGold,fill=ScriptureGold!10,rounded corners,minimum width=3.6cm,minimum height=2.1cm] at (4.6,0) {};
  \node[font=\small\bfseries,color=ScriptureGold!80!black] at (4.6,0.6) {卷二};
  \node[font=\footnotesize,color=TextGray] at (4.6,0.15) {官長與山};
  \node[font=\tiny,color=LightGray] at (4.6,-0.3) {Micah 3–5};
  \node[font=\tiny,color=TextGray] at (4.6,-0.75) {3:1 聽 → 5:2 伯利恆};

  \node[draw=NewCovenantGreen,fill=NewCovenantGreen!10,rounded corners,minimum width=3.6cm,minimum height=2.1cm] at (9.2,0) {};
  \node[font=\small\bfseries,color=NewCovenantGreen!80!black] at (9.2,0.6) {卷三};
  \node[font=\footnotesize,color=TextGray] at (9.2,0.15) {爭辯與等候};
  \node[font=\tiny,color=LightGray] at (9.2,-0.3) {Micah 6–7};
  \node[font=\tiny,color=TextGray] at (9.2,-0.75) {6:1 聽 → 7:18 有何神像你};

  \draw[->,thick,color=ScriptureGold] (1.9,0) -- (2.7,0);
  \draw[->,thick,color=ScriptureGold] (6.5,0) -- (7.3,0);
