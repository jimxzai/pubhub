% PubHub Micah Template (derived from templates/pdf/revelation.latex: same full-bleed cover/back-cover machinery as Revelation and John)
% Professional Bible Study Book Layout — "有何神像你" Who Is a God Like You? theme
% Bilingual Chinese/English with Greek word studies
% Requires XeLaTeX for CJK support

\documentclass[11pt,openany]{book}

%% ============================================
%% FONT SETUP WITH CJK LINE BREAKING
%% ============================================
\usepackage{fontspec}

%% BoldFont fix (see .claude/skills/eat-bible/references/gotchas.md):
%% "Songti SC Bold" has missing/mismatched glyphs for full-width punctuation
%% (：。), so xelatex silently *weakens* any \textbf run containing them
%% instead of erroring — zero warnings, exit code 0. Nearly every bolded
%% Chinese phrase in this book contains such punctuation. Pointing BoldFont at
%% the same regular file with FakeBold guarantees identical glyph coverage, so
%% the fallback cannot trigger.
%%
%% Confirmed by isolated repro, per the skill's instruction to measure rather
%% than eyeball: the CJK line renders visibly lighter with BoldFont=Songti SC
%% Bold and unambiguously heavier with FakeBold.
%%
%% The same repro showed the reverse for the Latin/Greek/Hebrew families
%% below: Baskerville, Times New Roman and Arial Hebrew all have real bold
%% faces with complete coverage for the script they actually render, and
%% fontspec's auto-detected bold beats a synthetic one there. So FakeBold is
%% applied to the CJK families ONLY, not blanket-applied to every
%% \newfontfamily.
\setmainfont{Songti SC}[
  BoldFont=Songti SC,
  BoldFeatures={FakeBold=2.2},
  ItalicFont=Kaiti SC
]
\setsansfont{PingFang SC}[
  BoldFont=PingFang SC,
  BoldFeatures={FakeBold=2.0}
]
\setmonofont{Songti SC}[
  BoldFont=Songti SC,
  BoldFeatures={FakeBold=2.2}
]

%% Greek and Hebrew font support - auto-switch for Unicode blocks.
%% These keep their real bold faces deliberately — see the note above.
\usepackage{ucharclasses}
\newfontfamily\greekfont{Times New Roman}[
  Script=Greek,
  BoldFont=Times New Roman,
  BoldFeatures={FakeBold=2.0}
]
% Scale=1.35: Times New Roman's Hebrew glyphs are drawn much smaller than its
% Latin ones and far smaller than Songti SC's CJK, so pointed Hebrew set at the
% nominal size renders with the nikkud crushed into an unreadable smudge.
% Same fix as templates/pdf/jeremiah.latex and isaiah.latex.
\newfontfamily\hebrewfont{Times New Roman}[
  Script=Hebrew,
  Scale=1.35,
  BoldFont=Times New Roman,
  BoldFeatures={FakeBold=2.0}
]
\newfontfamily\cjkfallbackfont{Songti SC}[
  ItalicFont=Kaiti SC,
  BoldFont=Songti SC,
  BoldFeatures={FakeBold=2.2}
]

%% Classical English typeface — auto-switch for Latin-script runs so
%% bilingual scripture/quote blocks render in a period-appropriate serif
%% instead of Songti SC's built-in Latin glyphs. Baskerville for running
%% text; Didot reserved for large display lines (invoked explicitly).
\newfontfamily\basklatin{Baskerville}[
  ItalicFont={Baskerville Italic},
  BoldFont={Baskerville SemiBold},
  BoldItalicFont={Baskerville SemiBold Italic}
]
\newfontfamily\didotfont{Didot}
% Alias matching the naming convention used on the full-bleed cover pages
\newcommand{\baskervillefont}{\basklatin}
%% ucharclasses: two independent traps, both silent.
%%
%% TRAP 1 — two APIs that look alike:
%%   \setTransitionsFor{<Block>}{in}{out}   3 args, a real Unicode BLOCK
%%   \setTransitionsFor<Group>{in}{out}     2 args, a class GROUP
%% "Greek", "Latin", "CJK" are GROUPS; "Han" is neither. Feeding a group name
%% (or a nonexistent one) to the 3-arg form compiles fine and does nothing.
%% Three of this template's five original transitions were dead: {Greek}
%% (block is GreekAndCoptic), {Han} (block is CJKUnifiedIdeographs) and
%% {Latin} (group form is \setTransitionsForLatin).
%%
%% TRAP 2 — \setTransitionsFor sets BOTH directions for every pair, so a
%% later declaration's out-code silently overwrites an earlier one's in-code:
%%     \setTransitionsFor{X}{in}{out}  ⇒  for every other class n
%%         \XeTeXinterchartoks n X = {in}      (entering X)
%%         \XeTeXinterchartoks X n = {out}     (leaving X)
%% Declare HalfwidthAndFullwidthForms after GreekExtended and the former's
%% out-code clobbers the latter's in-code for the pair (full-width → Greek).
%% Observable symptom: a Greek or Hebrew run whose PRECEDING character is CJK
%% or full-width punctuation (：、。） silently does not switch font. It was
%% invisible here only because Songti SC happens to carry basic Greek glyphs.
%%
%% FIX: use \setTransitionTo, which sets the entering direction ONLY and never
%% touches the leaving direction. With every block in play given an explicit
%% destination there is nothing to clobber and declaration order stops
%% mattering. Verified: 0 missing glyphs across a stress test covering
%% italic/bold book titles, mixed CJK+Latin bold, polytonic Greek, Hebrew
%% beside digits, full-width punctuation, macron transliterations and arrows.
%%
%% \uckeep carries the ambient series/shape across the boundary: a bare
%% \newfontfamily switch resets both to the family default, which is what
%% drops \emph and \textbf on a Latin run inside CJK prose.
\makeatletter
\newcommand{\uckeep}[1]{%
  \edef\uc@sh{\f@shape}\edef\uc@se{\f@series}%
  #1\fontshape{\uc@sh}\fontseries{\uc@se}\selectfont}
\makeatother
\newcommand{\ucLatinRun}{\uckeep{\basklatin}}
\newcommand{\ucCJKRun}{\uckeep{\cjkfallbackfont}}
\newcommand{\ucGreekRun}{\uckeep{\greekfont}}
\newcommand{\ucHebrewRun}{\uckeep{\hebrewfont}}
%% Every Unicode block these books actually contain, measured over the
%% markdown sources. Anything not listed keeps the main font.
\setTransitionTo{BasicLatin}{\ucLatinRun}
\setTransitionTo{LatinSupplement}{\ucLatinRun}
\setTransitionTo{LatinExtendedA}{\ucLatinRun}
\setTransitionTo{GreekAndCoptic}{\ucGreekRun}
\setTransitionTo{GreekExtended}{\ucGreekRun}
\setTransitionTo{Hebrew}{\ucHebrewRun}
\setTransitionTo{CJKUnifiedIdeographs}{\ucCJKRun}
\setTransitionTo{CJKSymbolsAndPunctuation}{\ucCJKRun}
\setTransitionTo{HalfwidthAndFullwidthForms}{\ucCJKRun}
\setTransitionTo{GeneralPunctuation}{\ucCJKRun}
\setTransitionTo{BoxDrawing}{\ucCJKRun}
\setTransitionTo{Arrows}{\ucCJKRun}
\setTransitionTo{MathematicalOperators}{\ucCJKRun}
\setTransitionTo{GeometricShapes}{\ucCJKRun}
\setTransitionTo{MiscellaneousSymbols}{\ucCJKRun}
\setTransitionTo{SuperscriptsAndSubscripts}{\ucCJKRun}
\setTransitionTo{Dingbats}{\ucCJKRun}
\setTransitionTo{MiscellaneousSymbolsAndArrows}{\ucCJKRun}
\setTransitionTo{LetterlikeSymbols}{\ucCJKRun}
\setTransitionTo{EnclosedAlphanumerics}{\ucCJKRun}
\setTransitionTo{BlockElements}{\ucCJKRun}
\setTransitionTo{MiscellaneousTechnical}{\ucCJKRun}
\setTransitionTo{Hiragana}{\ucCJKRun}
\setTransitionTo{Katakana}{\ucCJKRun}
\setTransitionTo{CJKCompatibilityForms}{\ucCJKRun}
\setTransitionTo{SmallFormVariants}{\ucCJKRun}
\setTransitionTo{VerticalForms}{\ucCJKRun}
\setTransitionTo{MiscellaneousSymbolsAndPictographs}{\ucCJKRun}
\setTransitionTo{Emoticons}{\ucCJKRun}
\setTransitionTo{CombiningDiacriticalMarks}{\ucCJKRun}
\setTransitionTo{NumberForms}{\ucCJKRun}
\setTransitionTo{CurrencySymbols}{\ucCJKRun}

%% Semitic-transliteration diacritics (ḥesed U+1E25 "LatinExtendedAdditional",
%% tsade ṣ U+1E63 "LatinExtendedAdditional", ʿayin's modifier letter U+02BF
%% "SpacingModifierLetters") used throughout the Word Study sections.
%%
%% THE REAL BUG (found the hard way): ucharclasses' \XeTeXinterchartoks fires
%% on a character's Unicode class as XeTeX's own primitive lexer processes it,
%% which is NOT the same thing as, and fires AFTER, ordinary TeX font
%% selection — so it overrides ANY manual font switch for a block that has a
%% registered transition, including one from inside an explicit
%% `{\somefont ...}` group, and even for a character produced indirectly via
%% \symbol{<codepoint>} rather than typed literally. A \newunicodechar
%% attempt and a manual `{\translitfont ...}`-wrapping attempt both failed
%% against this for exactly that reason — there is no overriding
%% ucharclasses per-character from inside its own mapped blocks. The only
%% real fix is to make the BLOCK'S OWN mapping point at a font that has the
%% glyphs. IPAExtensions (used elsewhere in this book's Hebrew vowel-pointing
%% discussion) already worked fine going to \ucCJKRun and is left alone.
\newfontfamily\translitfont{Times New Roman}
\newcommand{\ucTranslitRun}{\uckeep{\translitfont}}
\setTransitionTo{SpacingModifierLetters}{\ucTranslitRun}
\setTransitionTo{LatinExtendedAdditional}{\ucTranslitRun}
\setTransitionTo{IPAExtensions}{\ucCJKRun}


%% Enable CJK line breaking - critical for Chinese text
\XeTeXlinebreaklocale "zh"
\XeTeXlinebreakskip = 0pt plus 1pt minus 0.1pt

