\vspace{0.4cm}

% Five steps of God's order
\begin{tikzpicture}[scale=0.62, transform shape]
  \node[font=\footnotesize\bfseries,color=ChapterBlue] at (7,3) {啟示的次序 The Order of Revelation};
  \node[font=\tiny,color=TextGray,align=center,text width=2.3cm] at (0,0.3) {神先下來 \\ He comes down};
  \node[font=\tiny,color=TextGray,align=center,text width=2.3cm] at (3.5,0.3) {審判從領袖起 \\ Leaders first};
  \node[font=\tiny,color=TextGray,align=center,text width=2.3cm] at (7,0.3) {判決與應許並排 \\ Side by side};
  \node[font=\tiny,color=TextGray,align=center,text width=2.3cm] at (10.5,0.3) {君王自最小處來 \\ From the least};
  \node[font=\tiny,color=TextGray,align=center,text width=2.3cm] at (14,0.3) {有何神像你 \\ Who is like You};
  \foreach \x/\n in {0/1,3.5/2,7/3,10.5/4,14/5} {
