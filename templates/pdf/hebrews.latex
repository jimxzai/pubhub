% Seven "Better" things
{\large\bfseries\color{ChapterBlue} 七個「更美」 Seven "Better" Things}

\vspace{0.3cm}

\begin{tikzpicture}[scale=0.7]
  \foreach \x/\num/\txt in {
    0/1/Better Hope 更美的指望,
    2.5/2/Better Covenant 更美之約,
