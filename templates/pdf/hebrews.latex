%% ============================================
%% FULL-BLEED COVER MACHINERY (front/back cover only)
%% Same design language as templates/pdf/revelation.latex, in this book's
%% own royal-purple/gold livery rather than Revelation's navy.
%% ============================================
\usepackage{eso-pic}
\usepackage{pgfornament}

% Cover-only palette. The gradient runs from a near-black plum to
% ChapterBlue's royal purple, so the cover reads as the same family as the
% chapter openers inside.
\definecolor{PurpleDark}{RGB}{26,6,44}
\definecolor{PurpleLight}{RGB}{78,20,120}
\definecolor{CoverCream}{RGB}{242,236,222}
\definecolor{CoverGoldBright}{RGB}{212,178,90}
\definecolor{CoverMuted}{RGB}{188,183,166}

% Full-bleed gradient, painted in the shipout BACKGROUND hook so it reaches
% the true physical page edge without disturbing the \geometry text block
% every other page uses. The starred form applies to this page only.
\newcommand{\CoverBackground}{%
  \AddToShipoutPictureBG*{%
    \begin{tikzpicture}[remember picture,overlay]
      \shade[top color=PurpleDark,bottom color=PurpleLight]
        ($$(current page.south west)$$) rectangle ($$(current page.north east)$$);
    \end{tikzpicture}%
  }%
}

% Classical book-plate border: two inset hairlines plus a corner ornament at
% each corner. Ornament 61 at 0.85cm — Revelation's 88 at 0.45cm renders as an
% almost invisible speck at this trim size.
\newcommand{\CoverBorder}{%
  \AddToShipoutPictureFG*{%
    \begin{tikzpicture}[remember picture,overlay]
      \draw[color=CoverGoldBright,line width=0.5pt]
        ($$(current page.south west)+(0.45in,0.45in)$$) rectangle ($$(current page.north east)-(0.45in,0.45in)$$);
      \draw[color=CoverGoldBright,line width=0.4pt]
        ($$(current page.south west)+(0.54in,0.54in)$$) rectangle ($$(current page.north east)-(0.54in,0.54in)$$);
      \node at ($$(current page.south west)+(0.495in,0.495in)$$) {\pgfornament[width=0.85cm,color=CoverGoldBright,anchor=center]{61}};
      \node at ($$(current page.north west)+(0.495in,-0.495in)$$) {\pgfornament[width=0.85cm,color=CoverGoldBright,anchor=center,symmetry=v]{61}};
      \node at ($$(current page.south east)+(-0.495in,0.495in)$$) {\pgfornament[width=0.85cm,color=CoverGoldBright,anchor=center,symmetry=h]{61}};
      \node at ($$(current page.north east)+(-0.495in,-0.495in)$$) {\pgfornament[width=0.85cm,color=CoverGoldBright,anchor=center,symmetry=c]{61}};
    \end{tikzpicture}%
  }%
}

% A single fleuron, used standalone on the cover pages. Ornament 88 — which
% revelation.latex uses — is a plain hairline, so between two rules it is
% invisible; 75 is a symmetric pair of scrolls that actually reads at this size.
\newcommand{\fleuron}[1][CoverGoldBright]{%
  \pgfornament[width=0.85cm,color=#1]{75}%
}

% Rule — fleuron — rule, the cover's divider.
\newcommand{\coverdivider}[1][1.5in]{%
  {\color{CoverGoldBright}\rule{#1}{0.4pt}}\hspace{0.3cm}%
  \raisebox{-0.28cm}{\fleuron}\hspace{0.3cm}%
  {\color{CoverGoldBright}\rule{#1}{0.4pt}}%
}

% The publisher's device, echoing the priestly theme.
\newcommand{\publishersmark}[1][CoverGoldBright]{%
  \pgfornament[width=1.15cm,color=#1]{69}%
}

%% ============================================
%% TIKZ COMMANDS FOR DECORATIONS
%% ============================================

% Cross decoration
\newcommand{\crosssymbol}{%
\begin{tikzpicture}[scale=0.15]
  \draw[color=ScriptureGold,line width=1.5pt] (0,-1) -- (0,1);
  \draw[color=ScriptureGold,line width=1.5pt] (-0.6,0.4) -- (0.6,0.4);
\end{tikzpicture}%
}

% High Priest symbol
\newcommand{\priestsymbol}{%
\begin{tikzpicture}[scale=0.2]
  \draw[color=ScriptureGold,line width=1pt] (0,0) -- (0,1.2);
  \draw[color=ScriptureGold,line width=1pt] (-0.4,0.8) -- (0.4,0.8);
  \draw[color=ScriptureGold,line width=0.8pt] (0,0.3) circle (0.2);
\end{tikzpicture}%
}

%% ============================================
%% HYPERLINKS
%% ============================================
\usepackage{hyperref}
% hyperxmp turns the hypersetup keys below into a real XMP packet. Without it
% hyperref writes the /Info dictionary only, which modern cataloguing and
% preflight tools no longer read. Must be loaded AFTER hyperref.
\usepackage{hyperxmp}

\hypersetup{
  colorlinks=true,
  linkcolor=ChapterBlue,
  urlcolor=ScriptureGold,
  bookmarks=true,
  bookmarksnumbered=true,
  % Without these the PDF has no Title, Author or Subject at all: the file
  % shows as its bare filename in a reader's title bar, in a library
  % catalogue, and in any DMS that indexes PDF metadata. pdflang additionally
  % tells a screen reader and the hyphenation engine the primary language.
  pdftitle={希伯來書研讀 — Hebrews Deep Study},
  pdfauthor={PubHub 三書精讀系統},
  pdfsubject={希伯來書逐章研讀：更美的中保——一次獻上，就坐下了},
  pdfkeywords={希伯來書, Hebrews, 聖經研讀, Bible study, 和合本, CUV, NASB, 大祭司, 麥基洗德, 更美之約, 查經},
  pdfcreator={XeLaTeX + pandoc (PubHub 三書精讀出版系統)},
  pdflang={zh-Hant}
}

% \tableofcontents obeys the LaTeX counter, NOT pandoc's --toc-depth=1 /
% -V tocdepth=0 — those look like they have it covered while doing nothing.
% Left unset, the contents list itemises down to sub-subsection: measured on
% this book, entries like "10.14.2 二、大衛的「今日」" across seven pages.
% secnumdepth must go with it, or body headings and running heads print as
% "14.7 領受要點" — technical-manual numbering in a devotional book.
\setcounter{secnumdepth}{0}
\setcounter{tocdepth}{0}

