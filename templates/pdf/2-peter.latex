% PubHub 2 Peter Template
% Professional Bible Study Book Layout
% Bilingual Chinese/English with Greek word studies
% Requires XeLaTeX for CJK support

\documentclass[11pt,openany]{book}

%% ============================================
%% FONT SETUP WITH CJK LINE BREAKING
%% ============================================
\usepackage{fontspec}

% BoldFont deliberately points at the SAME regular font file with
% synthetic FakeBold, not a separate real bold face ("Songti SC Bold"):
% a real bold face missing/mismatching glyphs for full-width punctuation
% (：。) silently weakens or fully flattens \textbf for any CJK bold span
% containing one — with zero warnings, zero errors (documented, confirmed
% pattern in this codebase's 1-peter.latex/romans.latex; see the
% eat-bible skill's Gotchas). FakeBold guarantees identical glyph
% coverage between regular and "bold" so this class of silent fallback
% can't trigger.
\setmainfont{Songti SC}[
  BoldFont=Songti SC,
  BoldFeatures={FakeBold=2.2},
  ItalicFont=Kaiti SC
]
\setsansfont{PingFang SC}
\setmonofont{Songti SC}

%% Greek and Hebrew font support. NOT ucharclasses: its automatic
%% per-character script hooking silently strips \textbf bold from
%% Scripture quotes the moment ANY other package that hooks font/box
%% machinery is also loaded (hyperref, eso-pic, pgfornament each
%% independently trigger it — root-caused via xelatex repro; this isn't
%% one bad package, ucharclasses itself is fragile once the document
%% has any real complexity, and hyperref cannot be dropped). Instead the
%% build script wraps actual Greek/Hebrew Unicode runs in the source
%% with these font-switch commands explicitly (see wrap_greek_hebrew()
%% in scripts/build-2-peter-consolidated.sh) — manual, but immune to the
%% conflict since it never touches a \textbf span (CUV Scripture quotes
%% never contain embedded Greek/Hebrew characters).
% NOTE: deliberately no [Script=Greek]/[Script=Hebrew] feature tag — with
% ~90 manual \greekfont invocations across the book (see wrap_greek_hebrew
% below), that OpenType script-shaping tag causes progressive font-state
% corruption (confirmed via stress test: 100 invocations WITH the tag broke
% down into 1400+ missing-glyph errors and stuck-font pages; the identical
% test with the tag removed rendered all 100 correctly). Times New Roman
% renders Greek/Hebrew correctly without it.
% Same FakeBold pattern applied here too: "Times New Roman Bold" is a
% real separate font file and is exactly the shape of vulnerability the
% eat-bible skill's Gotchas warn against — apply to EVERY \newfontfamily
% ucharclasses/manual wrapping can switch into mid-run, not just the
% main font.
\newfontfamily\greekfont{Times New Roman}[BoldFont=Times New Roman, BoldFeatures={FakeBold=2.2}, ItalicFont=Times New Roman Italic]
\newfontfamily\hebrewfont{Arial Hebrew}

%% Enable CJK line breaking - critical for Chinese text
\XeTeXlinebreaklocale "zh"
\XeTeXlinebreakskip = 0pt plus 1pt minus 0.1pt

