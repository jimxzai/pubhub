% Knowledge decoration command
\newcommand{\knowledgedecor}[1]{%
\begin{tikzpicture}[scale=0.6]
  \draw[color=ChapterPurple,line width=0.8pt,decorate,decoration={snake,amplitude=0.5pt,segment length=6pt}]
    (0,0) -- (#1,0);
\end{tikzpicture}%
}

% Cross decoration
\newcommand{\crosssymbol}{%
\begin{tikzpicture}[scale=0.15]
  \draw[color=ChapterPurple,line width=1.5pt] (0,-1) -- (0,1);
  \draw[color=ChapterPurple,line width=1.5pt] (-0.6,0.4) -- (0.6,0.4);
\end{tikzpicture}%
}

%% ============================================
%% FULL-BLEED COVER MACHINERY (front/back cover only)
%% ============================================
% NOTE: deliberately NOT \usepackage{eso-pic} or \usepackage{pgfornament}.
% Either one, merely loaded alongside ucharclasses (regardless of whether
% its own commands are used), silently strips \textbf bold from every
% Scripture quote in the main body (root-caused via xelatex repro — the
% interaction is with ucharclasses' Han-transition hooks, not with how
% these packages are invoked). Plain \tikzpicture[remember picture,overlay]
% called inline achieves the same full-bleed effect without the conflict:
% "overlay" makes the picture consume zero space in the surrounding flow,
% so \CoverBackground/\CoverBorder below can simply be called directly
% inside the cover page content instead of via a shipout hook.

% Deep-purple gradient for the full-bleed cover background, echoing the
% book's ChapterPurple identity rather than a generic navy.
\definecolor{CoverPurpleDeep}{RGB}{30,17,46}
\definecolor{CoverPurpleLight}{RGB}{72,45,104}
\newcommand{\CoverBackground}{%
    \begin{tikzpicture}[remember picture,overlay]
      \shade[shading angle=115, left color=CoverPurpleDeep, right color=CoverPurpleLight]
        (current page.south west) rectangle (current page.north east);
    \end{tikzpicture}%
}

% Classical book-plate border: two inset hairlines plus a corner ornament,
% painted using the page's own bounding box.
\newcommand{\CoverBorder}{%
    \begin{tikzpicture}[remember picture,overlay]
      \draw[color=ScriptureGold,line width=0.5pt]
        ($$(current page.south west)+(0.45in,0.45in)$$) rectangle ($$(current page.north east)-(0.45in,0.45in)$$);
      \draw[color=ScriptureGold,line width=0.4pt]
        ($$(current page.south west)+(0.52in,0.52in)$$) rectangle ($$(current page.north east)-(0.52in,0.52in)$$);
      \foreach \c/\dx/\dy in {south west/0.55in/0.55in, south east/-0.55in/0.55in, north east/-0.55in/-0.55in, north west/0.55in/-0.55in} {
        \begin{scope}[shift={($$(current page.\c)+(\dx,\dy)$$)}]
          \draw[color=ScriptureGold,line width=0.9pt,line cap=round] (0,-0.09) -- (0,0.09);
          \draw[color=ScriptureGold,line width=0.9pt,line cap=round] (-0.09,0) -- (0.09,0);
          \draw[color=ScriptureGold,line width=0.6pt,line cap=round] (-0.06,-0.06) -- (0.06,0.06);
          \draw[color=ScriptureGold,line width=0.6pt,line cap=round] (-0.06,0.06) -- (0.06,-0.06);
        \end{scope}
      }
    \end{tikzpicture}%
}

% A small printer's fleuron (hand-drawn compass-star, matching the corner
% ornament's language), reused across the full-bleed cover pages.
\newcommand{\fleuron}[1][ScriptureGold]{%
\begin{tikzpicture}[baseline=-0.5ex,scale=0.09,line cap=round]
  \draw[color=#1,line width=1.2pt] (0,-1) -- (0,1);
  \draw[color=#1,line width=1.2pt] (-1,0) -- (1,0);
  \draw[color=#1,line width=0.7pt] (-0.7,-0.7) -- (0.7,0.7);
  \draw[color=#1,line width=0.7pt] (-0.7,0.7) -- (0.7,-0.7);
  \fill[color=#1] (0,0) circle (0.22);
\end{tikzpicture}%
}

% Morning-star symbol — echoes 2 Peter 1:19 "the morning star rises in
% your hearts" (φωσφόρος), this book's own distinctive image, the way
% the sibling volume marks its cover with a cornerstone gem for 1 Peter.
\newcommand{\morningstarsymbol}{%
\begin{tikzpicture}[scale=0.32,line cap=round]
  \foreach \ang in {0,45,90,135} {
    \draw[color=ScriptureGold,line width=1.1pt] (\ang:1.15) -- (\ang+180:1.15);
  }
  \draw[color=ScriptureGold,line width=0.7pt] (0,0) circle (0.16);
\end{tikzpicture}%
}

% Light-on-dark cover text colors (defined once, used on both covers)
\definecolor{CoverCream}{RGB}{240,236,230}
\definecolor{CoverGoldBright}{RGB}{214,168,90}
\definecolor{CoverMuted}{RGB}{188,178,196}

