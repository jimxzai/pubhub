%% ============================================
%% HEADERS AND FOOTERS
%% ============================================
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE,RO]{\small\thepage}
\fancyhead[LO]{\small\itshape\color{LightGray}\nouppercase{\rightmark}}
\fancyhead[RE]{\small\itshape\color{LightGray}\nouppercase{\leftmark}}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{ChapterPurple}\leaders\hrule height \headrulewidth\hfill}}
\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyfoot[C]{\small\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

% Plain \cleardoublepage never sets \thispagestyle{empty} on the blank
% verso page it inserts to reach an odd page — it inherits whatever
% pagestyle (fancy) was already active, leaking a running header/rule
% onto an otherwise-blank page. Use this instead of \cleardoublepage
% at any section boundary where \pagestyle{fancy} is already active.
\newcommand{\ClearDoublePageEmpty}{%
  \clearpage
  \ifodd\value{page}\else
    \hbox{}
    \thispagestyle{empty}
    \newpage
  \fi
}

%% ============================================
%% SECTION STYLING (manual, without titlesec)
%% ============================================
% Number chapters only: no numbered subsections in body or running heads
\setcounter{secnumdepth}{0}
\makeatletter
% Chapter styling
\def\@makechapterhead#1{%
  \vspace*{15pt}%
  {\parindent \z@ \raggedright \normalfont
    \ifnum \c@secnumdepth >\m@ne
      \large\bfseries\color{ChapterPurple} \@chapapp\space \thechapter
      \par\nobreak
      \vskip 8pt
    \fi
    \interlinepenalty\@M
    \LARGE \bfseries\color{ChapterPurple} #1\par\nobreak
    \vskip 12pt
    {\color{ChapterPurple}\hrule height 1.5pt}
    \vskip 15pt
  }}
\def\@makeschapterhead#1{%
  \vspace*{15pt}%
  {\parindent \z@ \raggedright
    \normalfont
    \interlinepenalty\@M
    \LARGE \bfseries\color{ChapterPurple} #1\par\nobreak
    \vskip 8pt
    {\color{ChapterPurple}\hrule height 1.5pt}
    \vskip 15pt
  }}
% book.cls's own \@schapter (what \chapter* expands to — every pandoc
% {.unnumbered} heading, i.e. every front/back-matter section in this
% book) never calls \markboth, unlike numbered \chapter. Left
% unpatched, the running header on every unnumbered section's pages
% silently keeps showing the LAST NUMBERED chapter's title (confirmed:
% appendix/afterword pages rendered "Chapter 3. 主的日子" in their
% header). Re-add the \markboth call book.cls's numbered \@chapter has.
\def\@schapter#1{\if@twocolumn
                   \@topnewpage[\@makeschapterhead{#1}]%
                 \else
                   \@makeschapterhead{#1}%
                   \@afterheading
                 \fi
                 \markboth{#1}{#1}}

% Section styling
\renewcommand\section{\@startsection {section}{1}{\z@}%
  {-2.5ex \@plus -0.5ex \@minus -.2ex}%
  {1.5ex \@plus.2ex}%
  {\normalfont\large\bfseries\color{ChapterPurple}}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}%
  {-2ex\@plus -0.5ex \@minus -.2ex}%
  {1ex \@plus .2ex}%
  {\normalfont\normalsize\bfseries\color{CommentaryBrown}}}
\renewcommand\subsubsection{\@startsection{subsubsection}{3}{\z@}%
  {-1.5ex\@plus -0.5ex \@minus -.2ex}%
  {0.8ex \@plus .2ex}%
  {\normalfont\normalsize\bfseries\color{TextGray}}}
\makeatother

%% ============================================
%% BLOCKQUOTE STYLING - extra room for CJK text
%% ============================================
% NOT \list/\item, and NO explicit \par inside the group: at this
% document's real scale (~35 Scripture quote blocks), EITHER one silently
% strips \textbf bold starting partway through the book (confirmed via a
% battery of xelatex stress tests: 60 repetitions of \list+\item+\par
% failed every variant tried — \renewenvironment vs \newenvironment vs
% raw \begingroup, "quote" name vs a fresh name — while the identical
% \fontsize+\color+\textbf content survived 60 repetitions cleanly the
% moment \par was removed and \list/\item was replaced with a plain
% \begingroup/\leftskip/\rightskip group). Paragraph breaks between quote
% blocks still happen correctly from the blank line pandoc already emits
% between them — \par is not needed here.
\renewenvironment{quote}{%
  \vspace{0.3\baselineskip}%
  \begingroup
  \leftskip=0.5em \rightskip=0.2em
  \fontsize{10}{12}\selectfont\color{TextGray}%
}{%
  \endgroup
  \vspace{0.3\baselineskip}%
}

%% ============================================
%% WIDOW/ORPHAN AND LINE BREAKING - aggressive for CJK
%% ============================================
\widowpenalty=10000
\clubpenalty=10000
\tolerance=9999
\emergencystretch=6em
\hyphenpenalty=50
\exhyphenpenalty=50
\sloppy
\hbadness=10000
\hfuzz=2pt

