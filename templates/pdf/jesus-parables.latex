{\Large\bfseries\color{ChapterPurple} 四種土 The Four Soils}\\[0.1cm]
{\small\itshape\color{LightGray} 馬太福音 13:1-23——比喻的總鑰匙}

\vspace{0.6cm}

\begin{tikzpicture}[every node/.style={align=center, inner sep=5pt}, scale=0.9, transform shape]
\node[draw=ScriptureGold, thick, fill=ScriptureBg, rounded corners,
      text width=11cm, font=\small\bfseries, text=ChapterPurple] (sower) at (0,4.2)
  {撒種之人所撒的，就是道 The sower sows the word（可 4:14）};
\node[draw=ChapterPurple, fill=white, rounded corners, text width=2.4cm,
      font=\scriptsize] (a) at (-4.2,2.2) {\textbf{路旁}\\ 心硬\\ 惡者奪去};
\node[draw=ChapterPurple, fill=white, rounded corners, text width=2.4cm,
      font=\scriptsize] (b) at (-1.4,2.2) {\textbf{石頭地}\\ 沒有根\\ 遭患難就跌倒};
\node[draw=ChapterPurple, fill=white, rounded corners, text width=2.4cm,
      font=\scriptsize] (c) at (1.4,2.2) {\textbf{荊棘地}\\ 被擠住\\ 思慮與錢財};
\node[draw=ScriptureGold, very thick, fill=ScriptureBg, rounded corners,
      text width=2.4cm, font=\scriptsize] (d) at (4.2,2.2)
  {\textbf{好土}\\ 聽了，明白了\\ 持守，就結實};
\draw[->, ChapterPurple] (sower) -- (a);
\draw[->, ChapterPurple] (sower) -- (b);
\draw[->, ChapterPurple] (sower) -- (c);
\draw[->, ScriptureGold, thick] (sower) -- (d);
\node[font=\scriptsize\itshape, text=CommentaryBrown, text width=11cm] at (0,0.6)
  {四種土不是四種人，是同一顆心面對神的話時，可能出現的四種光景。};
\end{tikzpicture}

\vspace{0.8cm}

{\Large\bfseries\color{ChapterPurple} 比喻在四福音中的分布}\\[0.4cm]

\begin{tikzpicture}[every node/.style={align=center, inner sep=5pt}, scale=0.9, transform shape]
\node[draw=ChapterPurple, fill=ScriptureBg, rounded corners, text width=2.6cm,
      font=\scriptsize] at (-4.2,0) {\textbf{馬太}\\ 天國的比喻\\ 國度與審判};
\node[draw=ChapterPurple, fill=ScriptureBg, rounded corners, text width=2.6cm,
      font=\scriptsize] at (-1.4,0) {\textbf{馬可}\\ 最少\\ 精簡與行動};
\node[draw=ChapterPurple, fill=ScriptureBg, rounded corners, text width=2.6cm,
      font=\scriptsize] at (1.4,0) {\textbf{路加}\\ 最多\\ 恩典與失喪者};
\node[draw=ScriptureGold, thick, fill=ScriptureBg, rounded corners, text width=2.6cm,
      font=\scriptsize] at (4.2,0) {\textbf{約翰}\\ 沒有比喻\\ 直接說「我是」};
\end{tikzpicture}

\vspace{0.6cm}

% Key insight box
\fcolorbox{ScriptureGold}{ScriptureBg}{%
\begin{minipage}{5in}
\small\color{CommentaryBrown}
\textbf{從中領受}：比喻不是為了把道理講得更淺，是為了把人分出來。同一個故事，對硬著心的人是遮蔽，對願意聽的人是開啟——「凡有的，還要加給他」（太13:12）。所以讀比喻的第一個問題不是「這是甚麼意思」，是「我是哪一種土」。
\end{minipage}
}

