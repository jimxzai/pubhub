% ===== THREE CONCENTRIC RINGS: COMPROMISE / OPPRESSION / TORCH-FIRE DELIVERANCE =====
\begin{tikzpicture}[scale=0.85, transform shape]
  % Outer ring — compromise, the root every decline starts from (2:11-13)
  \fill[ChapterIron, opacity=0.16] (0,0.1) circle (1.65);
  \draw[ChapterIron, line width=0.9pt, opacity=0.75] (0,0.1) circle (1.65);
  % Middle ring — oppression under a foreign power (2:14-15)
  \fill[DuskSlate, opacity=0.14] (0,0.1) circle (1.15);
  \draw[DuskSlate, line width=1.0pt, opacity=0.85] (0,0.1) circle (1.15);
  % Inner ring — the judge's torch-fire deliverance (2:16, 18)
  \fill[TorchOrange, opacity=0.22] (0,0.1) circle (0.55);
  \draw[TorchOrange, line width=1.0pt, opacity=0.9] (0,0.1) circle (0.55);
  \node[font=\tiny,color=ChapterIron] at (0,-0.65) {妥協中};
