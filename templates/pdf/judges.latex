% PubHub Judges Deep Study Template
% Professional Bible Study Book Layout
% Bilingual Chinese/English with Hebrew word studies
% Requires XeLaTeX for CJK support
% Series identity: Iron/Torch/Dusk palette — the recurring iron of foreign
% oppression (士師記反覆的壓迫), the torch-fire of God-given deliverance
% (基甸的三百人，7:16-20), and the moral dusk of "那時以色列中沒有王，
% 各人任意而行" (17:6; 21:25) that closes the book unresolved. Deliberately
% distinct from Isaiah's Throne/Coal, Acts's Flame/Ember, and Job's Ash/Storm/Dawn.
%
% Base: adapted from templates/pdf/job.latex (2026-09, itself descended from
% templates/pdf/acts.latex's 2026-08-31 editorial-pass structure:
% secnumdepth/tocdepth, chaptermark without an English "Chapter N." prefix,
% table/quote machinery) with the Hebrew-text handling, hyperxmp PDF metadata
% block, and microtype protrusion settings carried over from
% templates/pdf/isaiah.latex, whose Word Study sections are the closest
% precedent for this book's own heavy Hebrew use.
%
% NOTE on font bug fix (see .claude/skills/eat-bible/SKILL.md "Gotchas"):
% BoldFont=<Family> Bold pointing at a real separate bold font file silently
% weakens/flattens \textbf{} for CJK text containing full-width punctuation
% (：。), with zero warnings. Every font declaration below uses
% BoldFont=<same family>, BoldFeatures={FakeBold=N} instead of a real bold face.

% openright (not openany): every chapter opens on a recto (odd) page, the
% binding convention for a printed book. It costs a handful of blank versos;
% the copyright page declares this a printed 贈閱版, so print convention wins
% over saving screen pages. Switch back to openany for a screen-only edition.
\documentclass[11pt,openright]{book}

%% ============================================
%% FONT SETUP WITH CJK LINE BREAKING
%% ============================================
\usepackage{fontspec}

\setmainfont{Songti SC}[
  BoldFont=Songti SC,
  BoldFeatures={FakeBold=2.2},
  ItalicFont=Kaiti SC
]
\setsansfont{PingFang SC}[
  BoldFont=PingFang SC,
  BoldFeatures={FakeBold=2.0}
]
% CJK-safe monospace — never Menlo (zero CJK glyphs, silently renders blank boxes)
\setmonofont{PingFang SC}[
  BoldFont=PingFang SC,
  BoldFeatures={FakeBold=2.0}
]

%% Hebrew (and Greek, for occasional NT cross-references — e.g. Hebrews
%% 11:32's naming of Gideon, Barak, Samson and Jephthah) font support —
%% auto-switch for Unicode blocks. This book's Word Study sections use heavy
%% pointed Hebrew (שֹׁפְטִים, נָזִיר, judge/deliverer vocabulary throughout),
%% so both fixes below are load-bearing here, not just in principle.
\usepackage{ucharclasses}
\newfontfamily\greekfont{Times New Roman}[
  Script=Greek,
  BoldFont=Times New Roman,
  BoldFeatures={FakeBold=2.0}
]
% Scale=1.35: Times New Roman's Hebrew glyphs are drawn much smaller than its
% Latin ones and far smaller than Songti SC's CJK, so pointed Hebrew set at the
% nominal size renders with the nikkud crushed into an unreadable smudge — a
% pure legibility defect that produces zero warnings and a clean driver.sh run.
% Same fix, same reasoning, as templates/pdf/isaiah.latex.
\newfontfamily\hebrewfont{Times New Roman}[
  Script=Hebrew,
  Scale=1.35,
  BoldFont=Times New Roman,
  BoldFeatures={FakeBold=2.0}
]
% Latin runs keep Songti SC's own Latin glyphs — no visible change to upright
% text — but gain a REAL italic. \setmainfont cannot supply one: its
% ItalicFont is Kaiti SC, a Chinese brush face whose Latin glyphs are UPRIGHT,
% so every italicised commentary title in this book would otherwise render
% as roman with zero warnings.
\newfontfamily\latinrun{Songti SC}[
  ItalicFont={Times New Roman Italic},
  BoldFont=Songti SC,
  BoldFeatures={FakeBold=2.2},
  BoldItalicFont={Times New Roman Bold Italic}
]
\newfontfamily\cjkrun{Songti SC}[
  BoldFont=Songti SC,
  BoldFeatures={FakeBold=2.2},
  ItalicFont=Kaiti SC
]

%% ucharclasses: two independent traps, both silent.
%%
%% TRAP 1 — two APIs that look alike:
%%   \setTransitionsFor{<Block>}{in}{out}   3 args, a real Unicode BLOCK
%%   \setTransitionsFor<Group>{in}{out}     2 args, a class GROUP
%% "Greek" is a class GROUP, not a block — the block is GreekAndCoptic. Feeding
%% a group name (or a name that doesn't exist) to the 3-arg form compiles fine
%% and does nothing, so basic Greek/Hebrew would silently fall back to
%% Songti SC's own glyphs.
%%
%% TRAP 2 — \setTransitionsFor sets BOTH directions for every pair, so a later
%% declaration's out-code silently overwrites an earlier one's in-code:
%%     \setTransitionsFor{X}{in}{out}  ⇒  for every other class n
%%         \XeTeXinterchartoks n X = {in}      (entering X)
%%         \XeTeXinterchartoks X n = {out}     (leaving X)
%% Symptom: a Greek or Hebrew run whose PRECEDING character is CJK or
%% full-width punctuation (：、。） silently does not switch font.
%%
%% FIX: \setTransitionTo sets the entering direction ONLY, so nothing can
%% clobber anything and declaration order stops mattering.
%%
%% \uckeep carries the ambient series/shape across the boundary: a bare
%% \newfontfamily switch resets both to the family default, which drops
%% \emph and \textbf on a Latin run inside CJK prose.
\makeatletter
\newcommand{\uckeep}[1]{%
  \edef\uc@sh{\f@shape}\edef\uc@se{\f@series}%
  #1\fontshape{\uc@sh}\fontseries{\uc@se}\selectfont}
\makeatother
\newcommand{\ucLatinRun}{\uckeep{\latinrun}}
\newcommand{\ucCJKRun}{\uckeep{\cjkrun}}
\newcommand{\ucGreekRun}{\uckeep{\greekfont}}
\newcommand{\ucHebrewRun}{\uckeep{\hebrewfont}}
%% Every Unicode block this book actually contains (Hebrew Word Study boxes,
%% occasional Greek cross-references, CJK body text, full-width punctuation).
%% Anything not listed keeps the main font.
\setTransitionTo{BasicLatin}{\ucLatinRun}
\setTransitionTo{LatinSupplement}{\ucLatinRun}
\setTransitionTo{LatinExtendedA}{\ucLatinRun}
% LatinExtendedAdditional -> \ucTranslitRun is set further below, near the
% other transliteration-diacritic fixes; \ucLatinRun (Songti SC) lacks these
% glyphs entirely, see that comment for why.
\setTransitionTo{GreekAndCoptic}{\ucGreekRun}
\setTransitionTo{GreekExtended}{\ucGreekRun}
\setTransitionTo{Hebrew}{\ucHebrewRun}
\setTransitionTo{CJKUnifiedIdeographs}{\ucCJKRun}
\setTransitionTo{CJKUnifiedIdeographsExtensionA}{\ucCJKRun}
\setTransitionTo{CJKSymbolsAndPunctuation}{\ucCJKRun}
\setTransitionTo{HalfwidthAndFullwidthForms}{\ucCJKRun}
\setTransitionTo{GeneralPunctuation}{\ucCJKRun}
\setTransitionTo{BoxDrawing}{\ucCJKRun}
\setTransitionTo{Arrows}{\ucCJKRun}
\setTransitionTo{MathematicalOperators}{\ucCJKRun}
\setTransitionTo{GeometricShapes}{\ucCJKRun}
\setTransitionTo{MiscellaneousSymbols}{\ucCJKRun}
\setTransitionTo{SuperscriptsAndSubscripts}{\ucCJKRun}
\setTransitionTo{Dingbats}{\ucCJKRun}
\setTransitionTo{MiscellaneousSymbolsAndArrows}{\ucCJKRun}
\setTransitionTo{LetterlikeSymbols}{\ucCJKRun}
\setTransitionTo{EnclosedAlphanumerics}{\ucCJKRun}
\setTransitionTo{BlockElements}{\ucCJKRun}
\setTransitionTo{MiscellaneousTechnical}{\ucCJKRun}
\setTransitionTo{Hiragana}{\ucCJKRun}
\setTransitionTo{Katakana}{\ucCJKRun}
\setTransitionTo{CJKCompatibilityForms}{\ucCJKRun}
\setTransitionTo{SmallFormVariants}{\ucCJKRun}
\setTransitionTo{VerticalForms}{\ucCJKRun}
\setTransitionTo{MiscellaneousSymbolsAndPictographs}{\ucCJKRun}
\setTransitionTo{Emoticons}{\ucCJKRun}
\setTransitionTo{CombiningDiacriticalMarks}{\ucCJKRun}
\setTransitionTo{NumberForms}{\ucCJKRun}
\setTransitionTo{CurrencySymbols}{\ucCJKRun}

%% Semitic-transliteration diacritics (ḥesed U+1E25 "LatinExtendedAdditional",
%% tsade ṣ U+1E63 "LatinExtendedAdditional", ʿayin's modifier letter U+02BF
%% "SpacingModifierLetters") used throughout the Word Study sections.
%%
%% THE REAL BUG (found the hard way): ucharclasses' \XeTeXinterchartoks fires
%% on a character's Unicode class as XeTeX's own primitive lexer processes it,
%% which is NOT the same thing as, and fires AFTER, ordinary TeX font
%% selection — so it overrides ANY manual font switch for a block that has a
%% registered transition, including one from inside an explicit
%% `{\somefont ...}` group, and even for a character produced indirectly via
%% \symbol{<codepoint>} rather than typed literally. A \newunicodechar
%% attempt and a manual `{\translitfont ...}`-wrapping attempt both failed
%% against this for exactly that reason — there is no overriding
%% ucharclasses per-character from inside its own mapped blocks. The only
%% real fix is to make the BLOCK'S OWN mapping point at a font that has the
%% glyphs. IPAExtensions (used elsewhere in this book's Hebrew vowel-pointing
%% discussion) already worked fine going to \ucCJKRun and is left alone.
\newfontfamily\translitfont{Times New Roman}
\newcommand{\ucTranslitRun}{\uckeep{\translitfont}}
\setTransitionTo{SpacingModifierLetters}{\ucTranslitRun}
\setTransitionTo{LatinExtendedAdditional}{\ucTranslitRun}
\setTransitionTo{IPAExtensions}{\ucCJKRun}

%% Calligraphy brush font for cover/frontispiece accents
\newfontfamily\kaiti{Kaiti SC}[
  BoldFont=Kaiti SC,
  BoldFeatures={FakeBold=1.8}
]

%% Enable CJK line breaking - critical for Chinese text
\XeTeXlinebreaklocale "zh"
\XeTeXlinebreakskip = 0pt plus 1pt minus 0.1pt

%% ============================================
%% PAGE GEOMETRY - Fixed margins (more conservative)
%% ============================================
\usepackage{geometry}
\geometry{
  paperwidth=7in,
  paperheight=10in,
  top=0.75in,
  bottom=0.75in,
  inner=0.8in,
  outer=0.65in,
  marginparwidth=0in,
  marginparsep=0in
}

%% ============================================
%% LINE AND PARAGRAPH SPACING
%% ============================================
\linespread{1.1}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.3em}

%% ============================================
%% COLOR SCHEME - Judges identity: iron oppression → torch-fire deliverance → moral dusk
%% ============================================
\usepackage{xcolor}

% Primary colors
\definecolor{ChapterIron}{RGB}{92,82,72}        % Iron — the recurring instrument of
                                                 % foreign oppression each cycle
                                                 % opens with (3:8 米所波大米,
                                                 % 4:3 九百輛鐵車) — replaces
                                                 % Job's ChapterAsh / Acts's
                                                 % ChapterFlame / Isaiah's
                                                 % ThroneCrimson everywhere
                                                 % structural: chapter titles,
                                                 % headers, rules
\definecolor{ScriptureGold}{RGB}{165,125,55}    % Gold for scripture refs (series-shared, unchanged)
\definecolor{CommentaryBrown}{RGB}{85,60,45}    % Warm brown for commentary (series-shared, unchanged)

% Cool accent — the moral dusk that closes the book: "那時以色列中沒有王，
% 各人任意而行" (17:6; 21:25)
\definecolor{DuskSlate}{RGB}{48,68,88}

% Warm accent — the torch-fire of God-given deliverance (基甸的三百人，
% 火把與角聲，7:16-20)
\definecolor{TorchOrange}{RGB}{198,110,42}

% Box colors
\definecolor{ScriptureBg}{RGB}{252,250,245}     % Cream for scripture boxes
\definecolor{HebrewBg}{RGB}{253,247,240}        % Warm cream for Hebrew word studies
\definecolor{ApplicationBg}{RGB}{248,252,248}   % Light green for application

% Text colors
\definecolor{TextGray}{RGB}{50,50,50}
\definecolor{LightGray}{RGB}{120,120,120}

% Judges is not a Gospel: there is no "red letter" convention to carry over
% from Acts's \jesus{} macro. The book's own dialogue and battle narratives
% are set in the ordinary body style, distinguished by heading and context
% alone, not by a dedicated color macro.

%% ============================================
%% MATH AND SYMBOLS
%% ============================================
\usepackage{amssymb}
\usepackage{amsmath}

%% ============================================
%% GRAPHICS AND TIKZ FOR DIAGRAMS
%% ============================================
\usepackage{graphicx}
\usepackage{tikz}
\usetikzlibrary{shapes,arrows,arrows.meta,positioning,fit,backgrounds,calc,decorations.pathmorphing}

%% ============================================
%% TIKZ COMMANDS FOR DECORATIONS
%% ============================================

% Vine decoration command
\newcommand{\vinedecor}[1]{%
\begin{tikzpicture}[scale=0.6]
  \draw[color=ScriptureGold,line width=0.8pt,decorate,decoration={snake,amplitude=1pt,segment length=8pt}]
    (0,0) -- (#1,0);
  \foreach \x in {0.3,0.8,1.3,1.8,2.3} {
    \draw[color=ScriptureGold,line width=0.5pt] (\x,0) .. controls (\x+0.1,0.15) and (\x+0.2,0.15) .. (\x+0.25,0.05);
  }
\end{tikzpicture}%
}

% Cross decoration
\newcommand{\crosssymbol}{%
\begin{tikzpicture}[scale=0.15]
  \draw[color=ScriptureGold,line width=1.5pt] (0,-1) -- (0,1);
  \draw[color=ScriptureGold,line width=1.5pt] (-0.6,0.4) -- (0.6,0.4);
\end{tikzpicture}%
}

%% ============================================
%% HYPERLINKS
%% ============================================
% Micro-typography for the Latin/English runs: character protrusion pulls
% punctuation and light letterforms slightly into the margin so the right edge
% reads optically straight. expansion=false deliberately — font expansion
% re-renders glyphs at scaled widths, which xdvipdfmx applies unevenly to the
% CJK TrueType faces; protrusion alone is the safe half and is where most of
% the visible gain is. Same setting as templates/pdf/isaiah.latex, verified
% against this exact font stack (Songti SC + FakeBold + Times New Roman Hebrew).
\usepackage[protrusion=true,expansion=false]{microtype}

\usepackage{hyperref}
% hyperxmp turns the hypersetup keys below into a real XMP packet. Without it
% `pdfinfo` reports "Metadata Stream: no": the document properties exist only
% in the legacy /Info dictionary, which modern cataloguing, DAM and preflight
% tools increasingly ignore. Must load after hyperref.
\usepackage{hyperxmp}
\hypersetup{
  colorlinks=true,
  linkcolor=ChapterIron,
  urlcolor=ScriptureGold,
  bookmarks=true,
  bookmarksnumbered=true,
  % Document properties. Without these `pdfinfo` reports no Title/Author/
  % Subject at all: the file shows as its filename in a reader's title bar,
  % in a library catalogue, and in any DMS that indexes PDF metadata.
  % pdflang additionally tells a screen reader and the hyphenation engine
  % that the primary language is Traditional Chinese.
  pdftitle={$title$$if(subtitle)$ — $subtitle$$endif$},
  pdfauthor={$author$},
  pdfsubject={士師記逐章研讀：沒有王的時代——一圈一圈的循環，指向那位真正的王},
  pdfkeywords={士師記, Judges, 循環, 士師, 基甸, 參孫, 底波拉, 耶弗他, 聖經研讀, Bible Study, 和合本, NASB, 查經},
  pdfcreator={XeLaTeX + pandoc (PubHub 三書精讀出版系統)},
  pdflang={zh-TW}
}

%% ============================================
%% TABLES - with proper width control
%% ============================================
\usepackage{longtable}
\usepackage{booktabs}
\usepackage{array}
\usepackage{tabularx}
\usepackage{calc}

% Set table width to text width - constrain tables
\setlength{\LTleft}{0pt}
\setlength{\LTright}{0pt}
\setlength{\LTpre}{6pt}
\setlength{\LTpost}{6pt}
\renewcommand{\arraystretch}{1.2}

% Pandoc 3.x table support
\usepackage{etoolbox}
\makeatletter
\patchcmd\longtable{\par}{\if@noskipsec\mbox{}\fi\par}{}{}
\@ifundefined{c@none}{\newcounter{none}}{}
\makeatother
% Word-study / cross-reference tables carry dense CJK + Hebrew; \small keeps
% long 註解 cells from wrapping to a few characters per line (same fix as
% templates/pdf/isaiah.latex and templates/pdf/gospel-of-luke.latex).
\AtBeginEnvironment{longtable}{\small}

% Style table rules
\renewcommand{\toprule}{\hline\hline}
\renewcommand{\midrule}{\hline}
\renewcommand{\bottomrule}{\hline\hline}

%% ============================================
%% HEADERS AND FOOTERS
%% ============================================
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE,RO]{\small\thepage}
\fancyhead[LO]{\small\itshape\color{LightGray}\nouppercase{\rightmark}}
\fancyhead[RE]{\small\itshape\color{LightGray}\nouppercase{\leftmark}}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{ScriptureGold}\leaders\hrule height \headrulewidth\hfill}}
\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyfoot[C]{\small\thepage}
  \renewcommand{\headrulewidth}{0pt}
}
% \cleardoublepage's inserted blank verso must be truly blank. fancyhdr's
% \pagestyle{fancy} otherwise prints the folio on it, so an openright blank
% came out bearing a lone page number — the one thing a blank leaf must not
% carry. Same patch as templates/pdf/isaiah.latex.
\makeatletter
\def\cleardoublepage{\clearpage\if@twoside
  \ifodd\c@page\else\hbox{}\thispagestyle{empty}\newpage\fi\fi}
\makeatother

%% ============================================
%% SECTION STYLING (manual, without titlesec)
%% ============================================
% Clean running heads: raw chapter/section title only, no "Chapter N." auto-label.
% Kept in parity with templates/pdf/acts.latex's 2026-08-31 pass: secnumdepth
% is set here (in the preamble, alongside the chapter styling it governs);
% tocdepth is set later, immediately before \tableofcontents — see that block
% below for why the split placement matters.
\renewcommand{\chaptermark}[1]{\markboth{#1}{#1}}
\renewcommand{\sectionmark}[1]{\markright{#1}}
\setcounter{secnumdepth}{-1}
\makeatletter
% \chapter* (every {.unnumbered} heading: preface, volume dividers, appendices,
% afterword) never calls \chaptermark, so the running head keeps whatever the
% last NUMBERED chapter set — the preface/appendices would print under
% chapter 21's title, and the orientation chapters under "Contents" left by
% \tableofcontents. Same patch as templates/pdf/job.latex.
\let\pubhub@orig@schapter\@schapter
\def\@schapter#1{\pubhub@orig@schapter{#1}\markboth{#1}{#1}}
\makeatother
\makeatletter
% Chapter styling
\def\@makechapterhead#1{%
  \vspace*{15pt}%
  {\parindent \z@ \raggedright \normalfont
    \ifnum \c@secnumdepth >\m@ne
      \large\bfseries\color{ChapterIron} \@chapapp\space \thechapter
      \par\nobreak
      \vskip 8pt
    \fi
    \interlinepenalty\@M
    \LARGE \bfseries\color{ChapterIron} #1\par\nobreak
    \vskip 12pt
    {\color{ScriptureGold}\hrule height 1.5pt}
    \vskip 15pt
  }}
\def\@makeschapterhead#1{%
  \vspace*{15pt}%
  {\parindent \z@ \raggedright
    \normalfont
    \interlinepenalty\@M
    \LARGE \bfseries\color{ChapterIron} #1\par\nobreak
    \vskip 8pt
    {\color{ScriptureGold}\hrule height 1.5pt}
    \vskip 15pt
  }}

% Section styling
\renewcommand\section{\@startsection {section}{1}{\z@}%
  {-2.5ex \@plus -0.5ex \@minus -.2ex}%
  {1.5ex \@plus.2ex}%
  {\normalfont\large\bfseries\color{ChapterIron}}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}%
  {-2ex\@plus -0.5ex \@minus -.2ex}%
  {1ex \@plus .2ex}%
  {\normalfont\normalsize\bfseries\color{CommentaryBrown}}}
\renewcommand\subsubsection{\@startsection{subsubsection}{3}{\z@}%
  {-1.5ex\@plus -0.5ex \@minus -.2ex}%
  {0.8ex \@plus .2ex}%
  {\normalfont\normalsize\bfseries\color{TextGray}}}
\makeatother

%% ============================================
%% BLOCKQUOTE STYLING - extra room for CJK text
%% ============================================
\renewenvironment{quote}{%
  \par\vspace{0.3\baselineskip}%
  \list{}{%
    \leftmargin=0.5em
    \rightmargin=0.2em
    \parsep=0pt
    \itemsep=0pt
  }%
  \item\relax
  \small\color{TextGray}%
}{%
  \endlist
  \par\vspace{0.3\baselineskip}%
}

%% ============================================
%% WIDOW/ORPHAN AND LINE BREAKING - aggressive for CJK
%% ============================================
\widowpenalty=10000
\clubpenalty=10000
\tolerance=9999
\emergencystretch=6em
\hyphenpenalty=50
\exhyphenpenalty=50
\sloppy
\hbadness=10000
\hfuzz=2pt

%% ============================================
%% METADATA
%% ============================================
$if(title)$
\title{$title$}
$endif$
$if(author)$
\author{$author$}
$endif$
$if(date)$
\date{$date$}
$else$
\date{\today}
$endif$

%% ============================================
%% PANDOC COMPATIBILITY
%% ============================================
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

