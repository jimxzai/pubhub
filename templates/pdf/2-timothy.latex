{\normalsize Structure of 2 Timothy}

\vspace{0.4cm}

% Elder Wong's Four Points of Fulfilling Ministry
\begin{tikzpicture}[scale=0.55,transform shape]
  \node[font=\footnotesize\bfseries,color=ChapterBlue] at (7,3.6) {盡職四大點 Four Points of Fulfilling Ministry};
  \node[font=\tiny,color=LightGray] at (7,3.1) {黃長老查經筆記 · Elder Wong's Teaching Framework};

  \node[draw=ScriptureGold,fill=ScriptureBg,rounded corners,minimum width=4cm,minimum height=1.6cm,align=center,font=\small] at (0,1.5) {\textbf{①} \\ 恩賜挑旺起來 \\ {\tiny 2 Tim 1:6}};
  \node[draw=ScriptureGold,fill=ScriptureBg,rounded corners,minimum width=4cm,minimum height=1.6cm,align=center,font=\small] at (4.7,1.5) {\textbf{②} \\ 善道靠聖靈守住 \\ {\tiny 2 Tim 1:14}};
  \node[draw=ScriptureGold,fill=ScriptureBg,rounded corners,minimum width=4cm,minimum height=1.6cm,align=center,font=\small] at (9.4,1.5) {\textbf{③} \\ 恩典上剛強 \\ {\tiny 2 Tim 2:1}};
  \node[draw=ScriptureGold,fill=ScriptureBg,rounded corners,minimum width=4cm,minimum height=1.6cm,align=center,font=\small] at (14.1,1.5) {\textbf{④} \\ 無愧的工人按正意分解 \\ {\tiny 2 Tim 2:15}};

  \draw[->,thick,color=ChapterBlue] (2.1,1.5) -- (2.6,1.5);
  \draw[->,thick,color=ChapterBlue] (6.8,1.5) -- (7.3,1.5);
  \draw[->,thick,color=ChapterBlue] (11.5,1.5) -- (12,1.5);
\end{tikzpicture}

\vspace{0.35cm}

% Four generations diagram (2:2)
\begin{tikzpicture}[scale=0.6,transform shape]
  \node[font=\footnotesize\bfseries,color=ChapterBlue] at (5,2) {四代傳承 Four Generations of Discipleship (2:2)};

  \foreach \x/\txt in {
    0/保羅,
    3.3/提摩太,
    6.6/忠心能教導人者,
    10/別人
  } {
    \node[draw=ChapterBlue,fill=ChapterBlue!8,rounded corners,minimum width=2.6cm,minimum height=1cm,font=\tiny] at (\x,0.5) {\txt};
  }
  \draw[->,thick,color=ScriptureGold] (1.4,0.5) -- (1.9,0.5);
  \draw[->,thick,color=ScriptureGold] (4.7,0.5) -- (5.2,0.5);
  \draw[->,thick,color=ScriptureGold] (8.4,0.5) -- (8.9,0.5);
\end{tikzpicture}

\vspace{0.35cm}

% Four-part structure
\begin{tikzpicture}[scale=0.9]
  % Part 1
  \node[draw=ChapterBlue,fill=ChapterBlue!10,rounded corners,minimum width=3cm,minimum height=2cm] at (0,0) {};
  \node[font=\small\bfseries,color=ChapterBlue] at (0,0.5) {Ch.1 勉勵};
  \node[font=\footnotesize,color=TextGray] at (0,0) {不以福音為恥};
  \node[font=\tiny,color=LightGray] at (0,-0.5) {1:1-18};

  % Part 2
  \node[draw=ScriptureGold,fill=ScriptureGold!10,rounded corners,minimum width=3cm,minimum height=2cm] at (4,0) {};
  \node[font=\small\bfseries,color=ScriptureGold!80!black] at (4,0.5) {Ch.2 忠心};
  \node[font=\footnotesize,color=TextGray] at (4,0) {精兵的榜樣};
  \node[font=\tiny,color=LightGray] at (4,-0.5) {2:1-26};

  % Part 3
  \node[draw=OldCovenantRed,fill=OldCovenantRed!10,rounded corners,minimum width=3cm,minimum height=2cm] at (8,0) {};
  \node[font=\small\bfseries,color=OldCovenantRed] at (8,0.5) {Ch.3 警戒};
  \node[font=\footnotesize,color=TextGray] at (8,0) {末世的危險};
  \node[font=\tiny,color=LightGray] at (8,-0.5) {3:1-17};

  % Part 4
  \node[draw=NewCovenantGreen,fill=NewCovenantGreen!10,rounded corners,minimum width=3cm,minimum height=2cm] at (12,0) {};
  \node[font=\small\bfseries,color=NewCovenantGreen!80!black] at (12,0.5) {Ch.4 囑咐};
  \node[font=\footnotesize,color=TextGray] at (12,0) {最後的話};
  \node[font=\tiny,color=LightGray] at (12,-0.5) {4:1-22};

  % Arrows
  \draw[->,thick,color=ScriptureGold] (1.6,0) -- (2.4,0);
  \draw[->,thick,color=ScriptureGold] (5.6,0) -- (6.4,0);
  \draw[->,thick,color=ScriptureGold] (9.6,0) -- (10.4,0);
\end{tikzpicture}

