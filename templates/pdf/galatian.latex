\vspace*{0.3cm}
{\Large\bfseries\color{ChapterBlue} 加拉太書結構}\\[0.1cm]
{\normalsize Structure of Galatians}

\vspace{0.6cm}

% Three-part structure — the book's own shape: defense, doctrine, life
\begin{tikzpicture}[scale=0.82,transform shape]
  \node[draw=ChapterBlue,fill=ChapterBlue!8,rounded corners,minimum width=4.0cm,minimum height=2.1cm,align=center,font=\normalsize] at (0,0) {\textbf{申辯} \\ Defense \\ {\small 1:1-2:21}};
  \node[draw=ScriptureGold,fill=ScriptureGold!14,rounded corners,minimum width=4.0cm,minimum height=2.1cm,align=center,font=\normalsize] at (4.6,0) {\textbf{教義} \\ Doctrine \\ {\small 3:1-4:31}};
  \node[draw=NewCovenantGreen,fill=NewCovenantGreen!10,rounded corners,minimum width=4.0cm,minimum height=2.1cm,align=center,font=\normalsize] at (9.2,0) {\textbf{生活} \\ Life \\ {\small 5:1-6:18}};

  \draw[->,thick,color=ChapterBlue] (2.05,0) -- (2.55,0);
  \draw[->,thick,color=ChapterBlue] (6.65,0) -- (7.15,0);
\end{tikzpicture}

\vspace{0.5cm}

{\footnotesize\color{LightGray} 我所傳的福音是何等的福音 · 我所信的道理是何等的道理 · 我所活的自由是何等的自由}

\vspace{0.6cm}

{\footnotesize\color{LightGray} 啟示的次序 · The Order of Revelation}

\vspace{0.25cm}

% Revelation-order chain — the promise-before-law argument that is
% Galatians' own spine (3:15-4:7), traced in five steps.
\begin{tikzpicture}[scale=0.82,transform shape]
  \foreach \x/\lab in {0/{應許\\創15}, 3.0/{律法\\出19}, 6.0/{時候滿足\\加4:4}, 9.0/{兒子名分\\加4:5-6}, 12.0/{聖靈果子\\加5:22}} {
    \fill[ScriptureGold] (\x,0) circle (0.2);
    \node[font=\footnotesize,color=TextGray,align=center] at (\x,-0.7) {\lab};
  }
  \draw[ScriptureGold,line width=1.2pt] (0.2,0) -- (2.8,0);
  \draw[ScriptureGold,line width=1.2pt] (3.2,0) -- (5.8,0);
  \draw[ScriptureGold,line width=1.2pt] (6.2,0) -- (8.8,0);
  \draw[ScriptureGold,line width=1.2pt] (9.2,0) -- (11.8,0);
\end{tikzpicture}

\vspace{0.9cm}

