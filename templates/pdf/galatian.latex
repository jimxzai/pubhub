\usepackage{xcolor}

% Primary colors - "freedom from bondage" theme: deep wine/burgundy (the
% cross, Gal 3:13 "cursed") + aged brass (the same gold family used across
% this series' Pauline volumes, macro names kept for cross-template compatibility)
\definecolor{ChapterBlue}{RGB}{110,24,32}         % Deep burgundy — Galatians theme (macro name kept for compatibility)
\definecolor{ScriptureGold}{RGB}{155,120,60}      % Aged brass for scripture refs / ornaments
\definecolor{CommentaryBrown}{RGB}{58,52,48}      % Warm charcoal for commentary, tuned to sit with burgundy

% Box colors
\definecolor{ScriptureBg}{RGB}{248,249,252}       % Cool cream for scripture boxes
\definecolor{GreekBg}{RGB}{245,246,251}           % Faint blue-grey for Greek
\definecolor{ApplicationBg}{RGB}{246,248,250}     % Light slate for application

% Text colors
\definecolor{TextGray}{RGB}{50,50,50}
\definecolor{LightGray}{RGB}{120,120,120}

% Diagram colors
\definecolor{OldCovenantRed}{RGB}{150,40,40}      % Warning / conflict
\definecolor{NewCovenantGreen}{RGB}{70,110,70}    % Grace / growth

