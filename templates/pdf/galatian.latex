%% ============================================
%% TIKZ COMMANDS FOR DECORATIONS
%% ============================================

% Cross decoration
\newcommand{\crosssymbol}{%
\begin{tikzpicture}[scale=0.15]
  \draw[color=ScriptureGold,line width=1.5pt] (0,-1) -- (0,1);
  \draw[color=ScriptureGold,line width=1.5pt] (-0.6,0.4) -- (0.6,0.4);
\end{tikzpicture}%
}

% Classical printer's-ornament divider: thin rule — fleuron — thin rule,
% for a more antique-book feel.
\newcommand{\ornamentdivider}[1][2in]{%
  {\color{ScriptureGold}\rule{#1}{0.4pt}}\hspace{0.15cm}%
  \raisebox{-0.22cm}{\pgfornament[width=0.5cm,color=ScriptureGold]{88}}%
  \hspace{0.15cm}{\color{ScriptureGold}\rule{#1}{0.4pt}}%
}

% A single small fleuron (no rules), used standalone on the full-bleed
% cover pages and the dedication/colophon pages.
\newcommand{\fleuron}[1][ScriptureGold]{%
  \pgfornament[width=0.55cm,color=#1]{88}%
}

% Classical double-rule (hairline) frame — replaces solid fcolorbox fills
% with a manuscript/antique-book-plate style surround.
\newcommand{\classicalframe}[1]{%
\begin{tikzpicture}
  \node[fill=ScriptureBg,inner sep=14pt] (box) {#1};
  \draw[color=ScriptureGold,line width=0.4pt] ($$(box.south west)+(-3pt,-3pt)$$) rectangle ($$(box.north east)+(3pt,3pt)$$);
  \draw[color=ScriptureGold,line width=0.4pt] ($$(box.south west)+(-6pt,-6pt)$$) rectangle ($$(box.north east)+(6pt,6pt)$$);
\end{tikzpicture}%
}

% Laurel-wreath-and-cross symbol — two laurel branches curving inward
% (echoing Roman imperial imagery and Romans 8:37 "more than conquerors")
% with a small cross at the top center. Simple line-drawing style,
% consistent with the file's other minimalist gold TikZ ornaments.
\newcommand{\laurelcrosssymbol}{%
\begin{tikzpicture}[scale=0.2]
  % small cross at top center
  \draw[color=ScriptureGold,line width=1pt] (0,0.55) -- (0,1.15);
  \draw[color=ScriptureGold,line width=1pt] (-0.22,0.95) -- (0.22,0.95);
  % left laurel branch — a curved spine with short leaf strokes
  \draw[color=ScriptureGold,line width=0.9pt]
    (-0.15,0.5) .. controls (-0.55,0.35) and (-0.75,0.0) .. (-0.7,-0.6);
  \draw[color=ScriptureGold,line width=0.7pt] (-0.25,0.42) -- (-0.45,0.55);
  \draw[color=ScriptureGold,line width=0.7pt] (-0.4,0.22) -- (-0.62,0.32);
  \draw[color=ScriptureGold,line width=0.7pt] (-0.55,-0.02) -- (-0.78,0.06);
  \draw[color=ScriptureGold,line width=0.7pt] (-0.65,-0.28) -- (-0.9,-0.22);
  \draw[color=ScriptureGold,line width=0.7pt] (-0.7,-0.55) -- (-0.96,-0.52);
  % right laurel branch — mirror
  \draw[color=ScriptureGold,line width=0.9pt]
    (0.15,0.5) .. controls (0.55,0.35) and (0.75,0.0) .. (0.7,-0.6);
  \draw[color=ScriptureGold,line width=0.7pt] (0.25,0.42) -- (0.45,0.55);
  \draw[color=ScriptureGold,line width=0.7pt] (0.4,0.22) -- (0.62,0.32);
  \draw[color=ScriptureGold,line width=0.7pt] (0.55,-0.02) -- (0.78,0.06);
  \draw[color=ScriptureGold,line width=0.7pt] (0.65,-0.28) -- (0.9,-0.22);
  \draw[color=ScriptureGold,line width=0.7pt] (0.7,-0.55) -- (0.96,-0.52);
\end{tikzpicture}%
}

%% ============================================
%% FULL-BLEED COVER MACHINERY (front/back cover only)
%% ============================================
\usepackage{eso-pic}
\usepackage{lettrine}

% Burgundy gradient for the full-bleed cover background — deep wine to a
% lighter oxblood, full-bleed. `shading angle` requires a reasonably recent
% pgf; this TeX Live 2026 install supports it, but the plain two-color
% left-right shade is kept in a comment as the documented fallback.
\definecolor{NavyDeep}{RGB}{38,10,14}
\definecolor{NavyLight}{RGB}{92,28,34}
\newcommand{\CoverBackground}{%
  \AddToShipoutPictureBG*{%
    \begin{tikzpicture}[remember picture,overlay]
      \shade[shading angle=115, left color=NavyDeep, right color=NavyLight]
        (current page.south west) rectangle (current page.north east);
    \end{tikzpicture}%
  }%
}
% Fallback (uncomment if `shading angle` errors on a different TeX Live):
% \newcommand{\CoverBackground}{%
%   \AddToShipoutPictureBG*{%
%     \begin{tikzpicture}[remember picture,overlay]
%       \shade[left color=NavyDeep, right color=NavyLight]
%         (current page.south west) rectangle (current page.north east);
%     \end{tikzpicture}%
%   }%
% }

% Classical book-plate border: two inset hairlines plus a small corner
% ornament at each corner, painted in the foreground hook (after page
% content) using the page's own bounding box.
\newcommand{\CoverBorder}{%
  \AddToShipoutPictureFG*{%
    \begin{tikzpicture}[remember picture,overlay]
      \draw[color=ScriptureGold,line width=0.5pt]
        ($$(current page.south west)+(0.45in,0.45in)$$) rectangle ($$(current page.north east)-(0.45in,0.45in)$$);
      \draw[color=ScriptureGold,line width=0.4pt]
        ($$(current page.south west)+(0.52in,0.52in)$$) rectangle ($$(current page.north east)-(0.52in,0.52in)$$);
      \node[color=ScriptureGold] at ($$(current page.south west)+(0.55in,0.55in)$$) {\pgfornament[width=0.45cm,color=ScriptureGold]{88}};
      \node[color=ScriptureGold,rotate=90] at ($$(current page.north west)+(0.55in,-0.55in)$$) {\pgfornament[width=0.45cm,color=ScriptureGold]{88}};
      \node[color=ScriptureGold,rotate=-90] at ($$(current page.south east)+(-0.55in,0.55in)$$) {\pgfornament[width=0.45cm,color=ScriptureGold]{88}};
      \node[color=ScriptureGold,rotate=180] at ($$(current page.north east)+(-0.55in,-0.55in)$$) {\pgfornament[width=0.45cm,color=ScriptureGold]{88}};
    \end{tikzpicture}%
  }%
}

% A small consistent publisher's device, reused on the half-title page,
% the front cover, and the closing colophon page.
\newcommand{\publishersmark}[1][ScriptureGold]{%
  \pgfornament[width=0.4cm,color=#1]{38}%
}

% Light-on-dark cover text colors (defined once, used on both covers)
\definecolor{CoverCream}{RGB}{242,236,222}
\definecolor{CoverGoldBright}{RGB}{198,163,92}
\definecolor{CoverMuted}{RGB}{188,183,166}

%% ============================================
%% SECTION NUMBERING
%% ============================================
% A devotional study book's sections are named (經文/背景/原文研讀/…), not
% numbered — without this, every H2/H3 prints as "8.6.1 領受要點" and the TOC
% turns into an outline of a technical manual.
\setcounter{secnumdepth}{0}

%% Page-referenced Scripture index. Loaded before hyperref's own setup below
%% so index page numbers become links too. `intoc` puts the index in the TOC.
\usepackage{imakeidx}
\makeindex[name=scripture,
           title={經文索引 (Scripture Index)},
           columns=2,
           intoc]

%% ============================================
%% HYPERLINKS
%% ============================================
\usepackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=ChapterBlue,
  urlcolor=ScriptureGold,
  bookmarks=true,
  bookmarksnumbered=true,
  pdftitle={加拉太書研讀},
  pdfauthor={PubHub 三書精讀系統},
  pdfsubject={Galatians Deep Study},
  pdflang={zh-TW}
}

