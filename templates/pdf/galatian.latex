\begin{tikzpicture}[scale=0.9,transform shape]
  \foreach \x/\ref in {0/1:8-9,2.8/2:20,5.6/3:13,8.4/3:28,11.2/5:1,14.0/6:14} {
    \fill[ScriptureGold] (\x,0) circle (0.22);
    \node[font=\footnotesize,color=TextGray,align=center] at (\x,-0.55) {\ref};
