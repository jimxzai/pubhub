% ===== THREE CONCENTRIC ZONES: LOVE / BETROTHAL / LAWSUIT =====
\begin{tikzpicture}[scale=0.85, transform shape]
  % Outer zone - the lawsuit (4:1)
  \fill[AshClay, opacity=0.16] (0,0.1) circle (1.65);
