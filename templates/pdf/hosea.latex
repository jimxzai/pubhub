%% ============================================
%% FRONTISPIECE - "全書一句話" built on Hosea 11:8: the heart that turns over
%% in God before it turns in the people.
%% ============================================
\thispagestyle{empty}
\begin{center}
\vspace*{0.3in}

\begin{tikzpicture}
  \draw[ScriptureGold, line width=0.8pt] (-2.8,0) -- (-0.55,0);
  \fill[ScriptureGold] (0,0) circle (0.055);
  \draw[ScriptureGold, line width=0.8pt] (0.55,0) -- (2.8,0);
