  \draw[ChapterStone, line width=1.0pt, opacity=0.9] (0,0.1) circle (0.55);
  \node[font=\tiny,color=ChapterStone] at (0,0.1) {甘心愛};
  \node[font=\tiny,color=AlmondRose!80!black] at (0,0.95) {聘約};
  \node[font=\tiny,color=AshClay!80!black]  at (0,1.42) {訴訟};
