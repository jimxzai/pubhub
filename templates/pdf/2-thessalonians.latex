% Two Revelations diagram page — 1:7 against 2:3-9 (SBLGNT word counts,
% see the Greek vocabulary appendix)
\thispagestyle{empty}
\begin{center}
\vspace*{0.5cm}
{\Large\bfseries\color{ChapterGreen} 兩個「顯現」}\\[0.1cm]
{\normalsize Two Revelations: the Lord and the Counterfeit}

\vspace{0.8cm}

\begin{tikzpicture}[scale=0.9]
  \node[font=\large\bfseries,color=ChapterGreen] at (-3.3,4.2) {主耶穌 the Lord Jesus};
  \node[font=\large\bfseries,color=ChapterGreen] at (3.3,4.2) {不法的人 the Lawless One};

  % NOTE: `text=` (not `color=`) after `fill=` -- see james.latex: `color`
  % is a meta-key that would repaint the fill and hide the label.
  \node[draw=ChapterGreen,fill=ScriptureBg,rounded corners,minimum width=5cm,minimum height=0.9cm,font=\small,text=TextGray,align=center] at (-3.3,3) {顯現 ἀποκάλυψις\\1:7};
  \node[draw=ChapterGreen,fill=ScriptureBg,rounded corners,minimum width=5cm,minimum height=0.9cm,font=\small,text=TextGray,align=center] at (3.3,3) {顯露 ἀποκαλύπτω\\2:3, 6, 8};

  \node[draw=ChapterGreen,fill=ScriptureBg,rounded corners,minimum width=5cm,minimum height=0.9cm,font=\small,text=TextGray,align=center] at (-3.3,1.7) {降臨 παρουσία\\2:1, 8};
  \node[draw=ChapterGreen,fill=ScriptureBg,rounded corners,minimum width=5cm,minimum height=0.9cm,font=\small,text=TextGray,align=center] at (3.3,1.7) {來 παρουσία\\2:9};

  \node[draw=ChapterGreen,fill=ScriptureBg,rounded corners,minimum width=5cm,minimum height=0.9cm,font=\small,text=TextGray,align=center] at (-3.3,0.4) {在聖徒身上得榮耀\\1:10, 12};
