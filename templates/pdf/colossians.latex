%% ============================================
%% TIKZ COMMANDS FOR DECORATIONS
%% ============================================

% Crown/royal decoration command (supremacy of Christ)
\newcommand{\crownline}[1]{%
\begin{tikzpicture}[scale=0.6]
  \draw[color=ChapterPurple,line width=0.8pt,decorate,decoration={snake,amplitude=0.5pt,segment length=6pt}]
    (0,0) -- (#1,0);
\end{tikzpicture}%
}

% Star decoration
\newcommand{\starsymbol}{%
\begin{tikzpicture}[scale=0.12]
  \foreach \i in {0,72,...,288} {
    \draw[color=ScriptureGold,line width=1pt] (0,0) -- (\i:1);
  }
\end{tikzpicture}%
}

