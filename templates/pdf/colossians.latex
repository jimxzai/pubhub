\begin{tikzpicture}[every node/.style={align=center, inner sep=5pt}]
  \node[font=\footnotesize\bfseries,color=FullnessTeal] at (3.3,2.1) {六種身分 · 一位主 Six Roles · One Lord};

  \node[draw=ChapterPurple,thick,fill=DiagramLilac,rounded corners,font=\scriptsize] (n1) at (0,1.1) {妻子／丈夫\\Wife / Husband};
  \node[draw=ChapterPurple,thick,fill=DiagramLilac,rounded corners,font=\scriptsize] (n2) at (3.3,1.1) {兒女／父親\\Children / Father};
  \node[draw=ChapterPurple,thick,fill=DiagramLilac,rounded corners,font=\scriptsize] (n3) at (6.6,1.1) {僕人／主人\\Servant / Master};

  \draw[->,ScriptureGold,thick] (n1.south) -- ++(0,-0.5);
  \draw[->,ScriptureGold,thick] (n2.south) -- ++(0,-0.5);
  \draw[->,ScriptureGold,thick] (n3.south) -- ++(0,-0.5);

  \node[draw=ScriptureGold,thick,fill=ScriptureBg,rounded corners,text width=7.2cm,font=\small\bfseries,text=ChapterPurple] at (3.3,-0.4) {「你們所事奉的乃是主基督」 3:24};
\end{tikzpicture}

\vspace{0.6cm}

% Disarmed Powers - the cross
{\large\bfseries\color{ChapterPurple} 十架擄掠 The Cross Disarms the Powers (2:13-15)}

\vspace{0.3cm}

\begin{tikzpicture}
  % Cross
  \draw[CommentaryBrown,line width=4pt] (0,0) -- (0,3.4);
  \draw[CommentaryBrown,line width=4pt] (-1.1,2.3) -- (1.1,2.3);

  % Debt certificate nailed
  \fill[DiagramCream] (-2.5,1.95) rectangle (-1.2,2.65);
  \draw[ScriptureGold,line width=0.8pt] (-2.5,1.95) rectangle (-1.2,2.65);
  \node[font=\tiny,color=CommentaryBrown,align=center] at (-1.85,2.3) {字據\\cheirographon};

  % Disarmed powers scattering
  \foreach \x/\y/\a in {2.6/2.9/20, 3.0/1.9/-15, 2.5/1.0/40} {
    \draw[FullnessTeal,line width=0.8pt,rotate around={\a:(\x,\y)}] (\x-0.3,\y) -- (\x+0.3,\y);
    \draw[FullnessTeal,line width=0.8pt,rotate around={\a:(\x,\y)}] (\x,\y-0.3) -- (\x,\y+0.3);
  }
  \node[font=\tiny,color=FullnessTeal,align=left] at (4.4,1.9) {執政掌權者\\被公開示眾\\誇勝\\\textit{edeigmatisen}};

  \node[font=\tiny,color=LightGray] at (0.5,-0.5) {塗抹了在律例上所寫、攻擊我們、有礙於我們的字據};
\end{tikzpicture}

