\chapter*{附錄二：主題索引 (Appendix B: Key Themes Index)}
\addcontentsline{toc}{chapter}{附錄二：主題索引 (Appendix B: Key Themes Index)}
\markboth{}{}

\section*{基督論 Christology}

{\small
\begin{tabular}{@{}p{4.3cm}p{7.7cm}@{}}
\toprule
神的像 Image of God (\textit{eikōn}) & 1:15 \\
首生的 Firstborn (\textit{prōtotokos}) & 1:15（創造之先）；1:18（復活之先） \\
教會的頭 Head of the Church (\textit{kephalē}) & 1:18；2:19 \\
神本性的豐盛 Fullness of Deity (\textit{plērōma}) & 1:19；2:9-10 \\
有形有體地 Bodily (\textit{sōmatikōs}) & 2:9，全新約僅此一次 \\
誇勝 Triumph (\textit{thriambeuō}) & 2:15，羅馬凱旋式意象 \\
\bottomrule
\end{tabular}
}

\vspace{0.4cm}
\section*{奧祕與合一 Mystery and Union with Christ}

{\small
\begin{tabular}{@{}p{4.3cm}p{7.7cm}@{}}
\toprule
奧祕 Mystery (\textit{mystērion}) & 1:26-27；2:2；4:3 \\
補滿基督的患難 Filling Up Christ's Afflictions (\textit{antanaplēroō}) & 1:24，新約僅此一見，指身體與元首一同受苦的參與 \\
與基督同死、同復活 Died and Raised with Christ & 2:12, 20；3:1, 3 \\
基督是包括一切 Christ Is All, and in All & 3:11 \\
\bottomrule
\end{tabular}
}

\vspace{0.4cm}
\section*{新生命倫理 New Life Ethics}

{\small
\begin{tabular}{@{}p{4.3cm}p{7.7cm}@{}}
\toprule
脫去 Put Off (\textit{apekdyomai}) & 3:9 \\
穿上 Put On (\textit{endyō}) & 3:10, 12 \\
更新 Renewed (\textit{anakainoō}) & 3:10，持續進行式 \\
豐豐富富地 Richly (\textit{plousiōs}) & 3:16 \\
從心裡做 From the Soul (\textit{ex psychēs}) & 3:23 \\
\bottomrule
\end{tabular}
}

\vspace{0.4cm}
\section*{家庭與群體倫理 Household and Community Ethics}

{\small
\begin{tabular}{@{}p{4.3cm}p{7.7cm}@{}}
\toprule
主 Lord (\textit{kyrios}) & 3:18, 20, 22(x2), 23, 24(x2)；4:1，貫穿全段框住六種身分 \\
恆切禱告 Devoted to Prayer (\textit{proskartereō}) & 4:2 \\
儆醒 Watchful (\textit{grēgoreō}) & 4:2 \\
贖回時機 Making the Most of Time (\textit{kairos}) & 4:5 \\
\bottomrule
\end{tabular}
}

