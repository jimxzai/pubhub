% PubHub Biblehebrew Template — 讀懂聖經的希伯來文
% Derived from templates/pdf/revelation.latex: keeps its full-bleed navy cover machinery, palette,
% header/chapter styling and hyperref metadata block; the front matter, closing page and back cover
% are this book's own. Requires XeLaTeX.
%
% Deliberate differences from revelation.latex (do not "restore" them):
%  * NO ucharclasses. It switches font at every BasicLatin character, including the SPACE between two
%    Hebrew words, which splits a right-to-left phrase into separate runs and prints the words in the
%    wrong order. Hebrew/Greek runs are wrapped explicitly by scripts/combine-biblehebrew.py instead.
%  * Multi-word Hebrew MUST be wrapped in \beginR..\endR with \TeXXeTstate=1 (done by scripts/lib/hebrew_book.py).
%    XeTeX reverses the letters inside each space-separated word but not the order of the words, so a plain Hebrew
%    font run prints a phrase with its words left to right. (An earlier note here said the opposite; it was wrong.
%    scripts/verify-rtl-order.py checks the PDF text for reading order.)
%  * secnumdepth -1: chapter titles carry their own 第N章 (see chapter-template.md).

\documentclass[11pt,openany]{book}

%% ============================================
%% FONT SETUP WITH CJK LINE BREAKING
%% ============================================
\usepackage{fontspec}

%% CJK bold: a real Songti bold flattens full-width punctuation silently (gotchas.md), so BoldFont
%% points at the regular file with FakeBold. Latin/Greek/Hebrew families keep their real bold faces.
\setmainfont{Songti TC}[
  BoldFont=Songti TC,
  BoldFeatures={FakeBold=2.2},
  ItalicFont=Kaiti TC
]
\setsansfont{PingFang TC}[
  BoldFont=PingFang TC,
  BoldFeatures={FakeBold=2.0}
]
\setmonofont{Songti TC}[
  BoldFont=Songti TC,
  BoldFeatures={FakeBold=2.2}
]

\newfontfamily\greekfont{Times New Roman}[Script=Greek]
% Times New Roman's Hebrew glyphs are drawn small; Scale=1.35 keeps the niqqud legible beside CJK
% (gotchas.md: "A Hebrew/Greek fallback font needs an explicit Scale=").
\newfontfamily\hebrewfont{Times New Roman}[Script=Hebrew, Scale=1.35]
\TeXXeTstate=1   % enables \beginR..\endR, which puts the WORDS of a Hebrew phrase in right-to-left order

%% Classical English faces for the covers: Baskerville for running text, Didot for display lines.
\newfontfamily\basklatin{Baskerville}[
  ItalicFont={Baskerville Italic},
  BoldFont={Baskerville SemiBold},
  BoldItalicFont={Baskerville SemiBold Italic}
]
\newfontfamily\didotfont{Didot}
\newcommand{\baskervillefont}{\basklatin}

%% Enable CJK line breaking - critical for Chinese text
\XeTeXlinebreaklocale "zh"
\XeTeXlinebreakskip = 0pt plus 1pt minus 0.1pt

%% ============================================
%% PAGE GEOMETRY
%% ============================================
\usepackage{geometry}
\geometry{
  paperwidth=7in,
  paperheight=10in,
  top=0.75in,
  bottom=0.75in,
  inner=0.8in,
  outer=0.65in,
  marginparwidth=0in,
  marginparsep=0in
}

%% ============================================
%% LINE AND PARAGRAPH SPACING
%% ============================================
\linespread{1.1}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.3em}

%% ============================================
%% COLOR SCHEME - navy / royal gold (same palette as the Revelation volume)
%% ============================================
\usepackage{xcolor}

\definecolor{ChapterBlue}{RGB}{20,32,72}         % Royal navy for chapters
\definecolor{ScriptureGold}{RGB}{175,135,45}     % Royal gold for rules and ornaments
\definecolor{CommentaryBrown}{RGB}{95,45,25}     % Rich brown for sub-headings and dedication

% Cover gradient (navy, dark at top to a richer royal blue at bottom)
\definecolor{NavyDark}{RGB}{10,16,42}
\definecolor{NavyLight}{RGB}{32,52,108}

\definecolor{ScriptureBg}{RGB}{253,250,244}
\definecolor{TextGray}{RGB}{50,50,50}
\definecolor{LightGray}{RGB}{120,120,120}

% Light-on-dark cover text colors (defined once, used on both covers)
\definecolor{CoverCream}{RGB}{242,236,222}
\definecolor{CoverGoldBright}{RGB}{212,178,90}
\definecolor{CoverMuted}{RGB}{188,183,166}

%% ============================================
%% MATH, GRAPHICS AND TIKZ
%% ============================================
\usepackage{amssymb}
\usepackage{amsmath}
\usepackage{graphicx}
\usepackage{tikz}
\usetikzlibrary{shapes,arrows,positioning,fit,backgrounds,calc}
\usepackage{pgfornament}

% A single small fleuron (no rules), used on the covers, the dedication and the colophon.
% NOTE the signature: \fleuron[<color>] — not the width-first variant some other templates define.
\newcommand{\fleuron}[1][ScriptureGold]{%
  \pgfornament[width=0.55cm,color=#1]{88}%
}

%% ============================================
%% FULL-BLEED COVER MACHINERY (front/back cover only)
%% ============================================
\usepackage{eso-pic}
\usepackage{lettrine}

% Full-bleed navy gradient, painted in the shipout background hook (starred form = next page only)
% so it reaches the true physical page edge without disturbing the \geometry text block.
\newcommand{\CoverBackground}{%
  \AddToShipoutPictureBG*{%
    \begin{tikzpicture}[remember picture,overlay]
      \shade[top color=NavyDark,bottom color=NavyLight]
        ($$(current page.south west)$$) rectangle ($$(current page.north east)$$);
    \end{tikzpicture}%
  }%
}

% Classical book-plate border: two inset hairlines plus a corner ornament at each corner.
\newcommand{\CoverBorder}{%
  \AddToShipoutPictureFG*{%
    \begin{tikzpicture}[remember picture,overlay]
      \draw[color=ScriptureGold,line width=0.5pt]
        ($$(current page.south west)+(0.45in,0.45in)$$) rectangle ($$(current page.north east)-(0.45in,0.45in)$$);
      \draw[color=ScriptureGold,line width=0.4pt]
        ($$(current page.south west)+(0.52in,0.52in)$$) rectangle ($$(current page.north east)-(0.52in,0.52in)$$);
      \node[color=ScriptureGold] at ($$(current page.south west)+(0.55in,0.55in)$$) {\pgfornament[width=0.45cm,color=ScriptureGold]{88}};
      \node[color=ScriptureGold,rotate=90] at ($$(current page.north west)+(0.55in,-0.55in)$$) {\pgfornament[width=0.45cm,color=ScriptureGold]{88}};
      \node[color=ScriptureGold,rotate=-90] at ($$(current page.south east)+(-0.55in,0.55in)$$) {\pgfornament[width=0.45cm,color=ScriptureGold]{88}};
      \node[color=ScriptureGold,rotate=180] at ($$(current page.north east)+(-0.55in,-0.55in)$$) {\pgfornament[width=0.45cm,color=ScriptureGold]{88}};
    \end{tikzpicture}%
  }%
}

% A small consistent publisher's device: half-title page, front cover, closing colophon.
\newcommand{\publishersmark}[1][ScriptureGold]{%
  \pgfornament[width=0.4cm,color=#1]{38}%
}

%% ============================================
%% HYPERLINKS AND PDF METADATA
%% ============================================
\usepackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=ChapterBlue,
  urlcolor=ScriptureGold,
  bookmarks=true,
  bookmarksnumbered=true,
  % Without these `pdfinfo` reports no Title/Author/Subject at all (the file shows as its filename in
  % a reader's title bar and in any catalogue). pdflang tells a screen reader the primary language.
  pdftitle={讀懂聖經的希伯來文 — Reading the Hebrew Old Testament},
  pdfauthor={PubHub 三書精讀系統},
  pdfsubject={卷一：新手讀經入門，不必先學希伯來文也能聰明利用希伯來文；卷二：舊約各卷〈原文研讀〉的希伯來文彙編與詞目總索引},
  pdfkeywords={希伯來文, 舊約, 讀經, 查字, 詞目索引, 原文研讀, OSHB, Hebrew, Old Testament, Bible study, index, 和合本, NASB, 唱一唱},
  pdfcreator={XeLaTeX + pandoc (PubHub 三書精讀出版系統)},
  pdflang={zh-Hant}
}

