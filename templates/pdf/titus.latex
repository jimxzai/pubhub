% Diagram page 1 — the disorder/order circle diagram, moved off the
% frontispiece so the cover stays typographically clean
\thispagestyle{empty}
\begin{center}
\vspace*{0.3cm}
{\Large\bfseries\color{ChapterBlue} 提多書結構}\\[0.1cm]
{\normalsize Structure of Titus}

\vspace{0.5cm}

% Structure diagram - Order out of chaos
\begin{tikzpicture}[scale=0.6]
  \node[font=\footnotesize\bfseries,color=ChapterBlue] at (0,4) {把沒有辦完的事辦整齊 Putting Things in Order};

  % Disorder elements (left side)
  \node[draw=OldCovenantRed,fill=OldCovenantRed!10,rounded corners,minimum width=1.8cm,font=\tiny] at (-3,2.3) {Liars 說謊};
  \node[draw=OldCovenantRed,fill=OldCovenantRed!10,rounded corners,minimum width=1.8cm,font=\tiny] at (-3,1.3) {False Teachers 假教師};
  \node[draw=OldCovenantRed,fill=OldCovenantRed!10,rounded corners,minimum width=1.8cm,font=\tiny] at (-3,0.3) {Empty Talk 空談};
  \node[draw=OldCovenantRed,fill=OldCovenantRed!10,rounded corners,minimum width=1.8cm,font=\tiny] at (-3,-0.7) {Division 分門結黨};

  % Titus in center
  \node[draw=ScriptureGold,fill=ScriptureBg,circle,minimum size=2cm,line width=2pt,font=\small\bfseries,color=ChapterBlue] (titus) at (0,0.5) {TITUS};

  % Order elements (right side)
  \node[draw=NewCovenantGreen,fill=NewCovenantGreen!10,rounded corners,minimum width=1.8cm,font=\tiny] at (3,2) {Elders 長老};
  \node[draw=NewCovenantGreen,fill=NewCovenantGreen!10,rounded corners,minimum width=1.8cm,font=\tiny] at (3,1) {Sound Doctrine 健全教訓};
  \node[draw=NewCovenantGreen,fill=NewCovenantGreen!10,rounded corners,minimum width=1.8cm,font=\tiny] at (3,0) {Good Works 善行};
  \node[draw=NewCovenantGreen,fill=NewCovenantGreen!10,rounded corners,minimum width=1.8cm,font=\tiny] at (3,-1) {Grace 恩典};

  % Arrows showing transformation
  \foreach \y in {2.3,1.3,0.3,-0.7} {
    \draw[->,thick,color=ScriptureGold] (-2,\y) -- (-0.8,0.5);
  }
  \foreach \y in {2,1,0,-1} {
    \draw[->,thick,color=NewCovenantGreen] (0.8,0.5) -- (2,\y);
  }
\end{tikzpicture}

\vspace{0.8cm}

% Three-part structure
\begin{tikzpicture}[scale=0.9]
  % Part 1
  \node[draw=ChapterBlue,fill=ChapterBlue!10,rounded corners,minimum width=4cm,minimum height=2cm] at (0,0) {};
  \node[font=\small\bfseries,color=ChapterBlue] at (0,0.5) {Part I: Order};
  \node[font=\footnotesize,color=TextGray] at (0,0) {長老與假教師};
  \node[font=\tiny,color=LightGray] at (0,-0.5) {Chapter 1};

  % Part 2
  \node[draw=ScriptureGold,fill=ScriptureGold!10,rounded corners,minimum width=4cm,minimum height=2cm] at (5,0) {};
  \node[font=\small\bfseries,color=ScriptureGold!70!black] at (5,0.5) {Part II: Doctrine};
  \node[font=\footnotesize,color=TextGray] at (5,0) {健全的教訓};
  \node[font=\tiny,color=LightGray] at (5,-0.5) {Chapter 2};

  % Part 3
  \node[draw=NewCovenantGreen,fill=NewCovenantGreen!10,rounded corners,minimum width=4cm,minimum height=2cm] at (10,0) {};
  \node[font=\small\bfseries,color=NewCovenantGreen!80!black] at (10,0.5) {Part III: Grace};
  \node[font=\footnotesize,color=TextGray] at (10,0) {善行與恩典};
  \node[font=\tiny,color=LightGray] at (10,-0.5) {Chapter 3};

  % Arrows
  \draw[->,thick,color=ScriptureGold] (2.2,0) -- (2.8,0);
  \draw[->,thick,color=ScriptureGold] (7.2,0) -- (7.8,0);
\end{tikzpicture}
\end{center}
