{\large\bfseries\color{ChapterBlue} 五種身分的責任 Five Stations of Life (Ch. 2)}

\vspace{0.3cm}

\begin{tikzpicture}[scale=0.75]
  \foreach \x/\num/\txt in {
    0/1/Older Men 老年人,
