% Book structure diagram - with proper spacing
\begin{tikzpicture}[scale=0.8]
  % Title - above the roof
  \node[font=\normalsize\bfseries,color=ChapterPurple] at (5,7.2) {16 Chapters · 5 Themes · 1 Foundation};

  % Foundation bar
  \fill[ResurrectionGold!30] (0,-1) rectangle (10,0);
  \draw[ResurrectionGold,line width=2pt] (0,-1) rectangle (10,0);
  \node[font=\normalsize\bfseries,color=ChapterPurple] at (5,-0.5) {RESURRECTION 復活 (Ch 15)};

  % Five pillars - drawn individually to avoid parsing issues
  % Wisdom (Ch 1-4)
  \fill[ChapterPurple!20] (0.2,0) rectangle (1.8,4.5);
  \draw[ChapterPurple,line width=1.5pt] (0.2,0) rectangle (1.8,4.5);
  \node[font=\scriptsize\bfseries,color=ChapterPurple] at (1,4.1) {Wisdom};
  \node[font=\tiny,color=TextGray] at (1,3.6) {1-4};

  % Holiness (Ch 5-6)
  \fill[SpiritBlue!20] (2.2,0) rectangle (3.8,4);
  \draw[SpiritBlue,line width=1.5pt] (2.2,0) rectangle (3.8,4);
  \node[font=\scriptsize\bfseries,color=SpiritBlue] at (3,3.6) {Holiness};
  \node[font=\tiny,color=TextGray] at (3,3.1) {5-6};

  % Freedom (Ch 7-10)
  \fill[ChapterPurple!20] (4.2,0) rectangle (5.8,4.5);
  \draw[ChapterPurple,line width=1.5pt] (4.2,0) rectangle (5.8,4.5);
  \node[font=\scriptsize\bfseries,color=ChapterPurple] at (5,4.1) {Freedom};
  \node[font=\tiny,color=TextGray] at (5,3.6) {7-10};

  % Gifts (Ch 11-14)
  \fill[SpiritBlue!20] (6.2,0) rectangle (7.8,4);
  \draw[SpiritBlue,line width=1.5pt] (6.2,0) rectangle (7.8,4);
  \node[font=\scriptsize\bfseries,color=SpiritBlue] at (7,3.6) {Gifts};
  \node[font=\tiny,color=TextGray] at (7,3.1) {11-14};

  % Hope (Ch 15-16)
  \fill[ResurrectionGold!20] (8.2,0) rectangle (9.8,3.5);
  \draw[ResurrectionGold,line width=1.5pt] (8.2,0) rectangle (9.8,3.5);
  \node[font=\scriptsize\bfseries,color=ResurrectionGold] at (9,3.1) {Hope};
  \node[font=\tiny,color=TextGray] at (9,2.6) {15-16};

  % Roof (Love) - peak at y=6.5 to clear title
  \fill[ScriptureGold!30] (0,4.8) -- (5,6.5) -- (10,4.8) -- cycle;
  \draw[ScriptureGold,line width=2pt] (0,4.8) -- (5,6.5) -- (10,4.8) -- cycle;
  \node[font=\normalsize\bfseries,color=ChapterPurple] at (5,5.5) {LOVE 愛 (Ch 13)};

\end{tikzpicture}

\vspace{0.8cm}

% Key themes box - font size 9pt with proper spacing
\begin{tikzpicture}[scale=0.75]
  \node[font=\normalsize\bfseries,color=ChapterPurple] at (0,4.5) {哥林多教會的問題 Problems in Corinth};

  % Problem -> Solution pairs - wider horizontal spacing to avoid arrow overlap
  \foreach \y/\prob/\sol in {
    3.2/分黨結派 Divisions/在基督裏合一 Unity in Christ,
    2.0/淫亂罪惡 Immorality/身體是聖殿 Body as Temple,
    0.8/偶像祭物 Idol Food/愛心的自由 Freedom in Love,
    -0.4/聚會混亂 Worship Chaos/規矩次序 Order,
    -1.6/不信復活 No Resurrection/榮耀盼望 Glorious Hope
  } {
    \node[draw=ChapterPurple,fill=ScriptureBg,rounded corners,font=\fontsize{9}{11}\selectfont,minimum width=3cm,minimum height=0.6cm] at (-4.0,\y) {\prob};
    \draw[SpiritBlue,->,line width=1pt] (-1.5,\y) -- (1.1,\y);
    \node[draw=SpiritBlue,fill=SpiritBg,rounded corners,font=\fontsize{9}{11}\selectfont,minimum width=3cm,minimum height=0.6cm] at (4.0,\y) {\sol};
  }
