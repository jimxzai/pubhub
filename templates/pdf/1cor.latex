{\fontsize{13}{15}\selectfont\itshape\color{TextGray} The Climax of the Letter \textperiodcentered\ 一粒麥子落在地裏死了，卻結出許多子粒}

\vspace{0.30cm}

% ===== WHEAT SHEAF WITH HALO (哥林多前書的活物記號：初熟的果子) =====
\begin{tikzpicture}[scale=0.85, transform shape]
  % Halo — radiating glory rays (firstfruits raised into glory, 15:20)
  \draw[ScriptureGold, line width=0.3pt, opacity=0.08] (0,0.3) circle (2.0);
  \draw[ScriptureGold, line width=0.3pt, opacity=0.14] (0,0.3) circle (1.7);
  \draw[ScriptureGold, line width=0.4pt, opacity=0.20] (0,0.3) circle (1.4);

  % Stalks (莖稈) rising from the bound sheaf
  \draw[ChapterPurple, line width=2pt] (-0.42,-0.85) .. controls (-0.5,-0.2) and (-0.32,0.35) .. (-0.28,0.85);
  \draw[ChapterPurple, line width=2pt] (0,-0.85) .. controls (0.02,-0.1) and (-0.02,0.45) .. (0,1.0);
  \draw[ChapterPurple, line width=2pt] (0.42,-0.85) .. controls (0.5,-0.2) and (0.32,0.35) .. (0.28,0.85);

  % Binding band (捆綁——一粒麥子落在地裏死了) at the base of the sheaf
  \draw[ScriptureGold, line width=3pt] (-0.55,-0.7) -- (0.55,-0.7);
  \draw[ScriptureGold, line width=1.2pt] (-0.55,-0.6) -- (0.55,-0.85);

  % Ears of grain (麥穗) — three iconographic heads, simple bezier fills
  \fill[ScriptureGold] (-0.28,0.85) .. controls (-0.55,1.15) and (-0.4,1.55) .. (-0.28,1.75)
                       .. controls (-0.16,1.55) and (-0.02,1.15) .. (-0.28,0.85);
  \fill[ChapterPurple] (0,1.0) .. controls (-0.28,1.35) and (-0.12,1.85) .. (0,2.1)
                       .. controls (0.12,1.85) and (0.28,1.35) .. (0,1.0);
  \fill[ScriptureGold] (0.28,0.85) .. controls (0.02,1.15) and (0.16,1.55) .. (0.28,1.75)
                       .. controls (0.4,1.55) and (0.55,1.15) .. (0.28,0.85);

  % Awns (麥芒) — fine radiating lines from each head
  \foreach \bx/\by in {-0.28/1.3, 0/1.5, 0.28/1.3} {
    \draw[ChapterPurple, line width=0.6pt] (\bx,\by) -- (\bx-0.18,\by+0.35);
    \draw[ChapterPurple, line width=0.6pt] (\bx,\by) -- (\bx+0.18,\by+0.35);
    \draw[ChapterPurple, line width=0.6pt] (\bx,\by) -- (\bx,\by+0.42);
  }
\end{tikzpicture}

