\chapter*{Appendix D: Greek Word Glossary 希臘文原文詞彙表}
\addcontentsline{toc}{chapter}{Appendix D: Greek Word Glossary 希臘文原文詞彙表}

\begin{small}
以下彙整全書十六章中出現的希臘文關鍵詞，依主題分組，並合併同一詞根在不同章節重複出現時的經文出處。
\textit{Key Greek terms occurring across all sixteen chapters, grouped thematically; repeated headwords are merged into a single entry with all their verse references combined.}
\end{small}

\section*{智慧與屬靈 Wisdom \& Spirituality (1--4章)}

\begin{small}
\begin{tabular}{@{}p{2.9cm}p{2.6cm}p{1.6in}@{}}
\textbf{κλητός} \textit{(klētos)} & 蒙召的 & 1:1, 2, 24 \\
\textbf{ἅγιος} \textit{(hagios)} & 聖徒、聖潔的 & 1:2 \\
\textbf{σχίσμα} \textit{(schisma)} & 分裂、裂痕 & 1:10 \\
\textbf{σταυρός} \textit{(stauros)} & 十字架 & 1:17, 18 \\
\textbf{μωρία} \textit{(mōria)} & 愚拙 & 1:18, 21, 23 \\
\textbf{δύναμις} \textit{(dynamis)} & 能力、大能 & 1:18, 24 \\
\textbf{σοφία} \textit{(sophia)} & 智慧 & 1:17, 19, 20, 21, 24, 30 \\
\textbf{μυστήριον} \textit{(mystērion)} & 奧秘、隱藏的事 & 2:1, 7; 15:51 \\
\textbf{ἀπόδειξις} \textit{(apodeixis)} & 明證、證明 & 2:4 \\
\textbf{τέλειος} \textit{(teleios)} & 成熟的、完全的 & 2:6; 13:10 \\
\textbf{ἀποκαλύπτω} \textit{(apokalyptō)} & 揭示、顯明 & 2:10 \\
\textbf{πνευματικός} \textit{(pneumatikos)} & 屬靈的 & 2:13, 15; 12:1; 15:44, 46 \\
\textbf{ψυχικός} \textit{(psychikos)} & 屬血氣的、天然的 & 2:14; 15:44, 46 \\
\textbf{νοῦς} \textit{(nous)} & 心思、意念、悟性 & 2:16; 14:14, 15, 19 \\
\textbf{σαρκικός} \textit{(sarkikos)} & 屬肉體的 & 3:1, 3 \\
\textbf{νήπιος} \textit{(nēpios)} & 嬰孩 & 3:1 \\
\textbf{φυσιόω} \textit{(physioō)} & 自高自大、張狂 & 4:6, 18, 19; 5:2; 8:1; 13:4 \\
\end{tabular}
\end{small}

\section*{身體與聖潔 Body \& Holiness (3, 5--7章)}

\begin{small}
\begin{tabular}{@{}p{2.9cm}p{2.6cm}p{1.6in}@{}}
\textbf{θεμέλιος} \textit{(themelios)} & 根基 & 3:10, 11, 12 \\
\textbf{ναός} \textit{(naos)} & 殿、聖所 & 3:16, 17; 6:19 \\
\textbf{φθείρω} \textit{(phtheirō)} & 毀壞、敗壞 & 3:17 \\
\textbf{πορνεία} \textit{(porneia)} & 淫亂、性不道德 & 5:1; 6:13, 18 \\
\textbf{πενθέω} \textit{(pentheō)} & 悲哀、哀悼 & 5:2 \\
\textbf{ζύμη} \textit{(zymē)} & 麵酵 & 5:6, 7, 8 \\
\textbf{ἄζυμος} \textit{(azymos)} & 無酵的 & 5:7, 8 \\
\textbf{πάσχα} \textit{(pascha)} & 逾越節 & 5:7 \\
\textbf{πονηρός} \textit{(ponēros)} & 惡人、邪惡的 & 5:13 \\
\textbf{ἄδικος} \textit{(adikos)} & 不義的 & 6:1, 9 \\
\textbf{κρίνω} \textit{(krinō)} & 審判 & 6:2, 3 \\
\textbf{ἀδικέω} \textit{(adikeō)} & 虧負、欺壓 & 6:7, 8 \\
\textbf{τιμή} \textit{(timē)} & 價值、重價 & 6:20 \\
\textbf{δοξάζω} \textit{(doxazō)} & 榮耀 & 6:20 \\
\textbf{ἅπτω} \textit{(haptō)} & 接近、觸摸 & 7:1 \\
\textbf{ἀγαμος} \textit{(agamos)} & 未婚的 & 7:8, 11, 32, 34 \\
\textbf{χωρίζω} \textit{(chōrizō)} & 分開、離開 & 7:10, 11, 15 \\
\textbf{κλῆσις} \textit{(klēsis)} & 呼召、身分 & 7:20 \\
\textbf{ἀμέριμνος} \textit{(amerimnos)} & 無所掛慮 & 7:32 \\
\textbf{εὐσχημόνως} \textit{(euschēmonōs)} & 端正地、規規矩矩 & 7:35; 14:40 \\
\end{tabular}
\end{small}

\pagebreak

\section*{自由與良心 Freedom \& Conscience (8--10章)}

\begin{small}
\begin{tabular}{@{}p{2.9cm}p{2.6cm}p{1.6in}@{}}
\textbf{γνῶσις} \textit{(gnōsis)} & 知識 & 8:1, 7, 10, 11 \\
\textbf{οἰκοδομέω} \textit{(oikodomeō)} & 造就、建造 & 8:1, 10; 14:4, 17, 26 \\
