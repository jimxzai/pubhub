% Four-volume structure diagram (TikZ drawn) — the book's own progression
% from emptiness through encounter and seeking to fullness, one biblical
% chapter per volume. Simple single-row layout — Ruth needs none of Job's
% two-row/seven-box complexity.
% No picture-level `scale`: node sizes (minimum width/height) are NOT affected
% by TikZ's `scale` key unless `transform shape` is also given, while node
% POSITIONS always are — mixing the two without `transform shape` silently
% compresses the coordinate grid while the box borders stay full size, so
% boxes spaced correctly on paper collide and clip their own text with zero
% warning. Coordinates below are plain centimetres instead, sized directly.
\begin{tikzpicture}[every node/.style={align=center}]
  \node[font=\footnotesize\bfseries,color=FieldAmber] at (0,1.6) {全書四卷 Four Volumes, Four Chapters};

  \node[draw=LightGray,fill=ScriptureBg,rounded corners,minimum width=2.5cm,minimum height=0.7cm,font=\tiny] (v1) at (-4.125,0.9) {卷一 \textperiodcentered\ 空 Emptied};
  \node[font=\tiny,color=LightGray] at (-4.125,0.25) {第1章};

  \node[draw=FieldAmber,fill=ScriptureBg,rounded corners,minimum width=2.5cm,minimum height=0.7cm,font=\tiny] (v2) at (-1.375,0.9) {卷二 \textperiodcentered\ 遇 Encountered};
  \node[font=\tiny,color=LightGray] at (-1.375,0.25) {第2章};

  \node[draw=DuskIndigo,fill=ScriptureBg,rounded corners,minimum width=2.5cm,minimum height=0.7cm,font=\tiny] (v3) at (1.375,0.9) {卷三 \textperiodcentered\ 求 Sought};
  \node[font=\tiny,color=LightGray] at (1.375,0.25) {第3章};

  \node[draw=DawnRose!70!black,fill=ScriptureBg,rounded corners,minimum width=2.5cm,minimum height=0.7cm,font=\tiny] (v4) at (4.125,0.9) {卷四 \textperiodcentered\ 滿 Filled};
  \node[font=\tiny,color=LightGray] at (4.125,0.25) {第4章};

  \draw[->,color=ScriptureGold,thick] (v1.east) -- (v2.west);
  \draw[->,color=ScriptureGold,thick] (v2.east) -- (v3.west);
  \draw[->,color=ScriptureGold,thick] (v3.east) -- (v4.west);
\end{tikzpicture}

