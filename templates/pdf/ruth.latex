% ===== BARLEY FIELD MOTIF — simple vertical "stalks" of varying height,
% each topped with a small rounded grain-head, suggesting the gleaning
% field of 2章. Plain \foreach over a one-line list of x/height pairs —
% not the braced multi-line value that breaks pgf's list parser — and no
% text is placed over any fill, so there is no label-overlap risk.
\begin{tikzpicture}[scale=0.85, transform shape]
  \draw[FieldAmber, line width=0.8pt] (-2.9,0) -- (2.9,0);
  \foreach \x/\h in {-2.6/0.85,-2.2/1.15,-1.8/0.95,-1.4/1.35,-1.0/1.05,
                     -0.6/1.25,-0.2/0.95,0.2/1.30,0.6/1.00,1.0/1.20,
                     1.4/0.90,1.8/1.35,2.2/1.05,2.6/0.85} {
    \draw[FieldAmber, line width=1.4pt] (\x,0) -- (\x,\h);
    \fill[DawnRose] (\x,\h) circle (0.05);
  }
\end{tikzpicture}

\vspace{0.05cm}
{\fontsize{9}{11}\selectfont\color{TextGray} 禾場 \textperiodcentered\ The Gleaning Field}

\vspace{0.15cm}
\textcolor{ScriptureGold}{\rule{2.8in}{0.8pt}}
\vspace{0.24cm}

{\fontsize{34}{40}\selectfont\bfseries\color{FieldAmber}\kaiti\selectfont 滿}\\[0.10cm]
{\fontsize{16}{20}\selectfont\scshape\color{CommentaryBrown} Filled}

\vspace{0.20cm}
{\fontsize{22}{26}\selectfont\bfseries\kaiti\selectfont 路得記研讀}\\[0.08cm]
{\fontsize{13}{16}\selectfont\itshape\color{TextGray} A Study of the Book of Ruth}

\vspace{0.24cm}
{\fontsize{15}{18}\selectfont\itshape\color{FieldAmber} גֹּאֵל}\quad
{\footnotesize\scshape\color{CommentaryBrown} “go'el”}\quad
{\footnotesize\bfseries\color{DuskIndigo} 至近的親屬 \textperiodcentered\ 救贖者}

\vfill

\fcolorbox{ScriptureGold}{white}{%
\begin{minipage}{4.3in}
\centering\vspace{0.15cm}
{\footnotesize\color{FieldAmber}\kaiti\selectfont
「你的國就是我的國，你的神就是我的神。」}\\[0.10em]
{\scriptsize\itshape\color{TextGray}
“Your people shall be my people, and your God, my God.”}\\[0.10em]
{\scriptsize\color{FieldAmber} 路得記 1:16 \textperiodcentered\ Ruth 1:16}
\vspace{0.15cm}
