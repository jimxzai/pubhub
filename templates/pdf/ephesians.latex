% ===== THREE CONCENTRIC ZONES: SIT / WALK / STAND =====
\begin{tikzpicture}[scale=0.85, transform shape]
  % Outer zone — Stand (6:11), the armor, the warfare
  \fill[MysteryGold, opacity=0.16] (0,0.1) circle (1.65);
  \draw[MysteryGold, line width=0.9pt, opacity=0.75] (0,0.1) circle (1.65);
  % Middle zone — Walk (4:1), the conduct worthy of the calling
  \fill[HeavenBlue, opacity=0.14] (0,0.1) circle (1.15);
  \draw[HeavenBlue, line width=1.0pt, opacity=0.85] (0,0.1) circle (1.15);
  % Inner zone — Sit (2:6), seated with Christ, the foundation
  \fill[ChapterIndigo, opacity=0.22] (0,0.1) circle (0.55);
  \draw[ChapterIndigo, line width=1.0pt, opacity=0.9] (0,0.1) circle (0.55);
  \node[font=\tiny,color=ChapterIndigo] at (0,-0.65) {坐（2:6）};
  \node[font=\tiny,color=HeavenBlue] at (0,-1.28) {行（4:1）};
  \node[font=\tiny,color=MysteryGold!70!black]  at (0,-1.9) {站（6:11）};
\end{tikzpicture}

\vspace{0.10cm}
