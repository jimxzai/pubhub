% ===== THREE CONCENTRIC ZONES: JORDAN CROSSING / CONQUEST / REST =====
\begin{tikzpicture}[scale=0.85, transform shape]
  % Outer zone — the inheritance of rest (13-21章; 11:23 "the land had rest from war")
  \fill[RestGreen, opacity=0.16] (0,0.1) circle (1.65);
  \draw[RestGreen, line width=0.9pt, opacity=0.75] (0,0.1) circle (1.65);
  % Middle zone — the conquest (6-12章)
  \fill[ConquestBronze, opacity=0.14] (0,0.1) circle (1.15);
  \draw[ConquestBronze, line width=1.0pt, opacity=0.85] (0,0.1) circle (1.15);
  % Inner zone — the Jordan crossed on dry ground (3-4章)
  \fill[ChapterJordan, opacity=0.22] (0,0.1) circle (0.55);
  \draw[ChapterJordan, line width=1.0pt, opacity=0.9] (0,0.1) circle (0.55);
  \node[font=\tiny,color=ChapterJordan] at (0,-0.65) {過河};
  \node[font=\tiny,color=ConquestBronze] at (0,-1.28) {爭戰};
  \node[font=\tiny,color=RestGreen!70!black]  at (0,-1.9) {安息為業};
\end{tikzpicture}

\vspace{0.10cm}
