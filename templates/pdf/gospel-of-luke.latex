% Series cover system: vector artwork, physical-page coordinates (7 x 10 in).
\definecolor{LukeCoverDark}{HTML}{091B2B}
\definecolor{LukeCoverLight}{HTML}{203D50}
\definecolor{LukeCoverGold}{HTML}{D6B66D}
\definecolor{LukeCoverCream}{HTML}{F5F0E4}
\definecolor{LukeCoverMuted}{HTML}{BECDD2}
\newcommand{\LukeCoverGround}{%
  \shade[top color=LukeCoverDark,bottom color=LukeCoverLight] (0,0) rectangle (7,10);
  \draw[LukeCoverGold,line width=1pt] (.31,.31) rectangle (6.69,9.69);
  \draw[LukeCoverGold,opacity=.5,line width=.3pt] (.39,.39) rectangle (6.61,9.61);
  \foreach \x/\y in {.31/.31,.31/9.69,6.69/.31,6.69/9.69}
    \fill[LukeCoverGold] (\x,\y) circle (.025);
}
% Open arch and a winding road: Luke's journey and the welcome of the lost.
\newcommand{\LukeRoadEmblem}{%
 \draw[LukeCoverGold,line width=.85pt]
   (-.35,-.18) -- (-.35,.45) arc[start angle=180,end angle=0,radius=.35] -- (.35,-.18);
 \draw[LukeCoverGold,opacity=.5,line width=.4pt]
   (-.46,-.18) -- (-.46,.45) arc[start angle=180,end angle=0,radius=.46] -- (.46,-.18);
 \fill[LukeCoverGold] (0,.42) circle (.033);
 \draw[LukeCoverGold,line width=.8pt]
   (-.055,-.05) .. controls (-.34,-.30) and (.47,-.39) .. (-.58,-.84);
 \draw[LukeCoverGold,opacity=.65,line width=.5pt]
   (.055,-.05) .. controls (-.10,-.30) and (.78,-.40) .. (-.10,-.84);
 \draw[LukeCoverGold,opacity=.5,line width=.4pt] (-.87,-.18) -- (-.49,-.18) (.49,-.18) -- (.87,-.18);
}
% A restrained halo and rays give the emblem the same finely resolved finish
% as the John cover while keeping Luke's open-door/road motif distinct.
\renewcommand{\LukeRoadEmblem}{%
  \draw[LukeCoverGold,line width=.55pt] (0,.18) circle (.70);
  \draw[LukeCoverGold,opacity=.55,line width=.3pt] (0,.18) circle (.78);
  \foreach \a in {15,45,...,345}
    \draw[LukeCoverGold,opacity=.55,line width=.3pt] (\a:.86) -- (\a:.98);
  \draw[LukeCoverGold,line width=.85pt]
    (-.35,-.18) -- (-.35,.45) arc[start angle=180,end angle=0,radius=.35] -- (.35,-.18);
  \draw[LukeCoverGold,opacity=.5,line width=.4pt]
    (-.46,-.18) -- (-.46,.45) arc[start angle=180,end angle=0,radius=.46] -- (.46,-.18);
  \fill[LukeCoverGold] (0,.42) circle (.033);
  \draw[LukeCoverGold,line width=.8pt]
    (-.055,-.05) .. controls (-.34,-.30) and (.47,-.39) .. (-.58,-.84);
  \draw[LukeCoverGold,opacity=.65,line width=.5pt]
    (.055,-.05) .. controls (-.10,-.30) and (.78,-.40) .. (-.10,-.84);
  \draw[LukeCoverGold,opacity=.5,line width=.4pt] (-.87,-.18) -- (-.49,-.18) (.49,-.18) -- (.87,-.18);
}

% Vine decoration command
\newcommand{\vinedecor}[1]{%
\begin{tikzpicture}[scale=0.6]
  \draw[color=ScriptureGold,line width=0.8pt,decorate,decoration={snake,amplitude=1pt,segment length=8pt}]
    (0,0) -- (#1,0);
  \foreach \x in {0.3,0.8,1.3,1.8,2.3} {
    \draw[color=ScriptureGold,line width=0.5pt] (\x,0) .. controls (\x+0.1,0.15) and (\x+0.2,0.15) .. (\x+0.25,0.05);
  }
\end{tikzpicture}%
}

% Cross decoration
\newcommand{\crosssymbol}{%
\begin{tikzpicture}[scale=0.15]
  \draw[color=ScriptureGold,line width=1.5pt] (0,-1) -- (0,1);
  \draw[color=ScriptureGold,line width=1.5pt] (-0.6,0.4) -- (0.6,0.4);
\end{tikzpicture}%
}

