% Noah's Ark
{\large\bfseries\color{ChapterBlue} 挪亞方舟 Noah's Ark (Gen 6-8)}

\vspace{0.3cm}

\begin{tikzpicture}[scale=0.7]
  % Water
  \fill[WaterBlue!50] (-5,-1.5) rectangle (5,-0.5);
  \draw[WaterBlue,line width=1pt,decorate,decoration={snake,amplitude=3pt,segment length=15pt}] (-5,-0.5) -- (5,-0.5);

  % Ark hull
  \fill[CommentaryBrown!80] (-3.5,0) .. controls (-4,-0.3) and (-4,-0.5) .. (-3.5,-0.5)
    -- (3.5,-0.5) .. controls (4,-0.5) and (4,-0.3) .. (3.5,0) -- cycle;

  % Ark body
  \fill[CommentaryBrown!60] (-3.5,0) rectangle (3.5,1.5);
  \draw[CommentaryBrown!90,line width=0.5pt] (-3.5,0.5) -- (3.5,0.5);
  \draw[CommentaryBrown!90,line width=0.5pt] (-3.5,1) -- (3.5,1);

  % Roof
  \fill[CommentaryBrown!70] (-3.8,1.5) -- (0,2.5) -- (3.8,1.5) -- cycle;

  % Window
  \fill[ScriptureGold!50] (-0.3,2) rectangle (0.3,2.3);

  % Door
  \fill[CommentaryBrown!40] (2,0) rectangle (2.8,1.2);

  % Dove with olive branch
  \draw[ChapterBlue,line width=1pt] (4.5,2) -- (4.8,2.2) -- (5.2,2) -- (4.8,1.8) -- cycle;
  \draw[CreationGreen,line width=1pt] (5.2,2) -- (5.5,2.1);
  \fill[CreationGreen] (5.5,2.1) circle (0.08);
  \fill[CreationGreen] (5.4,2.15) circle (0.05);

  % Rainbow
  \draw[red,line width=2pt] (-3,3) arc (180:0:3);
  \draw[orange,line width=2pt] (-2.8,3) arc (180:0:2.8);
  \draw[yellow,line width=2pt] (-2.6,3) arc (180:0:2.6);
  \draw[CreationGreen,line width=2pt] (-2.4,3) arc (180:0:2.4);
  \draw[ChapterBlue,line width=2pt] (-2.2,3) arc (180:0:2.2);
  \draw[violet,line width=2pt] (-2,3) arc (180:0:2);

  % Dimensions label
  \node[font=\tiny,color=LightGray] at (0,-1.2) {長300肘 × 寬50肘 × 高30肘};
  \node[font=\tiny,color=LightGray] at (0,-1.6) {(約 137m × 23m × 14m)};
\end{tikzpicture}

\vspace{0.6cm}

% Altar Offering
{\large\bfseries\color{ChapterBlue} 燔祭壇 The Altar (Gen 22)}

\vspace{0.3cm}

\begin{tikzpicture}[scale=0.7]
  % Ground
  \fill[DesertTan] (-4,-0.5) rectangle (4,0);

  % Stone altar
  \fill[MountainBrown] (-1.5,0) rectangle (1.5,1);
  \fill[MountainBrown!80] (-1.3,1) rectangle (1.3,1.3);

  % Wood on altar
  \foreach \x in {-0.8,-0.4,0,0.4,0.8} {
    \fill[CommentaryBrown!70] (\x,1.3) rectangle (\x+0.15,1.8);
  }

  % Fire
  \fill[orange!80] (-0.5,1.8) -- (0,2.8) -- (0.5,1.8) -- cycle;
  \fill[red!80] (-0.3,1.8) -- (0,2.5) -- (0.3,1.8) -- cycle;
  \fill[yellow] (-0.15,1.8) -- (0,2.2) -- (0.15,1.8) -- cycle;

  % Ram in thicket (to the side)
  \fill[MountainBrown!50] (3,0) -- (3.5,0.8) -- (3.2,0.5) -- (3.8,0.6) -- (3.3,0) -- cycle;
  \draw[CommentaryBrown,line width=0.8pt] (3.3,0.5) circle (0.15);
  \draw[CommentaryBrown,line width=0.8pt] (3.2,0.65) -- (3.1,0.9);
  \draw[CommentaryBrown,line width=0.8pt] (3.4,0.65) -- (3.5,0.9);
  \node[font=\tiny,color=TextGray] at (3.3,-0.3) {公羊};

  % Abraham figure (simple)
  \fill[ChapterBlue!60] (-2.5,0) -- (-2.5,1) -- (-2.3,1) -- (-2.3,0.5) -- (-2.1,0.5) -- (-2.1,0) -- cycle;
  \fill[ChapterBlue!60] (-2.4,1) circle (0.15);

  % Label
  \node[font=\tiny,color=LightGray] at (0,-0.3) {耶和華以勒 — 耶和華必預備};
\end{tikzpicture}

\vspace{0.6cm}

% Jacob's Ladder
{\large\bfseries\color{ChapterBlue} 雅各天梯 Jacob's Ladder (Gen 28)}

\vspace{0.3cm}

\begin{tikzpicture}[scale=0.6]
  % Ground
  \fill[DesertTan] (-3,-0.5) rectangle (5,0);

  % Jacob sleeping
  \fill[ChapterBlue!50] (-2,0) -- (-2,0.3) -- (-1,0.3) -- (-1,0) -- cycle;
  \fill[ChapterBlue!50] (-1.5,0.3) circle (0.15);

  % Stone pillow
  \fill[MountainBrown] (-1.8,0) rectangle (-1.4,0.2);

  % Ladder
  \draw[ScriptureGold,line width=2pt] (0.5,0) -- (3,5);
  \draw[ScriptureGold,line width=2pt] (1.5,0) -- (4,5);
  \foreach \y in {0.5,1,1.5,2,2.5,3,3.5,4,4.5} {
    \draw[ScriptureGold,line width=1pt] ({0.5+\y*0.5},\y) -- ({1.5+\y*0.5},\y);
  }

  % Angels (simplified)
  \foreach \pos in {1.2,2.4,3.6} {
    \fill[white] ({1+\pos*0.5},\pos) circle (0.12);
    \draw[ScriptureGold,line width=0.5pt] ({0.85+\pos*0.5},{\pos-0.1}) -- ({0.7+\pos*0.5},{\pos-0.3});
    \draw[ScriptureGold,line width=0.5pt] ({1.15+\pos*0.5},{\pos-0.1}) -- ({1.3+\pos*0.5},{\pos-0.3});
  }

  % Heaven glow
  \fill[ScriptureGold!30] (2.5,4.5) ellipse (1.5 and 0.8);
  \node[font=\tiny,color=ScriptureGold] at (2.5,4.5) {天};

  % Labels
  \node[font=\tiny,color=TextGray] at (-1.5,-0.3) {伯特利};
  \node[font=\tiny,color=LightGray] at (2,-0.5) {神的使者上去下來};
\end{tikzpicture}

\vspace{0.3cm}
{\footnotesize\color{LightGray} 「這地方何等可畏！這不是別的，乃是神的殿，也是天的門。」— 創 28:17}
