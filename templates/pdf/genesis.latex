\frontmatter
\pagestyle{empty}

% Cover frame: full-bleed cream background + gold/navy double border + corner ornament
% Page is fixed at 7in x 10in, see geometry settings above. Coordinates are
% relative to the page south-west corner via an explicit shift, deliberately
% avoiding the TikZ calc-library dollar-sign coordinate syntax, since pandoc's
% own templating language also uses dollar signs and would misparse it.
\newcommand{\coverframe}{%
  \begin{tikzpicture}[remember picture,overlay,shift={(current page.south west)}]
    \fill[CoverCream] (0,0) rectangle (7in,10in);
    \draw[ScriptureGold,line width=2pt] (0.32in,0.32in) rectangle (6.68in,9.68in);
    \draw[ChapterBlue,line width=0.4pt] (0.4in,0.4in) rectangle (6.6in,9.6in);
    % Corner ornament, bottom-left
    \foreach \dx/\dy/\r in {0/0/0.05, 0.14/0/0.035, 0/0.14/0.035, 0.24/0.08/0.025} {
      \fill[ScriptureGold] (0.32in+\dx in,0.32in+\dy in) circle (\r in);
    }
  \end{tikzpicture}%
}

% Sunburst emblem: "let there be light" (Genesis 1:3)
\newcommand{\sunburstemblem}{%
  \begin{tikzpicture}[scale=0.62]
    \draw[ScriptureGold,line width=0.4pt] (0,0) circle (1.15);
    \foreach \a in {0,15,...,345} {
      \draw[ScriptureGold,line width=0.6pt] (\a:0.55) -- (\a:1.0);
    }
    \fill[ChapterBlue] (0,0) circle (0.32);
    \node[font=\tiny\bfseries,color=CoverCream] at (0,0) {אוֹר};
  \end{tikzpicture}%
}

