\begin{minipage}{4.4in}
\centering
{\color{CoverGoldBright}\rule{4.4in}{0.6pt}}
\vspace{0.3cm}
\small\color{CoverCream}
{\greekfont Ἐν ἀρχῇ ἦν ὁ λόγος, καὶ ὁ λόγος ἦν πρὸς τὸν θεόν, καὶ θεὸς ἦν ὁ λόγος.}\\[0.35em]
\itshape
「太初有道，道與神同在，道就是神。」\\[0.2em]
{\baskervillefont\footnotesize\color{CoverCream} In the beginning was the Word, and the Word was with God,\\
and the Word was God. \textemdash\ John 1:1}
\vspace{0.3cm}
{\color{CoverGoldBright}\rule{4.4in}{0.6pt}}
