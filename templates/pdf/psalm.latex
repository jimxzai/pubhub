\usepackage{xcolor}

% Primary colors - warm psalter theme
\definecolor{ChapterBrown}{RGB}{92,58,30}        % Deep warm brown for chapters
\definecolor{ScriptureGold}{RGB}{170,132,56}     % Antique gold for scripture refs
