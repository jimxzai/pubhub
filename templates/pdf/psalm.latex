% Box colors
\definecolor{ScriptureBg}{RGB}{250,246,236}      % Parchment cream for scripture boxes
\definecolor{PraiseBg}{RGB}{246,242,230}         % Warm cream

% Text colors
\definecolor{TextGray}{RGB}{50,50,50}
\definecolor{LightGray}{RGB}{120,120,120}

% Diagram colors — five books of the Psalter
\definecolor{BookOneOlive}{RGB}{130,130,90}      % Book I  — wisdom olive
\definecolor{BookTwoGold}{RGB}{176,138,58}       % Book II — royal gold
\definecolor{BookThreeRust}{RGB}{158,84,66}      % Book III — sanctuary rust
\definecolor{BookFourSage}{RGB}{110,140,120}     % Book IV — wilderness sage
\definecolor{BookFiveAmber}{RGB}{196,120,70}     % Book V  — praise amber

