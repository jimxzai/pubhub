% Lyre (harp) decoration — the psalter's instrument
\newcommand{\lyresymbol}{%
\begin{tikzpicture}[scale=0.18]
  \draw[color=ScriptureGold,line width=1.2pt] (-0.8,0) .. controls (-1.1,1.2) .. (-0.5,1.8);
  \draw[color=ScriptureGold,line width=1.2pt] (0.8,0) .. controls (1.1,1.2) .. (0.5,1.8);
  \draw[color=ScriptureGold,line width=1.2pt] (-0.8,0) .. controls (0,-0.5) .. (0.8,0);
  \draw[color=ScriptureGold,line width=0.6pt] (-0.35,0.05) -- (-0.35,1.45);
  \draw[color=ScriptureGold,line width=0.6pt] (0,0.0) -- (0,1.5);
  \draw[color=ScriptureGold,line width=0.6pt] (0.35,0.05) -- (0.35,1.45);
  \draw[color=ScriptureGold,line width=1pt] (-0.6,1.5) -- (0.6,1.5);
\end{tikzpicture}%
}

