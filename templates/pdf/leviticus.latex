% ===== THREE CONCENTRIC ZONES: THE CAMP / THE HOLY PLACE / THE MOST HOLY PLACE =====
% Spatial, not narrative: the tabernacle's own graduated zones of access
% (10:10's "distinction between the holy and the common, the unclean and
% the clean"), from the widest and most accessible (the camp) to the
% narrowest and most restricted (the Most Holy Place, entered once a year
% by one man alone, 16章).
\begin{tikzpicture}[scale=0.85, transform shape]
  % Outer zone — the camp, common life needing the blood applied to it
  \fill[ChapterAsh, opacity=0.16] (0,0.1) circle (1.65);
  \draw[ChapterAsh, line width=0.9pt, opacity=0.75] (0,0.1) circle (1.65);
  % Middle zone — the Holy Place, the priests' daily service
  \fill[StormTeal, opacity=0.14] (0,0.1) circle (1.15);
  \draw[StormTeal, line width=1.0pt, opacity=0.85] (0,0.1) circle (1.15);
  % Inner zone — the Most Holy Place, the mercy seat (16章)
  \fill[DawnGold, opacity=0.22] (0,0.1) circle (0.55);
  \draw[DawnGold, line width=1.0pt, opacity=0.9] (0,0.1) circle (0.55);
  % Each label sits just below the ring it names: innermost circle = the Most
  % Holy Place (gold), middle = the Holy Place (blue), outer = the camp (scarlet).
  \node[font=\tiny,color=DawnGold!70!black] at (0,-0.65) {至聖所中};
  \node[font=\tiny,color=StormTeal]         at (0,-1.28) {聖所中};
  \node[font=\tiny,color=ChapterAsh]        at (0,-1.9)  {營中};
\end{tikzpicture}

\vspace{0.10cm}
\textcolor{ScriptureGold}{\rule{2.8in}{0.8pt}}
