% Six-volume structure diagram (TikZ drawn) — the book's own progression
% from the laws of offering, through the priesthood and purity laws, to the
% Day of Atonement at the center, out into the Holiness Code and its closing
% appendix on vows.
% No picture-level `scale`: node sizes (minimum width/height) are NOT affected
% by TikZ's `scale` key unless `transform shape` is also given, while node
% POSITIONS always are — mixing the two without `transform shape` silently
% compresses the coordinate grid while the box borders stay full size, so
% boxes spaced correctly on paper collide and clip their own text with zero
% warning. Coordinates below are plain centimetres instead, sized directly.
\begin{tikzpicture}[every node/.style={align=center}]
  \node[font=\footnotesize\bfseries,color=ChapterAsh] at (0,2.9) {全書六卷 Six Volumes, 27 Chapters};

  \node[draw=ChapterAsh,fill=ScriptureBg,rounded corners,minimum width=2.3cm,minimum height=0.7cm,font=\tiny] (v1) at (-3.825,2.2) {卷一 \textperiodcentered\ 獻祭條例};
  \node[font=\tiny,color=LightGray] at (-3.825,1.55) {1-7};

  \node[draw=ChapterAsh,fill=ScriptureBg,rounded corners,minimum width=2.3cm,minimum height=0.7cm,font=\tiny] (v2) at (-1.275,2.2) {卷二 \textperiodcentered\ 祭司設立};
  \node[font=\tiny,color=LightGray] at (-1.275,1.55) {8-10};

  \node[draw=ChapterAsh,fill=ScriptureBg,rounded corners,minimum width=2.3cm,minimum height=0.7cm,font=\tiny] (v3) at (1.275,2.2) {卷三 \textperiodcentered\ 潔淨條例};
  \node[font=\tiny,color=LightGray] at (1.275,1.55) {11-15};

  \node[draw=DawnGold!70!black,fill=ScriptureBg,rounded corners,minimum width=2.3cm,minimum height=0.7cm,font=\tiny] (v4) at (3.825,2.2) {卷四 \textperiodcentered\ 贖罪日};
  % offset left of centre: the v4->v5 connector descends from (v4.south),
  % which would otherwise run straight through this label
  \node[font=\tiny,color=LightGray] at (3.30,1.55) {16};

  \node[draw=StormTeal,fill=ScriptureBg,rounded corners,minimum width=3.4cm,minimum height=0.7cm,font=\tiny] (v5) at (-1.1,0.5) {卷五 \textperiodcentered\ 聖潔典章};
  \node[font=\tiny,color=LightGray] at (-1.1,-0.15) {17-26};

  \node[draw=StormTeal,fill=ScriptureBg,rounded corners,minimum width=2.3cm,minimum height=0.7cm,font=\tiny] (v6) at (2.55,0.5) {卷六 \textperiodcentered\ 許願估值};
  \node[font=\tiny,color=LightGray] at (2.55,-0.15) {27};

