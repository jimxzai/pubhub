% Genealogy page (full page) — replaces the "Kingdom Map" page,
% since 1 Chronicles 1-9 is a genealogy, not a travel narrative
\thispagestyle{empty}
\begin{center}
\vspace*{0.3cm}
{\Large\bfseries\color{ChapterBlue} 從亞當到大衛}\\[0.1cm]
{\normalsize From Adam to David — the Line That Carries the Promise}

\vspace{0.5cm}

\begin{tikzpicture}[scale=0.9]
  \node[font=\footnotesize\bfseries,color=ChapterBlue] at (0,6.3) {家譜的骨幹 The Genealogical Spine (代上1-3章)};

  \foreach \i/\name/\y in {
    0/{亞當 Adam}/5.6,
    1/{挪亞 Noah}/4.9,
    2/{亞伯拉罕 Abraham}/4.2,
    3/{以撒 Isaac}/3.5,
    4/{雅各／以色列 Jacob}/2.8,
    5/{猶大 Judah}/2.1,
    6/{耶西 Jesse}/1.4,
    7/{大衛 David}/0.7
  }{
    \node[draw=ChapterBlue,fill=ScriptureBg,rounded corners,minimum width=4.4cm,minimum height=0.55cm,font=\small] at (0,\y) {\name};
  }
