{border:2px solid #a2a9b1}.mw-parser-output .pmbox .mbox-text{border:none;padding:0.25em 0.9em;width:100%}.mw-parser-output .pmbox .mbox-image{border:none;padding:2px 0 2px 0.9em;text-align:center}.mw-parser-output .pmbox .mbox-imageright{border:none;padding:2px 0.9em 2px 0;text-align:center}.mw-parser-output .pmbox .mbox-image img,.mw-parser-output .pmbox .mbox-imageright img{max-width:none}.mw-parser-output .pmbox .mbox-empty-cell{border:none;padding:0;width:1px}.mw-parser-output .pmbox .mbox-invalid-type{text-align:center}@media(min-width:720px){.mw-parser-output .pmbox{margin:4px 10%}.mw-parser-output .pmbox.mbox-small{clear:right;float:right;margin:4px 0 4px 1em;width:238px}}</style><table class=\"plainlinks metadata pmbox pmbox-notice\" role=\"presentation\"><tbody><tr><td class=\"mbox-image\"><div class=\"mbox-image-div\"><span typeof=\"mw:File\"><a href=\"/wiki/File:Classical_music_icon.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/7/7a/Classical_music_icon.svg/40px-Classical_music_icon.svg.png?utm_source=en.wikisource.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"45\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/7/7a/Classical_music_icon.svg/120px-Classical_music_icon.svg.png?utm_source=en.wikisource.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"512\" data-file-height=\"571\" /></a></span></div></td><td class=\"mbox-text\"><div class=\"mbox-text-span\"><b>A musical score should appear at this position in the text.</b><br /><small>See <a href=\"/wiki/Help:Sheet_music\" title=\"Help:Sheet music\">Help:Sheet music</a> for formatting instructions</small></div></td></tr></tbody></table>&#160;\n</td></tr></tbody></table>\n<div class=\"poem\">\n<style data-mw-deduplicate=\"TemplateStyles:r15431465\">.mw-parser-output .wst-block-center{display:block;margin:0 auto;padding:0;position:rela